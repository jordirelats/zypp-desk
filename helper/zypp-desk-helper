#!/usr/bin/python3 -I
# SPDX-License-Identifier: GPL-3.0-or-later
"""zypp-desk-helper: the only part of Zypp Desk that runs as root (through pkexec).

Usage:
    zypp-desk-helper [--lang LANG] zypper ARGS...
    zypp-desk-helper [--lang LANG] rpm-import KEYFILE FINGERPRINT
    zypp-desk-helper history
    zypp-desk-helper [--lang LANG] key-remove FINGERPRINT
    zypp-desk-helper [--lang LANG] snapper-list | snapper-status PRE POST | snapper-undo PRE POST | snapper-rollback
    zypp-desk-helper zypp-conf KEY=VALUE... | zypp-conf --reset
    zypp-desk-helper download-ahead on|off

It runs zypper with a fixed list of subcommands, and only with global options from a short
list: nothing that points zypper at another root, configuration or cache directory. The polkit
action (data/*.policy) names this file, so pkexec asks for the administrator password before
it runs. Keep it small and easy to review.
"""

import os
import re
import stat
import subprocess
import sys
import tempfile

ZYPPER = "/usr/bin/zypper"
# The window compares this with its own version and asks to reinstall the helper when they differ.
VERSION = "0.5.6"
RPM = "/usr/bin/rpm"
HISTORY = "/var/log/zypp/history"

ALLOWED_SUBCOMMANDS = {
    "refresh", "ref", "dist-upgrade", "dup", "update", "up", "patch", "list-patches", "lp",
    "list-updates", "lu", "patch-check", "pchk", "install", "in", "remove", "rm", "verify", "ve",
    "install-new-recommends", "inr", "source-install", "si", "removeptf", "rmptf",
    "addrepo", "ar", "removerepo", "rr", "renamerepo", "nr", "modifyrepo", "mr", "clean", "cc",
    "addservice", "as", "modifyservice", "ms", "removeservice", "rs", "refresh-services", "refs",
    "addlock", "al", "removelock", "rl", "cleanlocks", "cl", "addlocale", "aloc", "removelocale", "rloc",
    "purge-kernels", "ps", "needs-rebooting", "download", "source-download", "licenses",
}
# Global options (before the subcommand) that are allowed. Values follow the ones in WITH_VALUE.
# Only what Zypp Desk uses: no extra repositories (-p, --plus-repo, --plus-content), no automatic trust of
# keys (--gpg-auto-import-keys) and no other release version (--releasever).
GLOBAL_FLAGS = {
    "-v", "--verbose", "-q", "--quiet", "-n", "--non-interactive", "-x", "--xmlout", "-t", "--terse",
    "-A", "--no-abbrev", "--color", "--no-color", "--no-refresh", "-i", "--ignore-unknown", "--no-cd",
    "--no-remote", "--non-interactive-include-reboot-patches",
}
GLOBAL_WITH_VALUE = {"--userdata"}
SHORT_COMBINABLE = set("vqnxtAi")
# Never accepted anywhere on the command line.
FORBIDDEN = {
    "-R", "--root", "--installroot", "-c", "--config", "-D", "--reposd-dir", "--servicesd-dir",
    "-C", "--cache-dir", "--raw-cache-dir", "--solv-cache-dir", "--pkg-cache-dir",
    "--disable-system-resolvables", "--plus-repo", "--plus-content", "--gpg-auto-import-keys", "--releasever",
}
SNAPPER = "/usr/bin/snapper"
RPMKEYS = "/usr/bin/rpmkeys"
SHIPPED_KEYS = "/usr/lib/rpm/gnupg/keys"  # the keys openSUSE ships (openSUSE-build-key): never deleted from here
ZYPP_DROPIN = "/etc/zypp/zypp.conf.d/50-zypp-desk.conf"
AHEAD_FLAG = "/etc/zypp-desk/download-ahead"  # read by zypp-desk-refresh (the timer): also download the updates
NUM_RE = re.compile(r"[1-9][0-9]{0,6}")
KERNEL_CHOICES = {"latest,running", "latest,latest-1,running", "latest,latest-1,latest-2,running",
                  "oldest,latest,running"}
BOOL = {"true", "false"}
ASCII_NUM = re.compile(r"[0-9]{1,10}")  # str.isdigit() would also take digits of other scripts
# The only zypp.conf settings Zypp Desk may write, and the values each one accepts.
ZYPP_CONF = {
    "solver.onlyRequires": lambda v: v in BOOL,
    "solver.dupAllowVendorChange": lambda v: v in BOOL,
    "solver.cleandepsOnRemove": lambda v: v in BOOL,
    "multiversion.kernels": lambda v: v in KERNEL_CHOICES,
    "download.max_concurrent_connections": lambda v: bool(ASCII_NUM.fullmatch(v)) and 1 <= int(v) <= 10,
    "download.max_download_speed": lambda v: bool(ASCII_NUM.fullmatch(v)) and int(v) <= 1_000_000_000,
}
LANG_RE = re.compile(r"(C|POSIX|[A-Za-z]{2,3}(_[A-Za-z]{2})?)(\.[A-Za-z0-9-]+)?(@[A-Za-z]+)?")
FPR_RE = re.compile(r"[0-9A-F]{40}|[0-9A-F]{64}")
GPG = "/usr/bin/gpg"
GPGCONF = "/usr/bin/gpgconf"


def die(msg, code=2):
    print(f"zypp-desk-helper: {msg}", file=sys.stderr)
    sys.exit(code)


def clean_env(lang):
    return {
        "PATH": "/usr/sbin:/usr/bin:/sbin:/bin",
        "HOME": "/root",
        "TERM": "dumb",
        "COLUMNS": "120",
        "LANG": lang,
        "LC_ALL": lang,
        "LANGUAGE": lang.split(".")[0] if lang not in ("C", "POSIX") else lang,
    }


def check_zypper_args(args):
    if not args:
        die("no zypper arguments")
    for a in args:
        if "\0" in a or "\n" in a:
            die("invalid character in arguments")
        # Long forbidden options are refused anywhere. Short ones (-R, -c, -D, -C) only matter
        # before the subcommand, where the whitelist below already refuses them; after it they
        # mean other things (for example 'dup -D' is --dry-run).
        name = a.split("=", 1)[0]
        if name.startswith("--") and name in FORBIDDEN:
            die(f"option not allowed: {name}")
    i = 0
    while i < len(args):
        a = args[i]
        if not a.startswith("-"):
            break
        name = a.split("=", 1)[0]
        if name in GLOBAL_WITH_VALUE:
            i += 1 if "=" in a else 2
            continue
        if name in GLOBAL_FLAGS or (a.startswith("-") and not a.startswith("--") and len(a) > 1
                                    and set(a[1:]) <= SHORT_COMBINABLE):
            i += 1
            continue
        die(f"global option not allowed: {a}")
    if i >= len(args):
        die("no zypper subcommand")
    if args[i] not in ALLOWED_SUBCOMMANDS:
        die(f"zypper subcommand not allowed: {args[i]}")


def run_zypper(args, lang):
    check_zypper_args(args)
    os.execve(ZYPPER, ["zypper", *args], clean_env(lang))


def key_fingerprints(path):
    """Fingerprints of the primary keys in a key file, read by gpg as root in an empty keyring."""
    with tempfile.TemporaryDirectory(prefix="zypp-desk-gpg-", dir="/run") as home:
        p = subprocess.run([GPG, "--batch", "--no-autostart", "--homedir", home, "--with-colons", "--show-keys",
                            path], capture_output=True, text=True, env=clean_env("C"))
        subprocess.run([GPGCONF, "--homedir", home, "--remove-socketdir"], capture_output=True, env=clean_env("C"))
    if p.returncode != 0:
        return []  # gpg could not read it: no fingerprint, so the import is refused
    fprs, want = [], False
    for line in p.stdout.splitlines():
        f = line.split(":")
        if f[0] == "pub":
            want = True
        elif f[0] == "sub":
            want = False
        elif f[0] == "fpr" and want and len(f) > 9:
            fprs.append(f[9].upper())
            want = False
    return fprs


def _gpg(home, *args, data=None):
    return subprocess.run([GPG, "--batch", "--no-autostart", "--homedir", home, *args], input=data,
                          capture_output=True, env=clean_env("C"))


def rpm_import(path, expected, lang):
    if not os.path.isabs(path):
        die("the key file must be an absolute path")
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    except OSError as e:
        die(f"cannot open the key file: {e.strerror}")
    with os.fdopen(fd, "rb") as f:
        if not stat.S_ISREG(os.fstat(f.fileno()).st_mode):
            die("the key file is not a regular file")
        data = f.read(1024 * 1024 + 1)
    if len(data) > 1024 * 1024:
        die("the key file is too big")
    # rpm imports every "-----BEGIN PGP" block it finds anywhere in a file, gpg only those at the start of a line:
    # a second block hidden in the middle of a line would be imported without being shown. Exactly one block.
    if data.count(b"-----BEGIN PGP") != 1 or b"-----BEGIN PGP PUBLIC KEY BLOCK-----" not in data:
        die("the file must contain exactly one PGP public key block")
    expected = expected.upper().replace(" ", "")
    if not FPR_RE.fullmatch(expected):
        die("invalid fingerprint")
    with tempfile.TemporaryDirectory(prefix="zypp-desk-gpg-", dir="/run") as home:
        try:
            src = os.path.join(home, "in.asc")
            with open(src, "wb") as f:
                f.write(data)
            # The user saw this fingerprint before saying yes; these bytes must hold that key, and only it.
            if key_fingerprints(src) != [expected]:
                die("the key file does not contain exactly the key that was shown (fingerprint mismatch)")
            # rpm never gets the bytes from the user: gpg reads them into an empty keyring and writes that one key out
            # again, minimal and armored, and that is what rpm imports.
            keyring = os.path.join(home, "ring")
            os.mkdir(keyring, 0o700)
            if _gpg(keyring, "--import", src).returncode != 0:
                die("gpg could not read the key")
            out = _gpg(keyring, "--armor", "--export-options", "export-minimal", "--export", expected)
            if out.returncode != 0 or out.stdout.count(b"-----BEGIN PGP") != 1:
                die("gpg could not export the key")
            clean = os.path.join(home, "key.asc")
            with open(clean, "wb") as f:
                f.write(out.stdout)
            if key_fingerprints(clean) != [expected]:
                die("the exported key is not the key that was shown")
            p = subprocess.run([RPM, "--import", clean], env=clean_env(lang))
        finally:
            for h in (home, os.path.join(home, "ring")):
                subprocess.run([GPGCONF, "--homedir", h, "--remove-socketdir"], capture_output=True, env=clean_env("C"))
    sys.exit(p.returncode)


def armored_keys():
    """(name-version-release, armored text) of every key in the rpm keyring."""
    sep = "@@zypp-desk-key-end@@"
    p = subprocess.run([RPM, "-qa", "gpg-pubkey", "--qf", "%{NAME}-%{VERSION}-%{RELEASE}\\n%{DESCRIPTION}\\n" + sep + "\\n"],
                       capture_output=True, text=True, env=clean_env("C"))
    for chunk in p.stdout.split(sep):
        nvr, _sep, text = chunk.strip("\n").partition("\n")
        if nvr.startswith("gpg-pubkey-") and "BEGIN PGP PUBLIC KEY BLOCK" in text:
            yield nvr, text


def fingerprints_of_text(text):
    with tempfile.NamedTemporaryFile("w", prefix="zypp-desk-key-", suffix=".asc", dir="/run") as tmp:
        tmp.write(text)
        tmp.flush()
        return key_fingerprints(tmp.name)


def key_remove(fpr, lang):
    fpr = fpr.upper()
    if not FPR_RE.fullmatch(fpr):
        die("invalid fingerprint")
    try:
        shipped = [os.path.join(SHIPPED_KEYS, f) for f in os.listdir(SHIPPED_KEYS)]
    except OSError:
        shipped = []
    for f in shipped:
        if fpr in key_fingerprints(f):
            die("this key is shipped by openSUSE and is not deleted from here")
    ver = subprocess.run([RPM, "--version"], capture_output=True, text=True, env=clean_env("C")).stdout
    m = re.search(r"(\d+)\.", ver)
    if m and int(m.group(1)) >= 6:
        cmd = [RPMKEYS, "--delete", fpr]  # rpm 6 names keys by fingerprint (and may keep them outside the database)
    else:
        found = [nvr for nvr, text in armored_keys() if fingerprints_of_text(text) == [fpr]]
        if len(found) != 1:
            die("no key with this fingerprint in the rpm keyring" if not found else "more than one key matches", 1)
        cmd = [RPMKEYS, "--delete", found[0][len("gpg-pubkey-"):]]  # rpm 4: version-release of the gpg-pubkey package
    print("# " + " ".join(cmd), flush=True)
    os.execve(cmd[0], cmd, clean_env(lang))


def snapper(verb, args, lang):
    if not os.path.exists(SNAPPER):
        die("snapper is not installed", 1)
    if verb == "snapper-list" and not args:
        cmd = ["--jsonout", "-c", "root", "list", "--disable-used-space"]
    elif verb in ("snapper-status", "snapper-undo") and len(args) == 2:
        pre, post = args
        if not (NUM_RE.fullmatch(pre) and NUM_RE.fullmatch(post) and int(pre) < int(post)):
            die("invalid snapshot numbers")
        cmd = ["-c", "root", "status" if verb == "snapper-status" else "undochange", f"{pre}..{post}"]
    elif verb == "snapper-rollback" and not args:
        cmd = ["-c", "root", "rollback"]
    else:
        die(f"invalid arguments for {verb}")
    os.execve(SNAPPER, ["snapper", *cmd], clean_env(lang))


def write_root_file(path, data):
    """Write a small file owned by root, mode 0644, atomically, never through a symbolic link."""
    folder = os.path.dirname(path)
    os.makedirs(folder, mode=0o755, exist_ok=True)
    st = os.lstat(folder)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != 0:
        die(f"{folder} is not a folder owned by root")
    fd, tmp = tempfile.mkstemp(prefix=".zypp-desk-", dir=folder)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(data)
            f.flush()
            os.fchmod(f.fileno(), 0o644)
            os.fsync(f.fileno())
        os.replace(tmp, path)  # replaces a symbolic link itself, never its target
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def remove_root_file(path):
    try:
        os.unlink(path)  # a symbolic link is removed itself, its target is not touched
    except FileNotFoundError:
        pass


def zypp_conf(args):
    if args == ["--reset"]:
        remove_root_file(ZYPP_DROPIN)
        print(f"# rm {ZYPP_DROPIN}")
        return
    if not args:
        die("nothing to write")
    values = {}
    for a in args:
        key, sep, value = a.partition("=")
        if not sep or key not in ZYPP_CONF or key in values or not ZYPP_CONF[key](value):
            die(f"setting not allowed: {a}")
        values[key] = value
    text = ("# Written by Zypp Desk. Delete this file to go back to openSUSE's settings.\n[main]\n"
            + "".join(f"{k} = {v}\n" for k, v in values.items()))
    write_root_file(ZYPP_DROPIN, text)
    print(f"# {ZYPP_DROPIN}:\n{text}", end="")


def download_ahead(state):
    if state == "on":
        write_root_file(AHEAD_FLAG, "Zypp Desk: zypp-desk-refresh also downloads the updates (never installs them).\n")
    elif state == "off":
        remove_root_file(AHEAD_FLAG)
    else:
        die("download-ahead takes on or off")
    print(f"# download-ahead {state}")


def history():
    try:
        with open(HISTORY, "rb") as f:
            sys.stdout.buffer.write(f.read())
    except OSError as e:
        die(f"cannot read {HISTORY}: {e.strerror}", 1)


def main(argv):
    lang = "C"
    if len(argv) >= 2 and argv[0] == "--lang":
        lang = argv[1]
        argv = argv[2:]
        if not LANG_RE.fullmatch(lang):
            die("invalid language")
    if not argv:
        die("missing command")
    if os.geteuid() != 0:
        die("must run as root (through pkexec)")
    verb, rest = argv[0], argv[1:]
    if verb == "zypper":
        run_zypper(rest, lang)
    elif verb == "rpm-import" and len(rest) == 2:
        rpm_import(rest[0], rest[1], lang)
    elif verb == "history" and not rest:
        history()
    elif verb == "key-remove" and len(rest) == 1:
        key_remove(rest[0], lang)
    elif verb in ("snapper-list", "snapper-status", "snapper-undo", "snapper-rollback"):
        snapper(verb, rest, lang)
    elif verb == "zypp-conf":
        zypp_conf(rest)
    elif verb == "download-ahead" and len(rest) == 1:
        download_ahead(rest[0])
    else:
        die(f"unknown command: {verb}")


if __name__ == "__main__":
    main(sys.argv[1:])
