<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- SPDX-License-Identifier: GPL-3.0-or-later
     Zypp Desk: lets an administrator run zypp-desk-helper (zypper with a checked list of commands).
     auth_admin_keep: the password is asked once and remembered for a few minutes. -->
<policyconfig>
  <vendor>Zypp Desk</vendor>
  <action id="io.github.jordirelats.ZyppDesk.run">
    <description>Manage software with zypper</description>
    <description xml:lang="ca">Gestionar el programari amb zypper</description>
    <description xml:lang="de">Software mit zypper verwalten</description>
    <description xml:lang="fr">Gérer les logiciels avec zypper</description>
    <!-- one action for every verb of the helper: software, repositories, keys, zypp.conf, the history, snapshots -->
    <message>Zypp Desk needs the administrator password to change the system or to read its logs</message>
    <message xml:lang="ca">Zypp Desk necessita la contrasenya d'administrador per canviar el sistema o per llegir-ne els registres</message>
    <message xml:lang="de">Zypp Desk benötigt das Administratorpasswort, um das System zu ändern oder seine Protokolle zu lesen</message>
    <message xml:lang="fr">Zypp Desk a besoin du mot de passe administrateur pour modifier le système ou pour lire ses journaux</message>
    <icon_name>io.github.jordirelats.ZyppDesk</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@HELPER@</annotate>
  </action>
</policyconfig>
