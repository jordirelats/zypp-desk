# Zypp Desk: refresh the repositories (and the firmware list) as root, so that Zypp Desk and its tray icon know
# what is new. It never installs anything. Started by zypp-desk-refresh.timer.
# @REFRESH@ is replaced when installing (install.sh, the RPM spec).
[Unit]
Description=Refresh the zypper repositories for Zypp Desk (never installs anything)
Documentation=https://github.com/jordirelats/zypp-desk
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=@REFRESH@
Nice=10
IOSchedulingClass=idle
# a slow download ahead must not run for ever; the next run goes on where it stopped
TimeoutStartSec=2h
# fwupdmgr keeps what it downloads here ($CACHE_DIRECTORY)
CacheDirectory=zypp-desk-refresh

# Hardening: the whole system is read-only except what zypper and rpm write when refreshing and downloading.
ProtectSystem=strict
ReadWritePaths=/var/cache/zypp /var/lib/zypp /var/log/zypp /run /etc/zypp
ReadWritePaths=-/var/log/zypper.log -/usr/lib/sysimage/rpm -/var/lib/rpm
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
