#: zypp_desk/backend.py:32 zypp_desk/backend.py:55
#, python-brace-format
msgid "zypper exited with code {code}."
msgstr "zypper ha acabat amb el codi {code}."

#: zypp_desk/backend.py:44 zypp_desk/simulation.py:562
msgid "zypper returned no output."
msgstr "zypper no ha tornat cap sortida."

#: zypp_desk/backend.py:343
msgid "PackageKit (Discover)"
msgstr "PackageKit (Discover)"

#: zypp_desk/backend.py:343
msgid "zypper in a terminal"
msgstr "zypper en un terminal"

#: zypp_desk/backend.py:384
msgid "Zypp Desk itself"
msgstr "Zypp Desk mateix"

#: zypp_desk/explain.py:19
msgid "No importance"
msgstr "Sense importància"

#: zypp_desk/explain.py:20
msgid "Just so you know"
msgstr "Perquè ho sàpigues"

#: zypp_desk/explain.py:21
msgid "Pay attention"
msgstr "Compte"

#: zypp_desk/explain.py:22
msgid "Serious"
msgstr "Greu"

#: zypp_desk/explain.py:23
msgid "Unknown message"
msgstr "Missatge desconegut"

#: zypp_desk/explain.py:34
msgid "An install script uses an old command"
msgstr "Un script d'instal·lació fa servir una ordre antiga"

#: zypp_desk/explain.py:35
msgid "The small program that runs while a package installs uses 'egrep', an old name for a tool. It still works; the message only says that the name will disappear some day."
msgstr "El petit programa que s'executa mentre s'instal·la un paquet fa servir «egrep», un nom antic d'una eina. Encara funciona; el missatge només avisa que algun dia aquest nom desapareixerà."

#: zypp_desk/explain.py:37
msgid "Nothing. It is the package maker's business."
msgstr "Res. És cosa de qui fa el paquet."

#: zypp_desk/explain.py:39
msgid "An install script tried to delete a folder that was not there"
msgstr "Un script d'instal·lació ha intentat esborrar una carpeta que no hi era"

#: zypp_desk/explain.py:40
msgid "While updating, the package tried to tidy up a folder that did not exist. Nothing went wrong."
msgstr "En actualitzar-se, el paquet ha intentat endreçar una carpeta que no existia. No ha anat res malament."

#: zypp_desk/explain.py:41 zypp_desk/explain.py:82 zypp_desk/explain.py:119
msgid "Nothing."
msgstr "Res."

#: zypp_desk/explain.py:43
msgid "The package is not signed"
msgstr "El paquet no està signat"

#: zypp_desk/explain.py:44
msgid "A signature proves who made a package and that nobody changed it. This one has none, so the system cannot check where it comes from. If you downloaded it from the official web site and the checksum matched, it is usually fine."
msgstr "Una signatura demostra qui ha fet un paquet i que ningú no l'ha canviat. Aquest no en té, i el sistema no pot comprovar d'on ve. Si l'has baixat de la web oficial i la suma de comprovació coincideix, normalment no hi ha problema."

#: zypp_desk/explain.py:47
msgid "Install only packages from places you trust."
msgstr "Instal·la només paquets de llocs de confiança."

#: zypp_desk/explain.py:50
msgid "A signature could not be verified"
msgstr "No s'ha pogut verificar una signatura"

#: zypp_desk/explain.py:51
msgid "The package or the repository is signed with a key your system does not trust, or the signature does not match. It can be a key that has not been imported yet, but it can also mean the file was changed."
msgstr "El paquet o el repositori està signat amb una clau de la qual el sistema no es fia, o la signatura no coincideix. Pot ser una clau que encara no s'ha importat, però també pot voler dir que algú ha canviat el fitxer."

#: zypp_desk/explain.py:54
msgid "Do not go on until you know why. Import the vendor's key only after checking its fingerprint on the official web site."
msgstr "No continuïs fins que no sàpigues per què. Importa la clau del proveïdor només després de comprovar-ne l'empremta a la web oficial."

#: zypp_desk/explain.py:57
msgid "A signing key has expired"
msgstr "Ha caducat una clau de signatura"

#: zypp_desk/explain.py:58
msgid "The key that guarantees a repository is out of date, so nothing from that repository can be installed or updated until the key is renewed."
msgstr "La clau que garanteix un repositori ha caducat, i fins que no es renovi no es pot instal·lar ni actualitzar res d'aquell repositori."

#: zypp_desk/explain.py:60
msgid "Usually the vendor publishes a renewed key: import it (Repositories → Import a signing key)."
msgstr "Normalment el proveïdor en publica una de renovada: importa-la (Repositoris → Importa una clau de signatura)."

#: zypp_desk/explain.py:62
msgid "Some open programs still use the old version"
msgstr "Alguns programes oberts encara fan servir la versió vella"

#: zypp_desk/explain.py:63
msgid "Programs that were open during the update keep using the old files until they are closed. Nothing is broken."
msgstr "Els programes que estaven oberts durant l'actualització continuen fent servir els fitxers vells fins que es tanquen. No s'ha espatllat res."

#: zypp_desk/explain.py:65
msgid "Close and reopen them when it suits you. Restart the computer only if Zypp Desk says so."
msgstr "Tanca'ls i torna'ls a obrir quan et vagi bé. Reinicia l'ordinador només si Zypp Desk t'ho diu."

#: zypp_desk/explain.py:68
msgid "zypper asked a question that nobody could answer"
msgstr "zypper ha fet una pregunta que ningú no podia respondre"

#: zypp_desk/explain.py:69
msgid "zypper stopped to ask (for example “Continue?”), but it was not running in a terminal, so it could not read an answer and gave up. Nothing was changed by that command."
msgstr "zypper s'ha aturat a preguntar (per exemple «Continuo?»), però no s'executava en un terminal, de manera que no ha pogut llegir cap resposta i ho ha deixat córrer. Aquesta ordre no ha canviat res."

#: zypp_desk/explain.py:71
msgid "Run it again: Zypp Desk now adds -n so that zypper takes its default answers."
msgstr "Torna-la a executar: ara Zypp Desk hi afegeix -n perquè zypper triï les respostes per defecte."

#: zypp_desk/explain.py:74
msgid "Reminder before a distribution upgrade"
msgstr "Recordatori abans d'actualitzar la distribució"

#: zypp_desk/explain.py:75
msgid "zypper always says this before 'dup': it will use every enabled repository, so they should all be meant for your version of the system."
msgstr "zypper ho diu sempre abans d'un «dup»: farà servir tots els repositoris actius, i per això tots haurien de ser per a la teva versió del sistema."

#: zypp_desk/explain.py:77
msgid "Nothing, if your repositories are the usual ones."
msgstr "Res, si els teus repositoris són els de sempre."

#: zypp_desk/explain.py:79
msgid "Some packages were not checked for file conflicts"
msgstr "No s'ha comprovat si alguns paquets tenen fitxers en conflicte"

#: zypp_desk/explain.py:80
msgid "In a simulation the packages are not downloaded, so zypper cannot look inside them. The real installation does check them."
msgstr "En una simulació no es baixen els paquets, i zypper no hi pot mirar a dins. La instal·lació de debò sí que ho comprova."

#: zypp_desk/explain.py:84
msgid "Another program is using the package manager"
msgstr "Un altre programa fa servir el gestor de paquets"

#: zypp_desk/explain.py:85
msgid "Only one program can install software at a time. Often it is Discover or PackageKit checking for updates in the background."
msgstr "Només un programa alhora pot instal·lar programari. Sovint és Discover o PackageKit, que busquen actualitzacions en segon pla."

#: zypp_desk/explain.py:87
msgid "Wait a minute and try again, or close Discover."
msgstr "Espera un minut i torna-ho a provar, o tanca Discover."

#: zypp_desk/explain.py:91
msgid "A repository did not answer"
msgstr "Un repositori no ha respost"

#: zypp_desk/explain.py:92
msgid "The server of a repository did not respond, or there is no Internet connection. zypper uses what it already knew about that repository."
msgstr "El servidor d'un repositori no ha respost, o no hi ha connexió a Internet. zypper fa servir el que ja sabia d'aquell repositori."

#: zypp_desk/explain.py:94
msgid "Try again later. If it happens every time, that repository may no longer exist: disable it in Repositories."
msgstr "Torna-ho a provar més tard. Si passa cada vegada, potser aquell repositori ja no existeix: desactiva'l a Repositoris."

#: zypp_desk/explain.py:99
msgid "A dependency problem"
msgstr "Un problema de dependències"

#: zypp_desk/explain.py:100
msgid "What you asked for needs something that is missing, or clashes with something you have. zypper stops so it does not break anything."
msgstr "El que has demanat necessita alguna cosa que no hi és, o xoca amb alguna cosa que tens. zypper s'atura per no espatllar res."

#: zypp_desk/explain.py:102
msgid "Look at the simulation: change the queue (lock or remove the package that clashes) and simulate again."
msgstr "Mira la simulació: canvia la cua (bloqueja o treu el paquet que xoca) i torna a simular."

#: zypp_desk/explain.py:105
msgid "A package's install script failed"
msgstr "Ha fallat l'script d'instal·lació d'un paquet"

#: zypp_desk/explain.py:106
msgid "The package was installed, but the small program that sets it up afterwards reported an error. Sometimes it does not matter; sometimes something stays unconfigured."
msgstr "El paquet s'ha instal·lat, però el petit programa que el configura després ha donat un error. A vegades no importa; a vegades alguna cosa queda sense configurar."

#: zypp_desk/explain.py:108
msgid "If the program does not work well, reinstall that package."
msgstr "Si el programa no funciona bé, torna a instal·lar aquest paquet."

#: zypp_desk/explain.py:112
msgid "Restart the computer"
msgstr "Reinicia l'ordinador"

#: zypp_desk/explain.py:113
msgid "An update changed something basic (for example the kernel or the system libraries) that only takes effect after a restart."
msgstr "Una actualització ha canviat alguna cosa bàsica (per exemple el nucli o les biblioteques del sistema) que només fa efecte després de reiniciar."

#: zypp_desk/explain.py:115
msgid "Restart when it suits you."
msgstr "Reinicia quan et vagi bé."

#: zypp_desk/explain.py:117
msgid "Checked without administrator rights"
msgstr "Comprovat sense permisos d'administrador"

#: zypp_desk/explain.py:118
msgid "This check ran as your user, so it could only look at your own programs."
msgstr "Aquesta comprovació s'ha fet amb el teu usuari, i només ha pogut mirar els teus programes."

#: zypp_desk/explain.py:121
msgid "Something no longer gets updates"
msgstr "Hi ha una cosa que ja no rep actualitzacions"

#: zypp_desk/explain.py:122
msgid "A Flatpak runtime or app has reached its end of life: it will not get security fixes any more."
msgstr "Un entorn d'execució o una aplicació Flatpak ha arribat al final de la seva vida: ja no rebrà correccions de seguretat."

#: zypp_desk/explain.py:123
msgid "Update the app; if it keeps using it, look for a newer version or an alternative."
msgstr "Actualitza l'aplicació; si el continua fent servir, busca'n una versió més nova o una alternativa."

#: zypp_desk/explain.py:127
msgid "Two packages want the same file"
msgstr "Dos paquets volen el mateix fitxer"

#: zypp_desk/explain.py:128
msgid "Two packages contain a file with the same name. Installing both could overwrite one with the other."
msgstr "Dos paquets porten un fitxer amb el mateix nom. Si s'instal·len tots dos, l'un podria sobreescriure l'altre."

#: zypp_desk/explain.py:130
msgid "Usually one of them comes from an extra repository: choose one of the two."
msgstr "Normalment un dels dos ve d'un repositori addicional: tria'n un."

#: zypp_desk/explain.py:181
msgid "A message Zypp Desk does not know yet"
msgstr "Un missatge que Zypp Desk encara no coneix"

#: zypp_desk/explain.py:182
msgid "zypper (or a package) wrote this and Zypp Desk has no explanation for it. It is not necessarily bad: many messages are only informative."
msgstr "Això ho ha escrit zypper (o un paquet), i Zypp Desk no en té cap explicació. No vol dir que sigui dolent: molts missatges només informen."

#: zypp_desk/explain.py:184
msgid "If something does not work afterwards, search for the exact text on the Internet."
msgstr "Si després alguna cosa no funciona, busca el text exacte a Internet."

#: zypp_desk/keys.py:128 zypp_desk/keys.py:373 zypp_desk/pages/keys.py:802
msgid "The file is bigger than 1 MiB: it is not a signing key."
msgstr "El fitxer fa més d'1 MiB: no és una clau de signatura."

#: zypp_desk/keys.py:132
msgid "This is a secret key. Never share it: rpm only needs the public key."
msgstr "Això és una clau secreta. No la comparteixis mai: rpm només necessita la clau pública."

#: zypp_desk/keys.py:146
msgid "The key could not be read."
msgstr "No s'ha pogut llegir la clau."

#: zypp_desk/keys.py:332 zypp_desk/pages/keys.py:882
msgid "(no name in the key)"
msgstr "(la clau no porta cap nom)"

#: zypp_desk/keys.py:362
msgid "Only https addresses are allowed: over plain http anybody on the way could swap the key."
msgstr "Només es permeten adreces https: per http normal, qualsevol que estigui pel camí podria canviar la clau per una altra."

#: zypp_desk/keys.py:369 zypp_desk/localrpm.py:357
#, python-brace-format
msgid "The server answered with an error ({code})."
msgstr "El servidor ha respost amb un error ({code})."

#: zypp_desk/keys.py:371
#, python-brace-format
msgid "Could not download it: {reason}"
msgstr "No s'ha pogut baixar: {reason}"

#: zypp_desk/keys.py:381 zypp_desk/keys.py:460 zypp_desk/pages/keys.py:816
msgid "A fingerprint has 40 hexadecimal digits (0-9, A-F)."
msgstr "Una empremta té 40 xifres hexadecimals (0-9, A-F)."

#: zypp_desk/keys.py:386
msgid "keys.openpgp.org does not have a key with this fingerprint."
msgstr "keys.openpgp.org no té cap clau amb aquesta empremta."

#: zypp_desk/localrpm.py:32
msgid "The file is damaged, or it was changed after it was made: its checksums or its signature do not match. Do not install it; download it again from the official site."
msgstr "El fitxer està malmès, o algú l'ha canviat després de fer-lo: les sumes de verificació o la signatura no coincideixen. No l'instal·lis; torna'l a baixar del lloc oficial."

#: zypp_desk/localrpm.py:233
msgid "There is no such file."
msgstr "Aquest fitxer no existeix."

#: zypp_desk/localrpm.py:233
msgid "This is not a file."
msgstr "Això no és un fitxer."

#: zypp_desk/localrpm.py:241 zypp_desk/localrpm.py:256
#, python-brace-format
msgid "The file cannot be read: {error}"
msgstr "No es pot llegir el fitxer: {error}"

#: zypp_desk/localrpm.py:246
msgid "This is not an RPM package. Zypp Desk can only install .rpm files made for openSUSE (or for a compatible system)."
msgstr "Això no és un paquet RPM. Zypp Desk només pot instal·lar fitxers .rpm fets per a openSUSE (o per a un sistema compatible)."

#: zypp_desk/localrpm.py:261
msgid "rpm cannot read this file: it is damaged, or it is not a real RPM package."
msgstr "rpm no pot llegir aquest fitxer: està malmès, o no és un paquet RPM de debò."

#: zypp_desk/localrpm.py:303
msgid "The file changed while it was being read. Wait until the download finishes, then open it again."
msgstr "El fitxer ha canviat mentre es llegia. Espera que acabi la baixada i torna'l a obrir."

#: zypp_desk/localrpm.py:307
#, python-brace-format
msgid "This is a source package (.src.rpm): it holds the source code to build the program, not the program itself, so it cannot be installed. Look for the file whose name ends in {arch}.rpm or noarch.rpm."
msgstr "Això és un paquet de codi font (.src.rpm): conté el codi font per construir el programa, no el programa mateix, i per això no es pot instal·lar. Busca el fitxer que acaba en {arch}.rpm o noarch.rpm."

#: zypp_desk/localrpm.py:312
#, python-brace-format
msgid "This package is made for computers whose processor is {arch}. The processor of this computer is {machine}, so it would not work here. Look for the file whose name ends in {machine}.rpm or noarch.rpm."
msgstr "Aquest paquet està fet per a ordinadors amb processador {arch}. El processador d'aquest ordinador és {machine}, i aquí no funcionaria. Busca el fitxer que acaba en {machine}.rpm o noarch.rpm."

