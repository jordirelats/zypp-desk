msgstr "Codi de la llengua, per exemple ca o ca_ES:"

#: zypp_desk/pages/system.py:189
msgid "Check dependencies"
msgstr "Comprova les dependències"

#: zypp_desk/pages/system.py:190
msgid "Looks for installed packages whose dependencies are broken and proposes how to fix them."
msgstr "Busca paquets instal·lats amb dependències trencades i proposa com arreglar-les."

#: zypp_desk/pages/system.py:192
msgid "Install new recommended packages"
msgstr "Instal·la els recomanats nous"

#: zypp_desk/pages/system.py:193
msgid "Installs packages recommended by what you have, added since it was installed."
msgstr "Instal·la els paquets que recomanen els que tens i que s'hi han afegit des que els vas instal·lar."

#: zypp_desk/pages/system.py:196
msgid "Keeps the kernels set in zypp.conf (multiversion.kernels; on Tumbleweed /usr/etc/zypp/zypp.conf and /etc/zypp/zypp.conf.d) and removes the rest."
msgstr "Conserva els nuclis que indica zypp.conf (multiversion.kernels; a Tumbleweed, /usr/etc/zypp/zypp.conf i /etc/zypp/zypp.conf.d) i treu la resta."

#: zypp_desk/pages/system.py:200
msgid "Deletes downloaded packages and cached metadata. They are downloaded again when needed."
msgstr "Esborra els paquets baixats i les metadades desades. Es tornen a baixar quan calen."

#: zypp_desk/pages/system.py:203
msgid "Removes locks that no longer match any package."
msgstr "Treu els bloquejos que ja no corresponen a cap paquet."

#: zypp_desk/pages/system.py:204
msgid "Programs using deleted files"
msgstr "Programes que fan servir fitxers esborrats"

#: zypp_desk/pages/system.py:205
msgid "Programs that still use libraries replaced by an update and should be restarted."
msgstr "Programes que encara fan servir biblioteques substituïdes per una actualització i que caldria reiniciar."

#: zypp_desk/pages/system.py:206
msgid "Is a restart needed?"
msgstr "Cal reiniciar?"

#: zypp_desk/pages/system.py:207
msgid "Asks zypper whether an update requires restarting the computer."
msgstr "Pregunta a zypper si alguna actualització demana reiniciar l'ordinador."

#: zypp_desk/pages/system.py:208
msgid "Licenses report"
msgstr "Informe de llicències"

#: zypp_desk/pages/system.py:209
msgid "Lists the licenses of the installed packages."
msgstr "Llista les llicències dels paquets instal·lats."

#: zypp_desk/pages/system.py:232
msgid "Run"
msgstr "Executa"

#: zypp_desk/pages/system.py:246
msgid "Run it for real? Use Simulate first to see what it would do."
msgstr "Vols executar-ho de debò? Primer fes servir «Simula» per veure què faria."

#: zypp_desk/pages/system.py:261
msgid "When applying the queue"
msgstr "En aplicar la cua"

#: zypp_desk/pages/system.py:262
msgid "Do not install recommended packages (--no-recommends)"
msgstr "No instal·lis els paquets recomanats (--no-recommends)"

#: zypp_desk/pages/system.py:264
msgid "Accept licenses without asking (--auto-agree-with-licenses)"
msgstr "Accepta les llicències sense preguntar (--auto-agree-with-licenses)"

#: zypp_desk/pages/system.py:268
msgid "Changes are applied without questions (-n), after you have seen the simulation. If a license must be accepted and this option is off, zypper stops and nothing is installed."
msgstr "Els canvis s'apliquen sense preguntes (-n), després que hagis vist la simulació. Si cal acceptar una llicència i aquesta opció està desactivada, zypper s'atura i no s'instal·la res."

#: zypp_desk/pages/system.py:272 zypp_desk/terminal.py:293
msgid "Terminal"
msgstr "Terminal"

#: zypp_desk/pages/system.py:273
msgid "Fold a line repeated many times in a row into one"
msgstr "Plega en una sola línia les que es repeteixen seguides"

#: zypp_desk/pages/system.py:275
msgid "After the routine, check what must be restarted (zypper ps)"
msgstr "Després de la rutina, mira què cal reiniciar (zypper ps)"

#: zypp_desk/pages/updates.py:174
msgid "runs even if the previous one failed ( ; )"
msgstr "s'executa encara que l'anterior falli ( ; )"

#: zypp_desk/pages/updates.py:176
msgid "only if the previous one worked ( && )"
msgstr "només si l'anterior ha anat bé ( && )"

#: zypp_desk/pages/updates.py:198
msgid "Updates"
msgstr "Actualitzacions"

#: zypp_desk/pages/updates.py:209
msgid "Your routine"
msgstr "La teva rutina"

#: zypp_desk/pages/updates.py:214
msgid "Nobody can answer zypper in the middle of a routine, so it runs with -n: it takes its default answers (“yes, continue”) and stops without changing anything when you would have to choose, for example in a conflict."
msgstr "Enmig d'una rutina ningú no pot respondre a zypper, per això s'executa amb -n: tria les respostes per defecte («sí, continua») i s'atura sense canviar res quan hauries de triar tu, per exemple en un conflicte."

#: zypp_desk/pages/updates.py:218
msgid "Edit the routine…"
msgstr "Edita la rutina…"

#: zypp_desk/pages/updates.py:219
msgid "Simulate the dup…"
msgstr "Simula el dup…"

#: zypp_desk/pages/updates.py:220 zypp_desk/pages/updates.py:685
msgid "What would 'zypper dup' do?"
msgstr "Què faria «zypper dup»?"

#: zypp_desk/pages/updates.py:221
msgid "Stop after this step"
msgstr "Atura després d'aquest pas"

