msgstr "Mostra el terminal"

#: zypp_desk/mainwindow.py:179
msgid "Review"
msgstr "Revisa"

#: zypp_desk/mainwindow.py:180 zypp_desk/terminal.py:300
msgid "Clear"
msgstr "Buida"

#: zypp_desk/mainwindow.py:181 zypp_desk/mainwindow.py:392
#: zypp_desk/pages/localrpm.py:291 zypp_desk/pages/removedlg.py:77
#: zypp_desk/pages/system.py:230 zypp_desk/pages/updates.py:720
msgid "Simulate"
msgstr "Simula"

#: zypp_desk/mainwindow.py:182 zypp_desk/mainwindow.py:473
#: zypp_desk/mainwindow.py:490 zypp_desk/mainwindow.py:493
#: zypp_desk/simulation.py:771
msgid "Apply"
msgstr "Aplica"

#: zypp_desk/mainwindow.py:222
msgid "zypper's own output appears here while it works."
msgstr "Aquí surt la sortida de zypper mentre treballa."

#: zypp_desk/mainwindow.py:273 zypp_desk/pages/repos.py:1017
#, python-brace-format
msgid "This part is not available: {error}"
msgstr "Aquesta part no està disponible: {error}"

#: zypp_desk/mainwindow.py:303 zypp_desk/pages/updates.py:329
#: zypp_desk/pages/updates.py:669 zypp_desk/pages/updates.py:767
msgid "Wait until the current command finishes."
msgstr "Espera que acabi l'ordre que s'està executant."

#: zypp_desk/mainwindow.py:338
msgid "Finished with errors."
msgstr "Acabat amb errors."

#: zypp_desk/mainwindow.py:338
msgid "Finished."
msgstr "Acabat."

#: zypp_desk/mainwindow.py:348
msgid "Working…"
msgstr "Treballant…"

#: zypp_desk/mainwindow.py:356
msgid "empty"
msgstr "buida"

#: zypp_desk/mainwindow.py:358 zypp_desk/mainwindow.py:359
msgid "Queue"
msgstr "Cua"

#: zypp_desk/mainwindow.py:362
msgid "Nothing to do yet: choose packages, locks or repository changes."
msgstr "Encara no hi ha res a fer: tria paquets, bloquejos o canvis de repositoris."

#: zypp_desk/mainwindow.py:389
#, python-brace-format
msgid "Not simulated, because their repository is only added when the queue is applied: {list}"
msgstr "No s'ha simulat, perquè el seu repositori només s'afegeix quan s'aplica la cua: {list}"

#: zypp_desk/mainwindow.py:392
msgid "Changes to repositories, locks, languages and Flatpak apps cannot be simulated. These commands will run:"
msgstr "Els canvis de repositoris, bloquejos, llengües i aplicacions Flatpak no es poden simular. S'executaran aquestes ordres:"

#: zypp_desk/mainwindow.py:395
msgid "Simulation of the queue"
msgstr "Simulació de la cua"

#: zypp_desk/mainwindow.py:403 zypp_desk/simulation.py:93
#: zypp_desk/simulation.py:667
#, python-brace-format
msgid "Problem: {text}"
msgstr "Problema: {text}"

#: zypp_desk/mainwindow.py:405
msgid "A lock or an unlock you choose runs at once (a simulation only knows the locks that exist); the rest goes to the queue."
msgstr "Si tries un bloqueig o un desbloqueig, s'aplica de seguida (una simulació només coneix els bloquejos que ja existeixen); la resta va a la cua."

#: zypp_desk/mainwindow.py:456 zypp_desk/mainwindow.py:461
#: zypp_desk/pages/problems.py:125
msgid "Choose a solution"
msgstr "Tria una solució"

#: zypp_desk/mainwindow.py:456
msgid "These commands run now, before simulating again:"
msgstr "Aquestes ordres s'executen ara, abans de tornar a simular:"

#: zypp_desk/mainwindow.py:457
msgid "You can unlock it later in Locks."
msgstr "Més endavant el pots desbloquejar a Bloquejos."

#: zypp_desk/mainwindow.py:473
msgid "Run these commands now?"
msgstr "Vols executar ara aquestes ordres?"

#: zypp_desk/mainwindow.py:479
msgid "Applying the queue"
msgstr "Aplicant la cua"

#: zypp_desk/mainwindow.py:490
#, python-brace-format
msgid "{file} cannot be read any more: {error}"
msgstr "Ja no es pot llegir {file}: {error}"

#: zypp_desk/mainwindow.py:493
#, python-brace-format
msgid "{file} changed after it was checked, so it is not installed. Take it out of the queue and download it again."
msgstr "{file} ha canviat després de comprovar-lo, i per això no s'instal·la. Treu-lo de la cua i torna'l a baixar."

#: zypp_desk/mainwindow.py:513
#, python-brace-format
msgid "{file} could not be copied to {folder}: {error}"
msgstr "No s'ha pogut copiar {file} a {folder}: {error}"

#: zypp_desk/mainwindow.py:520
#, python-brace-format
msgid "{file} could not be moved to {folder}: {error}"
msgstr "No s'ha pogut moure {file} a {folder}: {error}"

#: zypp_desk/mainwindow.py:547
msgid "Package manager free"
msgstr "Gestor de paquets disponible"

#: zypp_desk/mainwindow.py:547
#, python-brace-format
msgid "Package manager in use by {proc}"
msgstr "Gestor de paquets ocupat per {proc}"

#: zypp_desk/mainwindow.py:548
msgid "No restart needed"
msgstr "No cal reiniciar"

#: zypp_desk/mainwindow.py:548 zypp_desk/tray.py:670 zypp_desk/tray.py:1006
msgid "Restart needed"
msgstr "Cal reiniciar"

#: zypp_desk/mainwindow.py:552
msgid "The helper that runs zypper as root is not installed, so the window can search and show information but cannot change anything yet. Run install.sh from the source folder."
msgstr "L'ajudant que executa zypper com a root no està instal·lat. Per això la finestra pot cercar i mostrar informació, però encara no pot canviar res. Executa install.sh des de la carpeta del codi."

#: zypp_desk/mainwindow.py:559
msgid "zypper is still working. Wait until it finishes before closing the window."
msgstr "zypper encara treballa. Espera que acabi abans de tancar la finestra."

#: zypp_desk/mainwindow.py:565
msgid "A program from the web is still downloading. Close anyway? The download stops and nothing is added to the queue."
