msgstr "Broadcom-Treiber wl (proprietär), aus der nicht-freien Paketquelle von openSUSE."

#: zypp_desk/drivers.py:1451
#, python-brace-format
msgid "Free drivers {drivers}, part of the kernel."
msgstr "Freie Treiber {drivers}, Teil des Kernels."

#: zypp_desk/drivers.py:1453
#, python-brace-format
