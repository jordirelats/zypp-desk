msgstr "läuft auch, wenn der vorige fehlgeschlagen ist ( ; )"

#: zypp_desk/pages/updates.py:176
msgid "only if the previous one worked ( && )"
msgstr "nur, wenn der vorige geklappt hat ( && )"

#: zypp_desk/pages/updates.py:198
