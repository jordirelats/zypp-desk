msgid "Left behind"
msgstr "Überreste"

#: zypp_desk/pages/scripts.py:429
msgid "Menu entries and folders of programs that are not there any more."
msgstr "Menüeinträge und Ordner von Programmen, die nicht mehr da sind."

#: zypp_desk/pages/scripts.py:440 zypp_desk/pages/scripts.py:443
msgid "Where"
msgstr "Ort"

#: zypp_desk/pages/scripts.py:440
#, python-brace-format
msgid "{folder} · in your folder, without the administrator password"
msgstr "{folder} · in deinem persönlichen Ordner, ohne Administratorpasswort"

#: zypp_desk/pages/scripts.py:443
#, python-brace-format
msgid "{folder} · for the whole computer: removing it needs the administrator password"
msgstr "{folder} · für den ganzen Computer: Zum Entfernen braucht es das Administratorpasswort"

#: zypp_desk/pages/scripts.py:449
#, python-brace-format
msgid "{n} entry ({names})"
msgid_plural "{n} entries ({names})"
msgstr[0] "{n} Eintrag ({names})"
msgstr[1] "{n} Einträge ({names})"

#: zypp_desk/pages/scripts.py:454
msgid "also on the desktop"
