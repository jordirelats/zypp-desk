msgid "This cannot be done safely from here."
msgstr "Das lässt sich von hier aus nicht sicher erledigen."

#: zypp_desk/simulation.py:365
#, python-brace-format
msgid "{pkg} is uninstalled: whatever uses it may lose some functions. The next simulation shows if anything else would go too."
msgstr "{pkg} wird deinstalliert: Was davon abhängt, verliert vielleicht einige Funktionen. Die nächste Simulation zeigt, ob noch etwas anderes wegfallen würde."

#: zypp_desk/simulation.py:368
#, python-brace-format
msgid "{pkg} is uninstalled now, but only if nothing else needs it: otherwise zypper refuses and nothing changes. Whatever uses it may lose some functions."
msgstr "{pkg} wird jetzt deinstalliert, aber nur, wenn nichts anderes es braucht: Sonst lehnt zypper ab, und nichts ändert sich. Was davon abhängt, verliert vielleicht einige Funktionen."

