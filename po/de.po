msgstr "Das installierte Paket {pkg} benötigt {dep}, und keine aktive Paketquelle hat das noch."

#: zypp_desk/simulation.py:300
#, python-brace-format
msgid "{pkg} needs {dep}, and no enabled repository has it. Maybe a repository is missing, or the package is broken."
msgstr "{pkg} benötigt {dep}, und keine aktive Paketquelle hat das. Vielleicht fehlt eine Paketquelle, oder das Paket ist defekt."

#: zypp_desk/simulation.py:303
#, python-brace-format
msgid "You asked for {dep}, but no enabled repository has it."
msgstr "Du hast {dep} angefordert, aber keine aktive Paketquelle hat das."

#: zypp_desk/simulation.py:305
#, python-brace-format
msgid "The package {pkg} that you asked for is not in any enabled repository."
msgstr "Das angeforderte Paket {pkg} ist in keiner aktiven Paketquelle."

#: zypp_desk/simulation.py:307
#, python-brace-format
msgid "{pkg} conflicts with itself ({dep}): the package is broken."
msgstr "{pkg} steht im Konflikt mit sich selbst ({dep}): Das Paket ist defekt."

#: zypp_desk/simulation.py:311
msgid "would be installed"
msgstr "soll installiert werden"

#: zypp_desk/simulation.py:312
#, python-brace-format
msgid "These two cannot be on the system together: {a} ({a_state}) and {b} ({b_state})."
msgstr "Diese beiden können nicht gleichzeitig auf dem System sein: {a} ({a_state}) und {b} ({b_state})."

#: zypp_desk/simulation.py:315
#, python-brace-format
msgid "{a} conflicts with {dep}, which {b} provides."
msgstr "{a} steht im Konflikt mit {dep}, das {b} bereitstellt."

#: zypp_desk/simulation.py:318
#, python-brace-format
msgid "{a} replaces {dep}, which {b} provides."
msgstr "{a} ersetzt {dep}, das {b} bereitstellt."

#: zypp_desk/simulation.py:321
#, python-brace-format
msgid "These two cannot be on the system together: {a} and {b}."
msgstr "Diese beiden können nicht gleichzeitig auf dem System sein: {a} und {b}."

#: zypp_desk/simulation.py:323
#, python-brace-format
msgid "{a} and {b} cannot be installed at the same time."
msgstr "{a} und {b} können nicht gleichzeitig installiert werden."

#: zypp_desk/simulation.py:325
#, python-brace-format
msgid "The installed {pkg} can neither stay as it is nor be updated."
msgstr "Das installierte Paket {pkg} kann weder bleiben, wie es ist, noch aktualisiert werden."

#: zypp_desk/simulation.py:326
#, python-brace-format
msgid "There is a problem with {pkg}, which would be installed."
msgstr "Es gibt ein Problem mit {pkg}, das installiert werden soll."

#: zypp_desk/simulation.py:329
#, python-brace-format
msgid "The installed {pkg} is not in any of your repositories any more, so the upgrade has to replace it."
msgstr "Das installierte Paket {pkg} ist in keiner deiner Paketquellen mehr, daher muss die Aktualisierung es ersetzen."

#: zypp_desk/simulation.py:332
#, python-brace-format
msgid "{pkg} comes from a repository that this upgrade does not use."
msgstr "{pkg} kommt aus einer Paketquelle, die diese Aktualisierung nicht benutzt."

#: zypp_desk/simulation.py:334
#, python-brace-format
msgid "{pkg} is built for an older type of processor than the other versions available."
msgstr "{pkg} ist für einen älteren Prozessortyp gebaut als die anderen verfügbaren Versionen."

#: zypp_desk/simulation.py:337
#, python-brace-format
msgid "{pkg} cannot be installed on this computer."
msgstr "{pkg} kann auf diesem Computer nicht installiert werden."

#: zypp_desk/simulation.py:339
#, python-brace-format
msgid "{dep} is part of the system and cannot be removed."
msgstr "{dep} gehört zum System und kann nicht entfernt werden."

#: zypp_desk/simulation.py:341
msgid "The changes asked for contradict each other."
msgstr "Die angeforderten Änderungen widersprechen sich."

#: zypp_desk/simulation.py:343
msgid "There is a dependency problem."
msgstr "Es gibt ein Abhängigkeitsproblem."

#: zypp_desk/simulation.py:345
msgid "zypper cannot do what was asked."
msgstr "zypper kann nicht tun, was angefordert wurde."

#: zypp_desk/simulation.py:347
msgid "This change would break your system."
msgstr "Diese Änderung würde dein System beschädigen."

#: zypp_desk/simulation.py:367
msgid "This cannot be done safely from here."
msgstr "Das lässt sich von hier aus nicht sicher erledigen."

#: zypp_desk/simulation.py:375
#, python-brace-format
msgid "{pkg} is uninstalled: whatever uses it may lose some functions. The next simulation shows if anything else would go too."
msgstr "{pkg} wird deinstalliert: Was davon abhängt, verliert vielleicht einige Funktionen. Die nächste Simulation zeigt, ob noch etwas anderes wegfallen würde."

#: zypp_desk/simulation.py:378
#, python-brace-format
msgid "{pkg} is uninstalled now, but only if nothing else needs it: otherwise zypper refuses and nothing changes. Whatever uses it may lose some functions."
msgstr "{pkg} wird jetzt deinstalliert, aber nur, wenn nichts anderes es braucht: Sonst lehnt zypper ab, und nichts ändert sich. Was davon abhängt, verliert vielleicht einige Funktionen."

#: zypp_desk/simulation.py:387
#, python-brace-format
msgid "Do not update {name}"
msgstr "{name} nicht aktualisieren"

#: zypp_desk/simulation.py:388
#, python-brace-format
msgid "The rest goes ahead. {name} stays at version {version} and is locked: it will not change until you unlock it."
msgstr "Der Rest wird ausgeführt. {name} bleibt bei Version {version} und wird gesperrt: Es ändert sich nicht, bis du es entsperrst."

#: zypp_desk/simulation.py:390
#, python-brace-format
msgid "The rest goes ahead. {name} stays as it is and is locked: it will not change until you unlock it."
msgstr "Der Rest wird ausgeführt. {name} bleibt, wie es ist, und wird gesperrt: Es ändert sich nicht, bis du es entsperrst."

#: zypp_desk/simulation.py:399
#, python-brace-format
msgid "{name} is locked, so the upgrade leaves it out: it will not be installed or changed until you unlock it."
msgstr "{name} wird gesperrt, daher lässt die Aktualisierung es aus: Es wird nicht installiert oder geändert, bis du es entsperrst."

#: zypp_desk/simulation.py:404
#, python-brace-format
msgid "Do not remove {name}"
msgstr "{name} nicht entfernen"

#: zypp_desk/simulation.py:405
#, python-brace-format
msgid "{name} stays installed and its removal leaves the queue; the rest goes ahead."
msgstr "{name} bleibt installiert, und sein Entfernen kommt aus der Warteschlange; der Rest wird ausgeführt."

#: zypp_desk/simulation.py:407
#, python-brace-format
msgid "{name} stays installed and is locked, so the upgrade cannot remove it until you unlock it."
msgstr "{name} bleibt installiert und wird gesperrt, daher kann die Aktualisierung es nicht entfernen, bis du es entsperrst."

#: zypp_desk/simulation.py:412
#, python-brace-format
msgid "{name} is locked. Without the lock, zypper can remove it."
msgstr "{name} ist gesperrt. Ohne die Sperre kann zypper es entfernen."

#: zypp_desk/simulation.py:413
#, python-brace-format
msgid "{name} is locked. Without the lock, zypper can install it."
msgstr "{name} ist gesperrt. Ohne die Sperre kann zypper es installieren."

#: zypp_desk/simulation.py:414
#, python-brace-format
msgid "Unlock {name}"
msgstr "{name} entsperren"

#: zypp_desk/simulation.py:418
#, python-brace-format
msgid "Go back to {pkg}"
msgstr "Zurück zu {pkg}"

#: zypp_desk/simulation.py:419
#, python-brace-format
msgid "{name} goes back from version {old} to the older {new}, so that everything fits."
msgstr "{name} geht von Version {old} auf die ältere {new} zurück, damit alles zusammenpasst."

#: zypp_desk/simulation.py:430
#, python-brace-format
msgid "Switch {name} to the package from {vendor}"
msgstr "{name} auf das Paket von {vendor} umstellen"

#: zypp_desk/simulation.py:431
#, python-brace-format
msgid "{pkg} from {vendor} replaces the one from {old_vendor}. This changes the vendor: from now on {name} is updated from {vendor}."
msgstr "{pkg} von {vendor} ersetzt das von {old_vendor}. Damit wechselt der Anbieter: Ab jetzt wird {name} von {vendor} aktualisiert."

#: zypp_desk/simulation.py:438
#, python-brace-format
msgid "Replace {old} with {new}"
msgstr "{old} durch {new} ersetzen"

#: zypp_desk/simulation.py:439
#, python-brace-format
msgid "{new} is installed in place of {old}."
msgstr "{new} wird anstelle von {old} installiert."

#: zypp_desk/simulation.py:444
#, python-brace-format
msgid "Install {pkg} anyway"
msgstr "{pkg} trotzdem installieren"

#: zypp_desk/simulation.py:445
msgid "It comes from a repository that this upgrade leaves out, but it is taken from there anyway."
msgstr "Es kommt aus einer Paketquelle, die diese Aktualisierung auslässt, wird aber trotzdem von dort genommen."

#: zypp_desk/simulation.py:449
#, python-brace-format
msgid "Install {name} anyway, ignoring some of its dependencies"
msgstr "{name} trotzdem installieren und dabei einige seiner Abhängigkeiten ignorieren"

#: zypp_desk/simulation.py:451
#, python-brace-format
msgid "This cannot be done safely from here: {name} might not work."
msgstr "Das lässt sich von hier aus nicht sicher erledigen: {name} funktioniert dann vielleicht nicht."

#: zypp_desk/simulation.py:454
#, python-brace-format
msgid "Change {name} to another architecture"
msgstr "{name} auf eine andere Architektur umstellen"

#: zypp_desk/simulation.py:456
#, python-brace-format
msgid "Install {pkg}, built for an older type of processor"
msgstr "{pkg} installieren, gebaut für einen älteren Prozessortyp"

#: zypp_desk/simulation.py:458
#, python-brace-format
msgid "Install {pkg}, although its vendor withdrew it"
msgstr "{pkg} installieren, obwohl sein Anbieter es zurückgezogen hat"

#: zypp_desk/simulation.py:460
#, python-brace-format
msgid "Install {pkg}, although it is blocked"
msgstr "{pkg} installieren, obwohl es blockiert ist"

#: zypp_desk/simulation.py:462
#, python-brace-format
msgid "Install the temporary fix (PTF) {pkg}"
msgstr "Vorläufige Korrektur (PTF) {pkg} installieren"

#: zypp_desk/simulation.py:464
msgid "Ignore the warning that the system would break"
msgstr "Die Warnung ignorieren, dass das System beschädigt würde"

#: zypp_desk/simulation.py:466
msgid "Ignore some dependencies"
msgstr "Einige Abhängigkeiten ignorieren"

#: zypp_desk/simulation.py:467
msgid "Zypp Desk does not know this solution, so it cannot be chosen here."
msgstr "Zypp Desk kennt diese Lösung nicht, daher kann sie hier nicht gewählt werden."

#: zypp_desk/simulation.py:642
msgid "A license must be accepted. Turn on “Accept licenses without asking” in Settings, or install it from a terminal."
msgstr "Eine Lizenz muss akzeptiert werden. Schalte „Lizenzen ohne Nachfrage akzeptieren“ in den Einstellungen ein oder installiere es in einem Terminal."

#: zypp_desk/simulation.py:716 zypp_desk/simulation.py:770
msgid "Nothing to do."
msgstr "Nichts zu tun."

#: zypp_desk/simulation.py:753
msgid "It can be done. Nothing has been changed."
msgstr "Das ist machbar. Es wurde nichts geändert."

