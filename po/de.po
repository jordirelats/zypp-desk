msgid "Check now"
msgstr "Jetzt prüfen"

#: zypp_desk/pages/websources.py:488
#, python-brace-format
msgid "zypper uses it as the repository “{name}” ({alias}), so every version stays together and zypper sees them."
msgstr "zypper benutzt diesen Ordner als Paketquelle „{name}“ ({alias}), so bleiben alle Versionen beisammen und zypper sieht sie."

