#: zypp_desk/txqueue.py:293
#, python-brace-format
msgctxt "change"
msgid "Disable the repository “{name}”"
msgstr "Paketquelle „{name}“ deaktivieren"

#: zypp_desk/txqueue.py:294 zypp_desk/txqueue.py:312
msgid "zypper stops looking for programs and updates there until you enable it again. What you installed from it stays installed."
msgstr "zypper sucht dort nicht mehr nach Programmen und Aktualisierungen, bis du sie wieder aktivierst. Was du daraus installiert hast, bleibt installiert."

#: zypp_desk/txqueue.py:297
#, python-brace-format
msgctxt "change"
msgid "Change the priority of the repository “{name}”"
msgstr "Priorität der Paketquelle „{name}“ ändern"

#: zypp_desk/txqueue.py:299
#, python-brace-format
msgctxt "change"
msgid "Rename the repository “{name}”"
msgstr "Paketquelle „{name}“ umbenennen"

#: zypp_desk/txqueue.py:301
#, python-brace-format
msgctxt "change"
msgid "Change the repository “{name}”"
msgstr "Paketquelle „{name}“ ändern"

#: zypp_desk/txqueue.py:307
#, python-brace-format
msgid "Priority {n}: the lower the number, the more zypper prefers it."
msgstr "Priorität {n}: Je kleiner die Zahl, desto lieber nimmt zypper sie."

#: zypp_desk/txqueue.py:309
#, python-brace-format
msgid "New name: {name}."
msgstr "Neuer Name: {name}."

#: zypp_desk/txqueue.py:315
msgid "zypper refreshes it on its own before it looks for updates."
msgstr "zypper lädt sie selbst neu, bevor es nach Aktualisierungen sucht."

#: zypp_desk/txqueue.py:316
msgid "zypper no longer refreshes it on its own."
msgstr "zypper lädt sie nicht mehr selbst neu."

#: zypp_desk/txqueue.py:318
msgid "The packages downloaded from it are kept."
msgstr "Die daraus heruntergeladenen Pakete werden aufbewahrt."

#: zypp_desk/txqueue.py:319
msgid "The packages downloaded from it are no longer kept."
msgstr "Die daraus heruntergeladenen Pakete werden nicht mehr aufbewahrt."

#: zypp_desk/txqueue.py:332
msgid "Also what only it needed. Programs that need it go too."
msgid_plural "Also what only they needed. Programs that need them go too."
msgstr[0] "Auch alles, was nur dieses Paket brauchte. Programme, die es brauchen, werden ebenfalls entfernt."
msgstr[1] "Auch alles, was nur diese Pakete brauchten. Programme, die sie brauchen, werden ebenfalls entfernt."

#: zypp_desk/txqueue.py:335
msgid "Only if nothing installed still needs it: otherwise zypper stops and changes nothing."
msgid_plural "Only if nothing installed still needs them: otherwise zypper stops and changes nothing."
msgstr[0] "Nur wenn nichts Installiertes es noch braucht: Sonst bricht zypper ab und ändert nichts."
msgstr[1] "Nur wenn nichts Installiertes sie noch braucht: Sonst bricht zypper ab und ändert nichts."

#: zypp_desk/txqueue.py:337
msgid "Programs that need it are removed with it."
msgid_plural "Programs that need them are removed with them."
msgstr[0] "Programme, die es brauchen, werden mit ihm entfernt."
msgstr[1] "Programme, die sie brauchen, werden mit ihnen entfernt."

#. TRANSLATORS: a change in a list (the Apply question, the queue): ca uses the infinitive here
#: zypp_desk/txqueue.py:428
#, python-brace-format
msgid "Update {n} package"
msgid_plural "Update {n} packages"
msgstr[0] "{n} Paket aktualisieren"
msgstr[1] "{n} Pakete aktualisieren"

#: zypp_desk/txqueue.py:429
msgid "Each one to the newest version from the same vendor."
msgstr "Jedes auf die neueste Version desselben Anbieters."

#. TRANSLATORS: a change in a list (the Apply question, the queue): ca uses the infinitive here
#: zypp_desk/txqueue.py:439
#, python-brace-format
msgid "Remove {n} package"
msgid_plural "Remove {n} packages"
msgstr[0] "{n} Paket entfernen"
msgstr[1] "{n} Pakete entfernen"

#. TRANSLATORS: a change in a list (the Apply question, the queue): ca uses the infinitive here
#: zypp_desk/txqueue.py:447
#, python-brace-format
msgid "Lock {n} package"
msgid_plural "Lock {n} packages"
msgstr[0] "{n} Paket sperren"
msgstr[1] "{n} Pakete sperren"

#: zypp_desk/txqueue.py:448
msgid "zypper will not install, update or remove them until you unlock them."
msgstr "zypper wird sie nicht installieren, aktualisieren oder entfernen, bis du sie entsperrst."

#. TRANSLATORS: a change in a list (the Apply question, the queue): ca uses the infinitive here
#: zypp_desk/txqueue.py:452
#, python-brace-format
msgid "Unlock {n} package"
msgid_plural "Unlock {n} packages"
msgstr[0] "{n} Paket entsperren"
msgstr[1] "{n} Pakete entsperren"

#: zypp_desk/txqueue.py:453
msgid "zypper may install, update or remove them again."
msgstr "zypper darf sie wieder installieren, aktualisieren oder entfernen."

#: zypp_desk/txqueue.py:458
msgid "New packages signed with them are refused until you trust them again."
msgstr "Neue Pakete, die damit signiert sind, werden abgelehnt, bis du ihnen wieder vertraust."

#. TRANSLATORS: a change in a list (the Apply question, the queue): ca uses the infinitive here
#: zypp_desk/txqueue.py:461
#, python-brace-format
msgid "Update {n} Flatpak app"
msgid_plural "Update {n} Flatpak apps"
msgstr[0] "{n} Flatpak-App aktualisieren"
msgstr[1] "{n} Flatpak-Apps aktualisieren"

#: zypp_desk/txqueue.py:462
msgid "And the runtimes they use, if they need new ones."
msgstr "Und die Laufzeitumgebungen, die sie verwenden, falls sie neue brauchen."

#: zypp_desk/txqueue.py:743
#, python-brace-format
msgid "{name} is protected, so it is not removed. To remove it, first choose “Stop protecting {name}” on its card in Applications."
msgstr "{name} ist geschützt und wird deshalb nicht entfernt. Um es zu entfernen, wähle zuerst „Schutz von {name} aufheben“ auf seiner Karte unter Anwendungen."

#: zypp_desk/txqueue.py:1071
#, python-brace-format
msgid "{n} to remove"
msgid_plural "{n} to remove"
msgstr[0] "{n} zu entfernen"
msgstr[1] "{n} zu entfernen"

#: zypp_desk/txqueue.py:1073
#, python-brace-format
msgid "{n} Flatpak change"
msgid_plural "{n} Flatpak changes"
msgstr[0] "{n} Flatpak-Änderung"
msgstr[1] "{n} Flatpak-Änderungen"

#: zypp_desk/websources.py:155
msgid "The server sent the download to an address that is not https."
msgstr "Der Server hat den Download an eine Adresse umgeleitet, die kein https ist."

#: zypp_desk/websources.py:216
#, python-brace-format
msgid "GitHub answers only 60 questions an hour without an account: try again in {n} minute."
msgid_plural "GitHub answers only 60 questions an hour without an account: try again in {n} minutes."
msgstr[0] "Ohne Konto beantwortet GitHub nur 60 Anfragen pro Stunde: Versuche es in {n} Minute noch einmal."
msgstr[1] "Ohne Konto beantwortet GitHub nur 60 Anfragen pro Stunde: Versuche es in {n} Minuten noch einmal."

#: zypp_desk/websources.py:275
msgid "The page is too big."
msgstr "Die Seite ist zu groß."

#: zypp_desk/websources.py:313
#, python-brace-format
msgid "No link on the page matches {pattern}."
msgstr "Kein Link auf der Seite passt zu {pattern}."

#: zypp_desk/websources.py:349
#, python-brace-format
msgid "Unknown kind of source: {kind}"
msgstr "Unbekannte Art von Quelle: {kind}"

#: zypp_desk/websources.py:412
#, python-brace-format
msgid "The file contains the package “{found}”, not “{expected}”. It was deleted."
msgstr "Die Datei enthält das Paket „{found}“, nicht „{expected}“. Sie wurde gelöscht."

#: zypp_desk/websources.py:471
#, python-brace-format
msgid "The .zip file has no RPM of {package}."
msgstr "Die .zip-Datei enthält kein RPM von {package}."

#: zypp_desk/yumrepos.py:170
msgid "Its address is made for one version of Fedora ($releasever)."
msgstr "Ihre Adresse ist für eine einzige Fedora-Version gemacht ($releasever)."

#: zypp_desk/yumrepos.py:172
#, python-brace-format
msgid "Its address uses {variable}, which only dnf knows."
msgstr "Ihre Adresse verwendet {variable}, das nur dnf kennt."

#: zypp_desk/yumrepos.py:181
msgid "Its address is not on the web (http or https)."
msgstr "Ihre Adresse liegt nicht im Web (http oder https)."

#: zypp_desk/yumrepos.py:183
msgid "It only has a list of mirrors (metalink or mirrorlist), which zypper cannot read."
msgstr "Sie hat nur eine Liste von Spiegelservern (metalink oder mirrorlist), die zypper nicht lesen kann."

#: zypp_desk/yumrepos.py:186
msgid "It has no address."
msgstr "Sie hat keine Adresse."

#: zypp_desk/yumrepos.py:188
msgid "Other users can change this file, so it is not used."
msgstr "Andere Benutzer können diese Datei ändern, deshalb wird sie nicht verwendet."

#: zypp_desk/yumrepos.py:201
#, python-brace-format
msgid "Its address carries settings for zypper ({options}) that change how it checks the server or where it downloads from."
msgstr "Ihre Adresse enthält Einstellungen für zypper ({options}), die ändern, wie es den Server prüft oder woher es herunterlädt."

#: zypp_desk/yumrepos.py:249
msgid "Its address is not encrypted (http, and https does not answer there), and its packages are not signed: anybody on the network could change what zypper installs as root."
msgstr "Ihre Adresse ist nicht verschlüsselt (http, und https antwortet dort nicht), und ihre Pakete sind nicht signiert: Jeder im Netzwerk könnte ändern, was zypper als root installiert."

#: zypp_desk/yumrepos.py:396
msgid "Other users can change this file, or it does not exist."
msgstr "Andere Benutzer können diese Datei ändern, oder sie existiert nicht."

#: zypp_desk/yumrepos.py:402
msgid "Zypp Desk only takes keys from a file on this computer or from an https address."
msgstr "Zypp Desk übernimmt Schlüssel nur aus einer Datei auf diesem Computer oder von einer https-Adresse."

#: zypp_desk/yumrepos.py:432
msgid "Its key has expired or was revoked by its owner."
msgstr "Der Schlüssel ist abgelaufen oder wurde von seinem Besitzer widerrufen."

#: zypp_desk/zyppcmds.py:300
#, python-brace-format
msgid "zypper's help could not be read (exit code {code})."
msgstr "Die Hilfe von zypper konnte nicht gelesen werden (Exit-Code {code})."

#: zypp_desk/zyppcmds.py:329
msgid "zypper could not be run."
msgstr "zypper konnte nicht ausgeführt werden."

#: zypp_desk/zyppcmds.py:554
#, python-brace-format
msgid "“{option}” is not accepted here. Options that point zypper at another root, configuration, cache or repository folder, or that add repositories or trust keys on their own, are refused, as the helper that runs zypper as administrator refuses them."
msgstr "„{option}“ wird hier nicht akzeptiert. Optionen, die zypper auf ein anderes Wurzelverzeichnis, eine andere Konfiguration, einen anderen Zwischenspeicher oder Paketquellen-Ordner lenken oder die eigenmächtig Paketquellen hinzufügen oder Schlüsseln vertrauen, werden abgelehnt, so wie das Hilfsprogramm, das zypper als Administrator ausführt, sie ablehnt."

#: zypp_desk/zyppcmds.py:596 zypp_desk/zyppcmds.py:612
#, python-brace-format
msgid "zypper has no global option “{option}”."
msgstr "zypper hat keine globale Option „{option}“."

#: zypp_desk/zyppcmds.py:601 zypp_desk/zyppcmds.py:619
#, python-brace-format
msgid "“{option}” needs a value after it."
msgstr "„{option}“ braucht danach einen Wert."

#: zypp_desk/zyppcmds.py:689
#, python-brace-format
msgid "“zypper {command}” waits for you to type, and nobody can type into a command here. Write each command on the line above instead."
msgstr "„zypper {command}“ wartet auf deine Eingaben, und hier kann niemand etwas in einen Befehl eingeben. Schreibe stattdessen jeden Befehl in die Zeile oben."

#: zypp_desk/zyppcmds.py:691
#, python-brace-format
msgid "“zypper {command}” is not one of the commands the helper runs as administrator, so it cannot run from here. Use a terminal for it."
msgstr "„zypper {command}“ gehört nicht zu den Befehlen, die das Hilfsprogramm als Administrator ausführt, und kann deshalb nicht von hier aus laufen. Verwende dafür ein Terminal."

#: zypp_desk/zyppcmds.py:696
msgid "-n was added: zypper cannot ask you anything here, so it takes its default answers."
msgstr "-n wurde hinzugefügt: zypper kann dich hier nichts fragen und nimmt deshalb die Standardantworten."

#: zypp_desk/zyppcmds.py:705 zypp_desk/zyppcmds.py:752
msgid "A line break or a null character cannot go into a command."
msgstr "Ein Zeilenumbruch oder ein Nullzeichen darf nicht in einem Befehl stehen."

#: zypp_desk/zyppcmds.py:716
msgid "Which zypper command? It comes after the global options, for example: zypper -v se vlc"
msgstr "Welcher zypper-Befehl? Er kommt nach den globalen Optionen, zum Beispiel: zypper -v se vlc"

#: zypp_desk/zyppcmds.py:720
#, python-brace-format
msgid "zypper has no command “{command}”. The list on the left has them all."
msgstr "zypper hat keinen Befehl „{command}“. Die Liste links enthält alle."

#: zypp_desk/zyppcmds.py:729
#, python-brace-format
msgid "“{command}” is a program of its own (a zypper subcommand): global options cannot go before it."
msgstr "„{command}“ ist ein eigenes Programm (ein zypper-Unterbefehl): Globale Optionen dürfen nicht davor stehen."

#: zypp_desk/zyppcmds.py:734
#, python-brace-format
msgid "The global option “{option}” is not accepted with a command that changes the system: the helper that runs zypper as administrator refuses it."
msgstr "Die globale Option „{option}“ wird bei einem Befehl, der das System ändert, nicht akzeptiert: Das Hilfsprogramm, das zypper als Administrator ausführt, lehnt sie ab."

#: zypp_desk/zyppcmds.py:750 zypp_desk/zyppcmds.py:771
msgid "Type a zypper command, for example: zypper se vlc"
msgstr "Gib einen zypper-Befehl ein, zum Beispiel: zypper se vlc"

#: zypp_desk/zyppcmds.py:755
#, python-brace-format
msgid "Only one zypper command at a time: “{op}” is not accepted here (no ;, &&, |, > or <). Nothing runs through a shell."
msgstr "Nur ein zypper-Befehl auf einmal: „{op}“ wird hier nicht akzeptiert (kein ;, &&, |, > oder <). Nichts läuft über eine Shell."

#: zypp_desk/zyppcmds.py:760
#, python-brace-format
msgid "The line cannot be read: {error}."
msgstr "Die Zeile kann nicht gelesen werden: {error}."

#: zypp_desk/zyppcmds.py:764
msgid "sudo is not needed: Zypp Desk asks for the administrator password itself when the command changes the system."
msgstr "sudo ist nicht nötig: Zypp Desk fragt selbst nach dem Administratorpasswort, wenn der Befehl das System ändert."

#: zypp_desk/zyppcmds.py:769
#, python-brace-format
msgid "Only zypper runs here: “{word}” is not a zypper command."
msgstr "Hier läuft nur zypper: „{word}“ ist kein zypper-Befehl."

