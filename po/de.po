msgstr "Zypp Desk konnte nicht lesen, welchen Treiber er verwendet."

#: zypp_desk/drivers.py:1560
msgid "Firmware the kernel asked for"
msgstr "Vom Kernel angeforderte Firmware"

#: zypp_desk/drivers.py:1561
#, python-brace-format
msgid "At start, a driver could not load its firmware. {names} has it."
msgid_plural "At start, drivers could not load their firmware. {names} have it."
msgstr[0] "Beim Start konnte ein Treiber seine Firmware nicht laden. Sie ist im Paket {names}."
msgstr[1] "Beim Start konnten Treiber ihre Firmware nicht laden. Sie ist in den Paketen {names}."

