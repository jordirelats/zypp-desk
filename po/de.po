#: zypp_desk/bridge.py:483
#, python-brace-format
msgid "Your bridge {bridge} already says so."
msgstr "Dein Brückenpaket {bridge} sagt das schon."

#: zypp_desk/bridge.py:539
#, python-brace-format
msgid "{dirs} belongs to {package}"
msgid_plural "{dirs} belong to {package}"
msgstr[0] "{dirs} gehört zu {package}"
msgstr[1] "{dirs} gehören zu {package}"

#: zypp_desk/bridge.py:541
#, python-brace-format
msgid "The folders where it puts its files are already there: {list}."
msgstr "Die Ordner, in die es seine Dateien legt, sind schon da: {list}."

#: zypp_desk/bridge.py:550
#, python-brace-format
msgid "{name} is {bare} for this computer's processor; openSUSE does not write the processor in the name."
msgstr "{name} ist {bare} für den Prozessor dieses Computers; openSUSE schreibt den Prozessor nicht in den Namen."

#: zypp_desk/bridge.py:553
#, python-brace-format
msgid "The same thing: {fedora} in Fedora is {opensuse} in openSUSE."
msgstr "Dasselbe: {fedora} in Fedora ist {opensuse} in openSUSE."

#: zypp_desk/bridge.py:557
msgid "openSUSE has nothing under this name, and Zypp Desk knows no other name for it."
msgstr "openSUSE hat nichts unter diesem Namen, und Zypp Desk kennt keinen anderen Namen dafür."

#: zypp_desk/bridge.py:563
#, python-brace-format
msgid "openSUSE has {package} {version}, which is not what it asks for."
msgstr "openSUSE hat {package} {version}, und das ist nicht das, was es verlangt."

#: zypp_desk/bridge.py:566
#, python-brace-format
msgid "Zypp Desk cannot tell which version of {package} openSUSE has."
msgstr "Zypp Desk kann nicht feststellen, welche Version von {package} openSUSE hat."

#: zypp_desk/bridge.py:583
#, python-brace-format
msgid "{path} is the same file as {real}, which belongs to {package}."
msgstr "{path} ist dieselbe Datei wie {real}, die zu {package} gehört."

#: zypp_desk/bridge.py:591
#, python-brace-format
msgid "{path} is the same place as {real}, which {package} installs."
msgstr "{path} ist derselbe Ort wie {real}, den {package} installiert."

#: zypp_desk/bridge.py:595
msgid "No package of openSUSE has this file."
msgstr "Kein openSUSE-Paket hat diese Datei."

