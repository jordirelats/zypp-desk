#, python-brace-format
msgid "{pkg} from {vendor} replaces the one from {old_vendor}. This changes the vendor: from now on {name} is updated from {vendor}."
msgstr "{pkg} von {vendor} ersetzt das von {old_vendor}. Damit wechselt der Anbieter: Ab jetzt wird {name} von {vendor} aktualisiert."

