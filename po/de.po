msgstr "{a} ersetzt {dep}, das {b} bereitstellt."

#: zypp_desk/simulation.py:311
#, python-brace-format
msgid "These two cannot be on the system together: {a} and {b}."
msgstr "Diese beiden können nicht gleichzeitig auf dem System sein: {a} und {b}."

