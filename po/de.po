msgstr "Es wird nachgesehen, was es braucht …"

#: zypp_desk/pages/websources.py:1047
msgid "Package not verified by rpm"
msgstr "Paket nicht von rpm geprüft"

#: zypp_desk/pages/websources.py:1050
#, python-brace-format
msgid "From {where}."
msgstr "Von {where}."

#: zypp_desk/pages/websources.py:1058
msgid "It is not signed."
msgstr "Sie ist nicht signiert."

#: zypp_desk/pages/websources.py:1061
#, python-brace-format
