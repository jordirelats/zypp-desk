#, python-brace-format
msgid "{who} will update with the rest of the system. Nothing changes now: it happens when you apply the queue."
msgstr "{who} wird mit dem Rest des Systems aktualisiert. Jetzt ändert sich nichts: Das passiert, wenn du die Warteschlange anwendest."

#: zypp_desk/pages/repotools.py:734
#, python-brace-format
msgid "A new place to download programs and updates from: {url}"
msgstr "Ein neuer Ort, von dem Programme und Aktualisierungen heruntergeladen werden: {url}"

#: zypp_desk/pages/repotools.py:739 zypp_desk/pages/websources.py:612
#: zypp_desk/pages/websources.py:613
msgid "Add it to the queue"
msgstr "In die Warteschlange stellen"

#: zypp_desk/pages/repotools.py:739
#, python-brace-format
msgid "Add the personal project {project}?"
msgstr "Das persönliche Projekt {project} hinzufügen?"

#: zypp_desk/pages/repotools.py:740
msgid "Personal project"
msgstr "Persönliches Projekt"

#: zypp_desk/pages/repotools.py:741
#, python-brace-format
msgid "{project} belongs to one person and nobody else reviews it. It can bring anything, and it can stop being updated at any time. Add it only if you trust this person, or if nothing better exists."
msgstr "{project} gehört einer einzelnen Person, und niemand sonst prüft es. Es kann alles Mögliche mitbringen und jederzeit nicht mehr aktualisiert werden. Füge es nur hinzu, wenn du dieser Person vertraust oder wenn es nichts Besseres gibt."

#: zypp_desk/pages/routine_editor.py:30 zypp_desk/routine.py:166
msgid "Download the updates"
msgstr "Aktualisierungen herunterladen"

#: zypp_desk/pages/routine_editor.py:32
msgid "Own command…"
msgstr "Eigener Befehl …"

#: zypp_desk/pages/routine_editor.py:38
msgid "Get the newest package lists from your repositories."
msgstr "Holt die neuesten Paketlisten aus deinen Paketquellen."

#: zypp_desk/pages/routine_editor.py:39
msgid "Fetch everything the update needs. A later step installs it quickly."
msgstr "Holt alles, was die Aktualisierung braucht. Ein späterer Schritt installiert es dann schnell."

#: zypp_desk/pages/routine_editor.py:40
msgid "Bring the whole system to the newest version. This is how Tumbleweed is updated."
msgstr "Bringt das ganze System auf den neuesten Stand. So wird Tumbleweed aktualisiert."

#: zypp_desk/pages/routine_editor.py:41
msgid "Update the installed packages, without the bigger changes that dup makes."
msgstr "Aktualisiert die installierten Pakete, ohne die größeren Änderungen, die dup macht."

#: zypp_desk/pages/routine_editor.py:42
msgid "Update the apps you installed with Flatpak."
msgstr "Aktualisiert die Apps, die du mit Flatpak installiert hast."

#: zypp_desk/pages/routine_editor.py:43
msgid "Install new firmware for the computer and its devices. fwupd asks for the password itself."
msgstr "Installiert neue Firmware für den Computer und seine Geräte. fwupd fragt selbst nach dem Passwort."

#: zypp_desk/pages/routine_editor.py:45
msgid "List the programs that still use old files and should be restarted."
msgstr "Listet die Programme auf, die noch alte Dateien benutzen und neu gestartet werden sollten."

#: zypp_desk/pages/routine_editor.py:46
msgid "Remove the kernels you do not need any more. The one running now stays."
msgstr "Entfernt die Kernel, die du nicht mehr brauchst. Der gerade laufende bleibt."

#: zypp_desk/pages/routine_editor.py:47
msgid "Any zypper, flatpak or fwupdmgr command, written as in a terminal."
msgstr "Ein beliebiger zypper-, flatpak- oder fwupdmgr-Befehl, geschrieben wie in einem Terminal."

#: zypp_desk/pages/routine_editor.py:53
msgid "Explain everything (-v)"
msgstr "Ausführliche Ausgabe (-v)"

#: zypp_desk/pages/routine_editor.py:54
msgid "Force it (-f)"
msgstr "Erzwingen (-f)"

#: zypp_desk/pages/routine_editor.py:55
msgid "Accept licenses (-l)"
msgstr "Lizenzen akzeptieren (-l)"

#: zypp_desk/pages/routine_editor.py:56 zypp_desk/pages/system.py:844
msgid "Without recommended packages"
msgstr "Ohne empfohlene Pakete"

#: zypp_desk/pages/routine_editor.py:57
msgid "Allow a change of vendor"
msgstr "Anbieterwechsel erlauben"

#: zypp_desk/pages/routine_editor.py:58
msgid "Do not refresh again"
msgstr "Nicht noch einmal neu laden"

#: zypp_desk/pages/routine_editor.py:64
msgid "The terminal shows more of what zypper does (-v)."
msgstr "Das Terminal zeigt mehr davon, was zypper tut (-v)."

#: zypp_desk/pages/routine_editor.py:65
msgid "Download the lists again, even if they look up to date (-f)."
msgstr "Lädt die Listen erneut herunter, auch wenn sie aktuell aussehen (-f)."

#: zypp_desk/pages/routine_editor.py:66
msgid "Some packages (drivers, fonts) ask you to accept a license. With this the answer is yes (-l). The update steps after this one say yes too."
msgstr "Manche Pakete (Treiber, Schriftarten) verlangen, dass du eine Lizenz akzeptierst. Damit lautet die Antwort Ja (-l). Die Aktualisierungsschritte danach sagen auch Ja."

#: zypp_desk/pages/routine_editor.py:68 zypp_desk/pages/updates.py:1787
msgid "Install only what the packages need, not what they suggest (--no-recommends)."
msgstr "Installiert nur, was die Pakete brauchen, nicht was sie vorschlagen (--no-recommends)."

#: zypp_desk/pages/routine_editor.py:69
msgid "Let a package move to another vendor, for example from openSUSE to Packman (--allow-vendor-change)."
msgstr "Erlaubt einem Paket, zu einem anderen Anbieter zu wechseln, zum Beispiel von openSUSE zu Packman (--allow-vendor-change)."

#: zypp_desk/pages/routine_editor.py:71
msgid "Install just what the steps before downloaded, without looking at the lists again (--no-refresh)."
msgstr "Installiert genau das, was die vorigen Schritte heruntergeladen haben, ohne die Listen erneut anzusehen (--no-refresh)."

#: zypp_desk/pages/routine_editor.py:142
msgid "Drag to change the order"
msgstr "Ziehen, um die Reihenfolge zu ändern"

#: zypp_desk/pages/routine_editor.py:222
msgid "For example: zypper -v patch"
msgstr "Zum Beispiel: zypper -v patch"

#: zypp_desk/pages/routine_editor.py:236
#, python-brace-format
msgid "Move step {n} up"
msgstr "Schritt {n} nach oben verschieben"

#: zypp_desk/pages/routine_editor.py:238
#, python-brace-format
msgid "Move step {n} down"
msgstr "Schritt {n} nach unten verschieben"

#: zypp_desk/pages/routine_editor.py:240
#, python-brace-format
msgid "Take step {n} out of the routine"
msgstr "Schritt {n} aus der Routine nehmen"

#: zypp_desk/pages/routine_editor.py:266
msgid "Afterwards, whatever happens"
msgstr "Danach, egal was passiert"

#: zypp_desk/pages/routine_editor.py:267
msgid "Like ';' in a terminal: this step runs even if the one before went wrong."
msgstr "Wie „;“ in einem Terminal: Dieser Schritt läuft auch, wenn der vorige fehlgeschlagen ist."

#: zypp_desk/pages/routine_editor.py:268
msgid "Only if it went well"
msgstr "Nur, wenn es geklappt hat"

#: zypp_desk/pages/routine_editor.py:269
msgid "Like '&&' in a terminal: this step runs only if the one before went well."
msgstr "Wie „&&“ in einem Terminal: Dieser Schritt läuft nur, wenn der vorige geklappt hat."

#: zypp_desk/pages/routine_editor.py:412 zypp_desk/pages/routine_editor.py:431
msgid "Edit the routine"
msgstr "Routine bearbeiten"

#: zypp_desk/pages/routine_editor.py:452
msgid "There are no steps yet. Add one below."
msgstr "Es gibt noch keine Schritte. Füge unten einen hinzu."

#: zypp_desk/pages/routine_editor.py:458
msgid "+ Add a step:"
msgstr "+ Schritt hinzufügen:"

#: zypp_desk/pages/routine_editor.py:459
msgid "These buttons add a step at the end of the routine. Nothing runs now."
msgstr "Diese Knöpfe fügen am Ende der Routine einen Schritt hinzu. Jetzt läuft nichts."

#: zypp_desk/pages/routine_editor.py:468
msgid "Adds this step at the end of the routine. Nothing runs now."
msgstr "Fügt diesen Schritt am Ende der Routine hinzu. Jetzt läuft nichts."

#: zypp_desk/pages/routine_editor.py:476
msgid "When it runs, zypper also gets -n, flatpak -y and fwupdmgr --assume-yes --no-unreported-check: nobody can answer questions in the middle."
msgstr "Bei der Ausführung bekommt zypper außerdem -n, flatpak -y und fwupdmgr --assume-yes --no-unreported-check: Mittendrin kann niemand Fragen beantworten."

#: zypp_desk/pages/routine_editor.py:481
msgid "As written in a terminal"
msgstr "Wie in einem Terminal geschrieben"

#: zypp_desk/pages/routine_editor.py:510
msgid "A new line counts as ';'. Sudo is not needed: Zypp Desk asks for the password."
msgstr "Eine neue Zeile zählt als „;“. Sudo ist nicht nötig: Zypp Desk fragt nach dem Passwort."

#: zypp_desk/pages/routine_editor.py:524 zypp_desk/pages/routine_editor.py:612
msgid "Write it by hand"
msgstr "Von Hand schreiben"

#: zypp_desk/pages/routine_editor.py:527
msgid "Proposed routines…"
msgstr "Vorgeschlagene Routinen …"

#: zypp_desk/pages/routine_editor.py:529
msgid "Opens ready routines to start from, the first one made for this computer. The one you choose replaces these steps; nothing is saved until you save the routine."
msgstr "Öffnet fertige Routinen als Ausgangspunkt; die erste ist für diesen Computer gemacht. Die gewählte ersetzt diese Schritte; gespeichert wird erst, wenn du die Routine speicherst."

#: zypp_desk/pages/routine_editor.py:533
msgid "Back to the usual routine…"
msgstr "Zurück zur üblichen Routine …"

#: zypp_desk/pages/routine_editor.py:534
msgid "Asks first, then replaces these steps with the usual routine (nothing is saved until you save the routine):"
msgstr "Fragt zuerst und ersetzt dann diese Schritte durch die übliche Routine (gespeichert wird erst, wenn du die Routine speicherst):"

#: zypp_desk/pages/routine_editor.py:537
msgid "Close without saving: your routine stays as it was."
msgstr "Schließen, ohne zu speichern: Deine Routine bleibt, wie sie war."

#: zypp_desk/pages/routine_editor.py:539
msgid "Save the routine"
msgstr "Routine speichern"

#: zypp_desk/pages/routine_editor.py:540
msgid "Saves these steps as your routine. Nothing runs now."
msgstr "Speichert diese Schritte als deine Routine. Jetzt läuft nichts."

#: zypp_desk/pages/routine_editor.py:612
msgid "Use the steps"
msgstr "Schritte benutzen"

#: zypp_desk/pages/routine_editor.py:614
msgid "Back to the steps, one card each."
msgstr "Zurück zu den Schritten, eine Karte pro Schritt."

#: zypp_desk/pages/routine_editor.py:615
msgid "Shows the routine as one line of text, to write it as in a terminal."
msgstr "Zeigt die Routine als eine Textzeile, um sie wie in einem Terminal zu schreiben."

#: zypp_desk/pages/routine_editor.py:617
msgid "Write it as in a terminal. ';' runs the next command anyway, '&&' only if the previous one worked. Only zypper, flatpak and fwupdmgr commands are allowed."
msgstr "Schreibe sie wie in einem Terminal. „;“ führt den nächsten Befehl auf jeden Fall aus, „&&“ nur, wenn der vorige geklappt hat. Nur zypper-, flatpak- und fwupdmgr-Befehle sind erlaubt."

#: zypp_desk/pages/routine_editor.py:619
msgid "The steps run one after the other. Drag them to change the order."
msgstr "Die Schritte laufen nacheinander ab. Ziehe sie, um die Reihenfolge zu ändern."

#: zypp_desk/pages/routine_editor.py:687
#, python-brace-format
msgid "Step {n}: {error}"
msgstr "Schritt {n}: {error}"

#: zypp_desk/pages/routine_editor.py:704
#, python-brace-format
msgid "Not saved. {problem}"
msgstr "Nicht gespeichert. {problem}"

#: zypp_desk/pages/routine_editor.py:710
msgid "Back to the usual routine"
msgstr "Zurück zur üblichen Routine"

#: zypp_desk/pages/routine_editor.py:711
msgid "Replace these steps with the usual routine? Nothing is saved until you save the routine."
msgstr "Diese Schritte durch die übliche Routine ersetzen? Gespeichert wird erst, wenn du die Routine speicherst."

#: zypp_desk/pages/routine_editor.py:713
msgid "Keep these steps"
msgstr "Diese Schritte behalten"

#: zypp_desk/pages/routine_editor.py:714
msgid "Use the usual routine"
msgstr "Übliche Routine verwenden"

#: zypp_desk/pages/routine_proposals.py:66
msgid "Proposed for this computer"
msgstr "Vorgeschlagen für diesen Computer"

#: zypp_desk/pages/routine_proposals.py:66
msgid "Proposed for this computer · the one you have"
msgstr "Vorgeschlagen für diesen Computer · deine jetzige"

#: zypp_desk/pages/routine_proposals.py:68
msgid "The one you have"
msgstr "Deine jetzige"

#: zypp_desk/pages/routine_proposals.py:93
msgid "only if it worked →"
msgstr "nur, wenn es geklappt hat →"

#: zypp_desk/pages/routine_proposals.py:123
#: zypp_desk/pages/routine_proposals.py:129
msgid "Proposed routines"
msgstr "Vorgeschlagene Routinen"

#: zypp_desk/pages/routine_proposals.py:130
msgid "Choose one, and change it in the editor afterwards if you like. Nothing is saved until you press “Save the routine”."
msgstr "Wähle eine aus und ändere sie danach im Editor, wenn du möchtest. Gespeichert wird erst, wenn du auf „Routine speichern“ drückst."

#: zypp_desk/pages/routine_proposals.py:139
msgid "Looking at this computer…"
msgstr "Dieser Computer wird untersucht …"

#: zypp_desk/pages/routine_proposals.py:148
msgid "Close: the steps in the editor stay as they are."
msgstr "Schließen: Die Schritte im Editor bleiben, wie sie sind."

#: zypp_desk/pages/routine_proposals.py:150
msgid "Use the chosen routine"
msgstr "Gewählte Routine verwenden"

#: zypp_desk/pages/routine_proposals.py:151
msgid "Puts the chosen routine in the editor, in place of its steps. Nothing is saved until you save the routine, and nothing runs."
msgstr "Setzt die gewählte Routine in den Editor, anstelle der Schritte, die dort stehen. Gespeichert wird erst, wenn du die Routine speicherst, und nichts läuft."

#: zypp_desk/pages/scripts.py:49
msgid "it could not be moved to the trash"
msgstr "konnte nicht in den Papierkorb verschoben werden"

#: zypp_desk/pages/scripts.py:110
msgid "Its folder, with everything inside it"
msgstr "Sein Ordner, mit allem, was darin ist"

#: zypp_desk/pages/scripts.py:117 zypp_desk/pages/scripts.py:892
#, python-brace-format
msgid "{n} menu entry"
msgid_plural "{n} menu entries"
msgstr[0] "{n} Menüeintrag"
msgstr[1] "{n} Menüeinträge"

#: zypp_desk/pages/scripts.py:122
#, python-brace-format
msgid "{n} shortcut on the desktop"
msgid_plural "{n} shortcuts on the desktop"
msgstr[0] "{n} Verknüpfung auf der Arbeitsfläche"
msgstr[1] "{n} Verknüpfungen auf der Arbeitsfläche"

#: zypp_desk/pages/scripts.py:126
#, python-brace-format
msgid "{n} icon"
msgid_plural "{n} icons"
msgstr[0] "{n} Symbol"
msgstr[1] "{n} Symbole"

#: zypp_desk/pages/scripts.py:127
msgid "The pictures of its menu entries and of its files, in several sizes"
msgstr "Die Bilder seiner Menüeinträge und seiner Dateien, in mehreren Größen"

#: zypp_desk/pages/scripts.py:131
#, python-brace-format
msgid "{n} file type"
msgid_plural "{n} file types"
msgstr[0] "{n} Dateityp"
msgstr[1] "{n} Dateitypen"

#: zypp_desk/pages/scripts.py:132
msgid "What tells the computer which program opens its files"
msgstr "Was dem Computer sagt, welches Programm seine Dateien öffnet"

#: zypp_desk/pages/scripts.py:135
#, python-brace-format
msgid "{n} more thing it created"
msgid_plural "{n} more things it created"
msgstr[0] "{n} weiteres Element, das es angelegt hat"
msgstr[1] "{n} weitere Elemente, die es angelegt hat"

#: zypp_desk/pages/scripts.py:136
msgid "Zypp Desk noted it when it ran the installer"
msgstr "Zypp Desk hat es notiert, als es das Installationsprogramm ausgeführt hat"

#: zypp_desk/pages/scripts.py:173
#, python-brace-format
msgid "(and {n} more, the same way)"
msgid_plural "(and {n} more, the same way)"
msgstr[0] "(und {n} weiterer, auf dieselbe Weise)"
msgstr[1] "(und {n} weitere, auf dieselbe Weise)"

#: zypp_desk/pages/scripts.py:188
msgid "its own uninstaller runs as you, without the administrator password, in a terminal window where you can answer what it asks. When it ends, Zypp Desk looks again."
msgstr "Sein eigenes Deinstallationsprogramm läuft unter deinem Benutzerkonto, ohne das Administratorpasswort, in einem Terminalfenster, in dem du beantworten kannst, was es fragt. Wenn es fertig ist, sieht Zypp Desk noch einmal nach."

#: zypp_desk/pages/scripts.py:191
msgid "its own uninstaller runs as you, without the administrator password, in the terminal below. Nobody can type there: if it asks something, it gets no answer. When it ends, Zypp Desk looks again."
msgstr "Sein eigenes Deinstallationsprogramm läuft unter deinem Benutzerkonto, ohne das Administratorpasswort, im Terminal unten. Dort kann niemand etwas eingeben: Wenn es etwas fragt, bekommt es keine Antwort. Wenn es fertig ist, sieht Zypp Desk noch einmal nach."

#: zypp_desk/pages/scripts.py:194
#, python-brace-format
msgid "Run its uninstaller (in {folder}, as you):"
msgstr "Sein Deinstallationsprogramm ausführen (in {folder}, unter deinem Benutzerkonto):"

#: zypp_desk/pages/scripts.py:197
msgid "Move it to the trash instead:"
msgstr "Stattdessen in den Papierkorb verschieben:"

#: zypp_desk/pages/scripts.py:198
msgid "Move it to the trash instead"
msgstr "Stattdessen in den Papierkorb verschieben"

#: zypp_desk/pages/scripts.py:199
msgid "Run its uninstaller"
msgstr "Deinstallationsprogramm ausführen"

#: zypp_desk/pages/scripts.py:200
#, python-brace-format
msgid "Uninstall {name}?"
msgstr "{name} deinstallieren?"

#: zypp_desk/pages/scripts.py:208
msgid "Move it to the trash"
msgstr "In den Papierkorb verschieben"

#: zypp_desk/pages/scripts.py:210
#, python-brace-format
msgid "Clean up what is left of {name}?"
msgstr "Aufräumen, was von {name} übrig ist?"

#: zypp_desk/pages/scripts.py:211
msgid "Move what is left to the trash"
msgstr "Reste in den Papierkorb verschieben"

#: zypp_desk/pages/scripts.py:212
msgid "its program is not there any more. Zypp Desk moves what is left to the trash, as you, without the administrator password. You can bring it back from the trash."
msgstr "Sein Programm ist nicht mehr da. Zypp Desk verschiebt, was übrig ist, in den Papierkorb, unter deinem Benutzerkonto, ohne das Administratorpasswort. Du kannst es aus dem Papierkorb zurückholen."

#: zypp_desk/pages/scripts.py:215
#, python-brace-format
msgid "Move {name} to the trash?"
msgstr "{name} in den Papierkorb verschieben?"

#: zypp_desk/pages/scripts.py:216
msgid "it has no uninstaller of its own, so Zypp Desk moves it to the trash, as you, without the administrator password. Nothing is deleted for good: you can bring it all back from the trash. Files you made with it and saved elsewhere are not touched."
msgstr "Es hat kein eigenes Deinstallationsprogramm, daher verschiebt Zypp Desk es in den Papierkorb, unter deinem Benutzerkonto, ohne das Administratorpasswort. Nichts wird endgültig gelöscht: Du kannst alles aus dem Papierkorb zurückholen. Dateien, die du damit erstellt und anderswo gespeichert hast, bleiben unberührt."

#: zypp_desk/pages/scripts.py:230
#, python-brace-format
msgid "Only empty folders are left of {name}"
msgstr "Von {name} sind nur leere Ordner übrig"

#: zypp_desk/pages/scripts.py:232
#, python-brace-format
msgid "{name} is installed for the whole computer"
msgstr "{name} ist für den ganzen Computer installiert"

#: zypp_desk/pages/scripts.py:234
msgid "removing it needs the administrator password, and Zypp Desk does not run other programs' uninstallers as the administrator. If you are sure, run these commands in a terminal: sudo asks for the password, and the uninstaller may ask you things."
msgstr "Zum Entfernen braucht es das Administratorpasswort, und Zypp Desk führt die Deinstallationsprogramme anderer Programme nicht als Administrator aus. Wenn du dir sicher bist, führe diese Befehle in einem Terminal aus: sudo fragt nach dem Passwort, und das Deinstallationsprogramm fragt dich vielleicht etwas."

#: zypp_desk/pages/scripts.py:239
msgid "removing it needs the administrator password, and Zypp Desk does not delete other programs' folders as the administrator. If you are sure, run these commands in a terminal: sudo asks for the password."
msgstr "Zum Entfernen braucht es das Administratorpasswort, und Zypp Desk löscht die Ordner anderer Programme nicht als Administrator. Wenn du dir sicher bist, führe diese Befehle in einem Terminal aus: sudo fragt nach dem Passwort."

#: zypp_desk/pages/scripts.py:242
msgid "rm deletes for good: what the administrator deletes does not go to the trash. Look at the folder first."
msgstr "rm löscht endgültig: Was der Administrator löscht, kommt nicht in den Papierkorb. Sieh dir zuerst den Ordner an."

#: zypp_desk/pages/scripts.py:247
msgid "The commands to run in a terminal:"
msgstr "Die Befehle, die in einem Terminal auszuführen sind:"

#: zypp_desk/pages/scripts.py:249
msgid "Copy the commands"
msgstr "Befehle kopieren"

#: zypp_desk/pages/scripts.py:254
#, python-brace-format
msgid "In {folder}"
msgstr "In {folder}"

#: zypp_desk/pages/scripts.py:257
#, python-brace-format
msgid "inside there is {file}, its installer"
msgstr "darin ist {file}, sein Installationsprogramm"

#: zypp_desk/pages/scripts.py:260
msgid "the installer runs as you, without the administrator password, in a terminal window where you can answer what it asks. Zypp Desk notes what it creates (folders and menu entries) so that it can remove it later."
msgstr "Das Installationsprogramm läuft unter deinem Benutzerkonto, ohne das Administratorpasswort, in einem Terminalfenster, in dem du beantworten kannst, was es fragt. Zypp Desk notiert, was es anlegt (Ordner und Menüeinträge), damit es das später entfernen kann."

#: zypp_desk/pages/scripts.py:264
msgid "the installer runs as you, without the administrator password, in the terminal below. Nobody can type there: if it asks something, it gets no answer. Zypp Desk notes what it creates (folders and menu entries) so that it can remove it later."
msgstr "Das Installationsprogramm läuft unter deinem Benutzerkonto, ohne das Administratorpasswort, im Terminal unten. Dort kann niemand etwas eingeben: Wenn es etwas fragt, bekommt es keine Antwort. Zypp Desk notiert, was es anlegt (Ordner und Menüeinträge), damit es das später entfernen kann."

#: zypp_desk/pages/scripts.py:269
#, python-brace-format
msgid "Zypp Desk unpacks {file} into {folder}"
msgstr "Zypp Desk entpackt {file} nach {folder}"

#: zypp_desk/pages/scripts.py:271
#, python-brace-format
msgid "{command}   (in the unpacked folder, as you)"
msgstr "{command}   (im entpackten Ordner, unter deinem Benutzerkonto)"

#: zypp_desk/pages/scripts.py:273
#, python-brace-format
msgid "Zypp Desk copies {file} into {folder} and lets it run"
msgstr "Zypp Desk kopiert {file} nach {folder} und macht es ausführbar"

#: zypp_desk/pages/scripts.py:275
#, python-brace-format
msgid "{command}   (in that folder, as you)"
msgstr "{command}   (in diesem Ordner, unter deinem Benutzerkonto)"

#: zypp_desk/pages/scripts.py:277
#, python-brace-format
msgid "{command}   (in {folder}, as you)"
msgstr "{command}   (in {folder}, unter deinem Benutzerkonto)"

#: zypp_desk/pages/scripts.py:279
msgid "Run this installer?"
msgstr "Dieses Installationsprogramm ausführen?"

#: zypp_desk/pages/scripts.py:281
msgid "It is not signed: nobody confirms who made it. Run it only if you downloaded it from the program's own website."
msgstr "Es ist nicht signiert: Niemand bestätigt, wer es erstellt hat. Führe es nur aus, wenn du es von der eigenen Website des Programms heruntergeladen hast."

#: zypp_desk/pages/scripts.py:284
msgid "Run the installer"
msgstr "Installationsprogramm ausführen"

#: zypp_desk/pages/scripts.py:303
msgid "It has ended"
msgstr "Es ist fertig"

#: zypp_desk/pages/scripts.py:305
msgid "Zypp Desk waits for the terminal window to close. If it has already closed, or never opened, press here."
msgstr "Zypp Desk wartet, bis das Terminalfenster geschlossen wird. Wenn es schon zu ist oder sich nie geöffnet hat, drücke hier."

#: zypp_desk/pages/scripts.py:314
msgid "Own installers"
msgstr "Mit eigenem Installer"

#: zypp_desk/pages/scripts.py:337
msgid "Programs that are not RPM packages or Flatpaks: they install with their own installer (a .sh, a .run, a .tgz with install.pl). Zypp Desk cannot update them, but it tells you where they are and how much room they take, and it can remove them."
msgstr "Programme, die keine RPM-Pakete oder Flatpaks sind: Sie werden mit ihrem eigenen Installationsprogramm installiert (eine .sh, eine .run, eine .tgz mit install.pl). Zypp Desk kann sie nicht aktualisieren, zeigt dir aber, wo sie liegen und wie viel Platz sie belegen, und kann sie entfernen."

#: zypp_desk/pages/scripts.py:346 zypp_desk/pages/scripts.py:375
msgid "Looking for them…"
msgstr "Wird gesucht …"

#: zypp_desk/pages/scripts.py:355
msgid "Run an installer…"
msgstr "Installationsprogramm ausführen …"

#: zypp_desk/pages/scripts.py:356
msgid "Choose the installer of a program you downloaded (a .sh, a .run, or a .tgz or .zip with one inside). Zypp Desk asks first, then runs it at once, as you, in a terminal window (not through the queue), and notes what it creates."
msgstr "Wähle das Installationsprogramm eines heruntergeladenen Programms (eine .sh- oder .run-Datei oder ein .tgz oder .zip, das eines enthält). Zypp Desk fragt zuerst und führt es dann sofort unter deinem Benutzerkonto in einem Terminalfenster aus (nicht über die Warteschlange) und notiert, was es anlegt."

#: zypp_desk/pages/scripts.py:394
#, python-brace-format
msgid "Zypp Desk could not look for them: {error}"
msgstr "Zypp Desk konnte nicht danach suchen: {error}"

#: zypp_desk/pages/scripts.py:431
msgid "Left behind"
msgstr "Überreste"

#: zypp_desk/pages/scripts.py:434
msgid "Menu entries and folders of programs that are not there any more."
msgstr "Menüeinträge und Ordner von Programmen, die nicht mehr da sind."

#: zypp_desk/pages/scripts.py:445 zypp_desk/pages/scripts.py:448
msgid "Where"
msgstr "Ort"

#: zypp_desk/pages/scripts.py:445
#, python-brace-format
msgid "{folder} · in your folder, without the administrator password"
msgstr "{folder} · in deinem persönlichen Ordner, ohne Administratorpasswort"

#: zypp_desk/pages/scripts.py:448
#, python-brace-format
msgid "{folder} · for the whole computer: removing it needs the administrator password"
msgstr "{folder} · für den ganzen Computer: Zum Entfernen braucht es das Administratorpasswort"

#: zypp_desk/pages/scripts.py:454
#, python-brace-format
msgid "{n} entry ({names})"
msgid_plural "{n} entries ({names})"
msgstr[0] "{n} Eintrag ({names})"
msgstr[1] "{n} Einträge ({names})"

#: zypp_desk/pages/scripts.py:459
msgid "also on the desktop"
msgstr "auch auf der Arbeitsfläche"

#: zypp_desk/pages/scripts.py:463
#, python-brace-format
msgid "yes: {file}, from the program itself"
msgstr "ja: {file}, vom Programm selbst"

#: zypp_desk/pages/scripts.py:465
msgid "none: Zypp Desk can move it to the trash"
msgstr "keins: Zypp Desk kann es in den Papierkorb verschieben"

#: zypp_desk/pages/scripts.py:468
msgid "Uninstaller"
msgstr "Deinstallationsprogramm"

#: zypp_desk/pages/scripts.py:473
#, python-brace-format
msgid "by Zypp Desk on {date}, from {file}"
msgstr "von Zypp Desk am {date}, aus {file}"

#: zypp_desk/pages/scripts.py:515
msgid "Open its folder"
msgstr "Ordner öffnen"

#: zypp_desk/pages/scripts.py:517
#, python-brace-format
msgid "Show {folder} in the file manager"
msgstr "{folder} in der Dateiverwaltung anzeigen"

#: zypp_desk/pages/scripts.py:546
#, python-brace-format
msgid "Only empty folders are left in {folder}. It is for the whole computer: removing it needs the administrator password."
msgstr "In {folder} sind nur leere Ordner übrig. Es gilt für den ganzen Computer: Zum Entfernen braucht es das Administratorpasswort."

#: zypp_desk/pages/scripts.py:550
#, python-brace-format
msgid "Its program is not in {folder} any more: only its menu entry is left."
msgid_plural "Its program is not in {folder} any more: only its {n} menu entries are left."
msgstr[0] "Sein Programm ist nicht mehr in {folder}: Nur sein Menüeintrag ist übrig."
msgstr[1] "Sein Programm ist nicht mehr in {folder}: Nur seine {n} Menüeinträge sind übrig."

#: zypp_desk/pages/scripts.py:575
msgid "No other"
msgstr "Keine weiteren"

#: zypp_desk/pages/scripts.py:575
msgid "None found"
msgstr "Keine gefunden"

#: zypp_desk/pages/scripts.py:576
msgid "Zypp Desk looks in your folder, /opt and /usr/local, and at the menu entries that belong to no package."
msgstr "Zypp Desk sieht in deinem persönlichen Ordner, in /opt und /usr/local nach und bei den Menüeinträgen, die zu keinem Paket gehören."

#: zypp_desk/pages/scripts.py:610
msgid "Wait until the installer or uninstaller that is running now ends."
msgstr "Warte, bis das Installations- oder Deinstallationsprogramm, das gerade läuft, fertig ist."

#: zypp_desk/pages/scripts.py:619
msgid "How to remove it…"
msgstr "So entfernst du es …"

#: zypp_desk/pages/scripts.py:620
#, python-brace-format
msgid "{name} is installed for the whole computer: removing it needs the administrator password, which Zypp Desk does not use for this. It shows you the commands to run in a terminal."
msgstr "{name} ist für den ganzen Computer installiert: Zum Entfernen braucht es das Administratorpasswort, das Zypp Desk dafür nicht verwendet. Zypp Desk zeigt dir die Befehle, die du in einem Terminal ausführst."

#: zypp_desk/pages/scripts.py:623
msgid "Uninstall it…"
msgstr "Deinstallieren …"

#: zypp_desk/pages/scripts.py:624
#, python-brace-format
msgid "Runs the uninstaller of {name} ({file}) at once, as you, in a terminal window, after a question. It does not go through the queue. The question also offers to move it to the trash instead."
msgstr "Führt nach einer Frage sofort das Deinstallationsprogramm von {name} ({file}) unter deinem Benutzerkonto in einem Terminalfenster aus. Es geht nicht über die Warteschlange. Die Frage bietet auch an, es stattdessen in den Papierkorb zu verschieben."

#: zypp_desk/pages/scripts.py:628
msgid "Move what is left to the trash…"
msgstr "Reste in den Papierkorb verschieben …"

#: zypp_desk/pages/scripts.py:629
#, python-brace-format
msgid "Moves the menu entries and icons left by {name} to the trash at once, as you, after a question (not through the queue). You can bring them back from the trash."
msgstr "Verschiebt nach einer Frage die Menüeinträge und Symbole, die {name} hinterlassen hat, sofort unter deinem Benutzerkonto in den Papierkorb (nicht über die Warteschlange). Du kannst sie aus dem Papierkorb zurückholen."

#: zypp_desk/pages/scripts.py:631
msgid "Move it to the trash…"
msgstr "In den Papierkorb verschieben …"

#: zypp_desk/pages/scripts.py:632
#, python-brace-format
msgid "{name} has no uninstaller of its own: Zypp Desk moves its folder, menu entries and icons to the trash at once, as you, after a question (not through the queue). You can bring them back from the trash."
msgstr "{name} hat kein eigenes Deinstallationsprogramm: Zypp Desk verschiebt nach einer Frage seinen Ordner, seine Menüeinträge und Symbole sofort unter deinem Benutzerkonto in den Papierkorb (nicht über die Warteschlange). Du kannst sie aus dem Papierkorb zurückholen."

#: zypp_desk/pages/scripts.py:643
msgid "The commands are copied: paste them in a terminal."
msgstr "Die Befehle sind kopiert: Füge sie in ein Terminal ein."

#: zypp_desk/pages/scripts.py:659
#, python-brace-format
msgid "Zypp Desk found nothing of {name} in your folder that it can move to the trash."
msgstr "Zypp Desk hat in deinem persönlichen Ordner nichts von {name} gefunden, das es in den Papierkorb verschieben kann."

#: zypp_desk/pages/scripts.py:667
#, python-brace-format
msgid "Moving {name} to the trash…"
msgstr "{name} wird in den Papierkorb verschoben …"

#: zypp_desk/pages/scripts.py:677
#, python-brace-format
msgid "{name}: {n} thing moved to the trash."
msgid_plural "{name}: {n} things moved to the trash."
msgstr[0] "{name}: {n} Element in den Papierkorb verschoben."
msgstr[1] "{name}: {n} Elemente in den Papierkorb verschoben."

#: zypp_desk/pages/scripts.py:680
msgid "These could not be moved to the trash:"
msgstr "Diese konnten nicht in den Papierkorb verschoben werden:"

#: zypp_desk/pages/scripts.py:691
msgid "Choose the installer"
msgstr "Installationsprogramm auswählen"

#: zypp_desk/pages/scripts.py:692
#, python-brace-format
msgid "Installers ({patterns})"
msgstr "Installationsprogramme ({patterns})"

#: zypp_desk/pages/scripts.py:700
#, python-brace-format
msgid "Looking inside {file}…"
msgstr "{file} wird untersucht …"

#: zypp_desk/pages/scripts.py:709 zypp_desk/pages/scripts.py:713
#: zypp_desk/pages/scripts.py:718 zypp_desk/pages/scripts.py:734
msgid "Run an installer"
msgstr "Installationsprogramm ausführen"

#: zypp_desk/pages/scripts.py:709
#, python-brace-format
msgid "{file} could not be read: {error}"
msgstr "{file} konnte nicht gelesen werden: {error}"

#: zypp_desk/pages/scripts.py:714
#, python-brace-format
msgid "Zypp Desk found no installer in {file}. It looks for install.sh, install.pl, setup.sh, or a .run or .bin file."
msgstr "Zypp Desk hat in {file} kein Installationsprogramm gefunden. Es sucht nach install.sh, install.pl, setup.sh oder einer .run- oder .bin-Datei."

#: zypp_desk/pages/scripts.py:718
#, python-brace-format
msgid "Zypp Desk does not know how to run {file}."
msgstr "Zypp Desk weiß nicht, wie {file} ausgeführt wird."

#: zypp_desk/pages/scripts.py:726
msgid "Preparing the installer…"
msgstr "Installationsprogramm wird vorbereitet …"

#: zypp_desk/pages/scripts.py:734
#, python-brace-format
msgid "The installer could not be prepared: {error}"
msgstr "Das Installationsprogramm konnte nicht vorbereitet werden: {error}"

#: zypp_desk/pages/scripts.py:744
msgid "It has ended."
msgstr "Fertig."

#: zypp_desk/pages/scripts.py:745
msgid "It has ended with an error, code"
msgstr "Mit einem Fehler beendet, Code"

#: zypp_desk/pages/scripts.py:746
msgid "Press Enter to close this window."
msgstr "Drücke die Eingabetaste, um dieses Fenster zu schließen."

#: zypp_desk/pages/scripts.py:757
#, python-brace-format
msgid "The terminal window could not be opened: {error}"
msgstr "Das Terminalfenster konnte nicht geöffnet werden: {error}"

#: zypp_desk/pages/scripts.py:767
#, python-brace-format
msgid "Installer of {name}"
msgstr "Installationsprogramm von {name}"

#: zypp_desk/pages/scripts.py:767
#, python-brace-format
msgid "Uninstaller of {name}"
msgstr "Deinstallationsprogramm von {name}"

#: zypp_desk/pages/scripts.py:812
#, python-brace-format
msgid "The installer {file} is running in its own window. Answer its questions there; when it ends, Zypp Desk notes what it created."
msgstr "Das Installationsprogramm {file} läuft in einem eigenen Fenster. Beantworte seine Fragen dort; wenn es fertig ist, notiert Zypp Desk, was es angelegt hat."

#: zypp_desk/pages/scripts.py:815
#, python-brace-format
msgid "The uninstaller of {name} is running in its own window. When it ends, Zypp Desk looks again."
msgstr "Das Deinstallationsprogramm von {name} läuft in einem eigenen Fenster. Wenn es fertig ist, sieht Zypp Desk noch einmal nach."

#: zypp_desk/pages/scripts.py:818
msgid "If its window has already closed, press “It has ended”."
msgstr "Wenn sein Fenster schon geschlossen ist, drücke auf „Es ist fertig“."

#: zypp_desk/pages/scripts.py:857
#, python-brace-format
msgid "The window of the uninstaller of {name} closed before it ended."
msgstr "Das Fenster des Deinstallationsprogramms von {name} wurde geschlossen, bevor es fertig war."

#: zypp_desk/pages/scripts.py:859
#, python-brace-format
msgid "The uninstaller of {name} ended with an error (code {code})."
msgstr "Das Deinstallationsprogramm von {name} wurde mit einem Fehler beendet (Code {code})."

#: zypp_desk/pages/scripts.py:862
#, python-brace-format
msgid "The uninstaller of {name} has ended."
msgstr "Das Deinstallationsprogramm von {name} ist fertig."

#: zypp_desk/pages/scripts.py:877
#, python-brace-format
msgid "What the installer created could not be noted: {error}"
msgstr "Was das Installationsprogramm angelegt hat, konnte nicht notiert werden: {error}"

#: zypp_desk/pages/scripts.py:886
msgid "The installer's window closed before it ended."
msgstr "Das Fenster des Installationsprogramms wurde geschlossen, bevor es fertig war."

#: zypp_desk/pages/scripts.py:888
#, python-brace-format
msgid "The installer ended with an error (code {code})."
msgstr "Das Installationsprogramm wurde mit einem Fehler beendet (Code {code})."

#: zypp_desk/pages/scripts.py:890
msgid "The installer has ended."
msgstr "Das Installationsprogramm ist fertig."

#: zypp_desk/pages/scripts.py:895
#, python-brace-format
msgid "Zypp Desk noted {n} thing it created ({what}): it can remove it later."
msgid_plural "Zypp Desk noted {n} things it created ({what}): it can remove them later."
msgstr[0] "Zypp Desk hat {n} angelegtes Element notiert ({what}): Es kann es später entfernen."
msgstr[1] "Zypp Desk hat {n} angelegte Elemente notiert ({what}): Es kann sie später entfernen."

#: zypp_desk/pages/scripts.py:899
msgid "Nothing new appeared in your folder, the menu or /opt."
msgstr "In deinem persönlichen Ordner, im Menü und in /opt ist nichts Neues aufgetaucht."

#: zypp_desk/pages/system.py:31
msgid "Clean the useless locks?"
msgstr "Unnötige Sperren entfernen?"

#: zypp_desk/pages/system.py:31
msgid "Yes, clean them"
msgstr "Ja, entfernen"

#: zypp_desk/pages/system.py:33
msgid "Remove the locks that match no package"
msgstr "Sperren entfernen, die zu keinem Paket passen"

#: zypp_desk/pages/system.py:34
msgid "Neither an installed package nor one in your repositories."
msgstr "Weder zu einem installierten Paket noch zu einem aus deinen Paketquellen."

#: zypp_desk/pages/system.py:35
msgid "nothing changes in what zypper may install or update now. A lock for a package that is only missing for a while (its repository is disabled) goes too."
msgstr "An dem, was zypper jetzt installieren oder aktualisieren darf, ändert sich nichts. Auch eine Sperre für ein Paket, das nur vorübergehend fehlt (seine Paketquelle ist deaktiviert), wird entfernt."

#: zypp_desk/pages/system.py:60
msgid "A service is a list of repositories kept up to date by its provider (openSUSE's own repositories come from one)."
msgstr "Ein Dienst ist eine Liste von Paketquellen, die ihr Anbieter aktuell hält (die Paketquellen von openSUSE selbst kommen aus einem Dienst)."

#: zypp_desk/pages/system.py:67
msgid "Refresh the services"
msgstr "Dienste neu laden"

#: zypp_desk/pages/system.py:68
msgid "Refresh services"
msgstr "Dienste neu laden"

#: zypp_desk/pages/system.py:70
msgid "Asks every service for its list of repositories again, now. It asks for the administrator password."
msgstr "Fragt jetzt jeden Dienst erneut nach seiner Liste von Paketquellen. Dafür wird das Administratorpasswort abgefragt."

#: zypp_desk/pages/system.py:72 zypp_desk/pages/system.py:84
msgid "Enable or disable…"
msgstr "Aktivieren oder deaktivieren …"

#: zypp_desk/pages/system.py:86
msgid "Choose a service in the list first."
msgstr "Wähle zuerst einen Dienst in der Liste."

#: zypp_desk/pages/system.py:88
msgid "the service"
msgstr "Dienst"

#: zypp_desk/pages/system.py:89
#, python-brace-format
msgid "Disable {name}…"
msgstr "{name} deaktivieren …"

#: zypp_desk/pages/system.py:89
#, python-brace-format
msgid "Enable {name}…"
msgstr "{name} aktivieren …"

#: zypp_desk/pages/system.py:92
msgid "Asks first, then changes it now (with its repositories)."
msgstr "Fragt zuerst und ändert ihn dann sofort (mit seinen Paketquellen)."

#: zypp_desk/pages/system.py:129 zypp_desk/pages/system.py:149
#: zypp_desk/pages/system.py:156
msgid "Change a service"
msgstr "Dienst ändern"

#: zypp_desk/pages/system.py:138
msgid "A service is a list of repositories its provider keeps up to date."
msgstr "Ein Dienst ist eine Liste von Paketquellen, die sein Anbieter aktuell hält."

#: zypp_desk/pages/system.py:140
#, python-brace-format
msgid "Its repository is disabled with it."
msgid_plural "Its {n} repositories are disabled with it."
msgstr[0] "Seine Paketquelle wird mit ihm deaktiviert."
msgstr[1] "Seine {n} Paketquellen werden mit ihm deaktiviert."

#: zypp_desk/pages/system.py:144
msgid "you get no programs or updates from its repositories until you enable it again."
msgstr "Du bekommst keine Programme oder Aktualisierungen aus seinen Paketquellen, bis du ihn wieder aktivierst."

#: zypp_desk/pages/system.py:146
msgid "It is normally left enabled."
msgstr "Normalerweise bleibt er aktiviert."

#: zypp_desk/pages/system.py:148
#, python-brace-format
msgid "Disable the service “{name}”?"
msgstr "Dienst „{name}“ deaktivieren?"

#: zypp_desk/pages/system.py:148
msgid "Yes, disable it"
msgstr "Ja, deaktivieren"

#: zypp_desk/pages/system.py:150
#, python-brace-format
msgctxt "change"
msgid "Stop using the service “{name}”"
msgstr "Dienst „{name}“ nicht mehr benutzen"

#: zypp_desk/pages/system.py:152
msgid "Without this service, Tumbleweed is not updated."
msgstr "Ohne diesen Dienst wird Tumbleweed nicht aktualisiert."

#: zypp_desk/pages/system.py:155
#, python-brace-format
msgid "Enable the service “{name}”?"
msgstr "Dienst „{name}“ aktivieren?"

#: zypp_desk/pages/system.py:155
msgid "Yes, enable it"
msgstr "Ja, aktivieren"

#: zypp_desk/pages/system.py:157
#, python-brace-format
msgctxt "change"
msgid "Use the service “{name}” again"
msgstr "Dienst „{name}“ wieder benutzen"

#: zypp_desk/pages/system.py:158
msgid "Its repositories are enabled again as they were before."
msgstr "Seine Paketquellen werden wieder so aktiviert, wie sie vorher waren."

#: zypp_desk/pages/system.py:159
msgid "zypper refreshes the service and looks for programs and updates in its repositories again."
msgstr "zypper lädt den Dienst neu und sucht wieder in seinen Paketquellen nach Programmen und Aktualisierungen."

#: zypp_desk/pages/system.py:165
msgid "Check dependencies"
msgstr "Abhängigkeiten prüfen"

#: zypp_desk/pages/system.py:166
msgid "Looks for installed packages whose dependencies are broken and proposes how to fix them."
msgstr "Sucht installierte Pakete mit defekten Abhängigkeiten und schlägt vor, wie man sie repariert."

#: zypp_desk/pages/system.py:168
msgid "Install new recommended packages"
msgstr "Neue empfohlene Pakete installieren"

#: zypp_desk/pages/system.py:169
msgid "Installs packages recommended by what you have, added since it was installed."
msgstr "Installiert Pakete, die deine installierten Pakete empfehlen und die seit deren Installation dazugekommen sind."

#: zypp_desk/pages/system.py:171 zypp_desk/routine.py:143
msgid "Remove old kernels"
msgstr "Alte Kernel entfernen"

#: zypp_desk/pages/system.py:172
msgid "Keeps the kernels set in zypp.conf (multiversion.kernels; on Tumbleweed /usr/etc/zypp/zypp.conf and /etc/zypp/zypp.conf.d) and removes the rest."
msgstr "Behält die in zypp.conf festgelegten Kernel (multiversion.kernels; auf Tumbleweed /usr/etc/zypp/zypp.conf und /etc/zypp/zypp.conf.d) und entfernt die übrigen."

#: zypp_desk/pages/system.py:176
msgid "Deletes downloaded packages and cached metadata. They are downloaded again when needed."
msgstr "Löscht heruntergeladene Pakete und zwischengespeicherte Metadaten. Sie werden bei Bedarf erneut heruntergeladen."

#: zypp_desk/pages/system.py:179
msgid "Removes locks that no longer match any package."
msgstr "Entfernt Sperren, die zu keinem Paket mehr passen."

#: zypp_desk/pages/system.py:180
msgid "Programs using deleted files"
msgstr "Programme, die gelöschte Dateien benutzen"

#: zypp_desk/pages/system.py:181
msgid "Programs that still use libraries replaced by an update and should be restarted."
msgstr "Programme, die noch durch eine Aktualisierung ersetzte Bibliotheken benutzen und neu gestartet werden sollten."

#: zypp_desk/pages/system.py:182
msgid "Is a restart needed?"
msgstr "Ist ein Neustart nötig?"

#: zypp_desk/pages/system.py:183
msgid "Asks zypper whether an update requires restarting the computer."
msgstr "Fragt zypper, ob eine Aktualisierung einen Neustart des Computers erfordert."

#: zypp_desk/pages/system.py:184
msgid "Licenses report"
msgstr "Lizenzbericht"

#: zypp_desk/pages/system.py:185
msgid "Lists the licenses of the installed packages."
msgstr "Listet die Lizenzen der installierten Pakete auf."

#: zypp_desk/pages/system.py:192
msgid "Simulate the check"
msgstr "Prüfung simulieren"

#: zypp_desk/pages/system.py:193
msgid "Asks first. If something is missing or in conflict, zypper installs or removes packages to fix it."
msgstr "Fragt zuerst. Wenn etwas fehlt oder sich etwas widerspricht, installiert oder entfernt zypper Pakete, um es zu reparieren."

#: zypp_desk/pages/system.py:194
msgid "Install the new recommended…"
msgstr "Neue empfohlene Pakete installieren …"

#: zypp_desk/pages/system.py:194
msgid "Simulate installing them"
msgstr "Installation simulieren"

#: zypp_desk/pages/system.py:195
msgid "Asks first, then installs what your programs started to recommend after you installed them."
msgstr "Fragt zuerst und installiert dann, was deine Programme erst nach ihrer Installation zu empfehlen begonnen haben."

#: zypp_desk/pages/system.py:196
msgid "Remove the old kernels…"
msgstr "Alte Kernel entfernen …"

#: zypp_desk/pages/system.py:196
msgid "Simulate removing old kernels"
msgstr "Entfernen alter Kernel simulieren"

#: zypp_desk/pages/system.py:197
msgid "Shows which kernels stay and which go, and asks first."
msgstr "Zeigt, welche Kernel bleiben und welche gehen, und fragt zuerst."

#: zypp_desk/pages/system.py:199
msgid "Shows how much room it frees, and asks first. Nothing installed changes."
msgstr "Zeigt, wie viel Platz frei wird, und fragt zuerst. An der Installation ändert sich nichts."

#: zypp_desk/pages/system.py:201
msgid "Asks first, then removes the locks that match no package."
msgstr "Fragt zuerst und entfernt dann die Sperren, die zu keinem Paket passen."

#: zypp_desk/pages/system.py:202
msgid "Find the programs to restart"
msgstr "Neu zu startende Programme suchen"

#: zypp_desk/pages/system.py:203
msgid "Lists them in the terminal, now. Nothing changes."
msgstr "Listet sie jetzt im Terminal auf. Nichts ändert sich."

#: zypp_desk/pages/system.py:204
msgid "Ask if a restart is needed"
msgstr "Fragen, ob ein Neustart nötig ist"

#: zypp_desk/pages/system.py:205
msgid "zypper answers in the terminal, now. Nothing changes."
msgstr "zypper antwortet jetzt im Terminal. Nichts ändert sich."

#: zypp_desk/pages/system.py:206
msgid "List the licenses"
msgstr "Lizenzen auflisten"

#: zypp_desk/pages/system.py:207
msgid "Lists the licenses of the installed packages in the terminal, now. Nothing changes."
msgstr "Listet jetzt im Terminal die Lizenzen der installierten Pakete auf. Nichts ändert sich."

#: zypp_desk/pages/system.py:312
msgid "Zypp Desk looks at the software of this computer and tells you what is worth a look, from the most to the least important."
msgstr "Zypp Desk sieht sich die Software dieses Computers an und sagt dir, was einen Blick wert ist, vom Wichtigsten bis zum am wenigsten Wichtigen."

#: zypp_desk/pages/system.py:320
msgid "Maintenance tasks"
msgstr "Wartungsaufgaben"

#: zypp_desk/pages/system.py:336
msgid "Shows in the terminal what it would do, without changing anything. It asks for the administrator password."
msgstr "Zeigt im Terminal, was es tun würde, ohne etwas zu ändern. Dafür wird das Administratorpasswort abgefragt."

#: zypp_desk/pages/system.py:384
msgid "Check and fix the dependencies?"
msgstr "Abhängigkeiten prüfen und reparieren?"

#: zypp_desk/pages/system.py:384
msgid "Yes, check them"
msgstr "Ja, prüfen"

#: zypp_desk/pages/system.py:385
msgid "Check that every installed package has what it needs"
msgstr "Prüfen, ob jedes installierte Paket alles hat, was es braucht"

#: zypp_desk/pages/system.py:386
msgid "If something is missing or in conflict, zypper installs or removes packages to fix it, without asking again."
msgstr "Wenn etwas fehlt oder sich etwas widerspricht, installiert oder entfernt zypper Pakete, um es zu reparieren, ohne noch einmal zu fragen."

#: zypp_desk/pages/system.py:388
msgid "most of the time there is nothing to fix. “Simulate the check” shows first what it would change."
msgstr "Meistens gibt es nichts zu reparieren. „Prüfung simulieren“ zeigt vorher, was es ändern würde."

#: zypp_desk/pages/system.py:391
msgid "Install the new recommended packages?"
msgstr "Neue empfohlene Pakete installieren?"

#: zypp_desk/pages/system.py:391
msgid "Yes, install them"
msgstr "Ja, installieren"

#: zypp_desk/pages/system.py:394
msgid "Install what your programs recommend now"
msgstr "Installieren, was deine Programme jetzt empfehlen"

#: zypp_desk/pages/system.py:395
msgid "Only what they started to recommend after you installed them: translations, plugins…"
msgstr "Nur das, was sie erst nach ihrer Installation zu empfehlen begonnen haben: Übersetzungen, Plugins …"

#: zypp_desk/pages/system.py:397
msgid "“Simulate installing them” shows first which packages and how much space they take."
msgstr "„Installation simulieren“ zeigt vorher, welche Pakete es sind und wie viel Platz sie brauchen."

#: zypp_desk/pages/system.py:406
msgid "Remove the old kernels?"
msgstr "Alte Kernel entfernen?"

#: zypp_desk/pages/system.py:407
msgid "the computer starts the same. The boot menu will have fewer versions to choose from."
msgstr "Der Computer startet wie bisher. Im Bootmenü stehen weniger Versionen zur Auswahl."

#: zypp_desk/pages/system.py:411
msgid "Remove the old Linux kernels"
msgstr "Alte Linux-Kernel entfernen"

#: zypp_desk/pages/system.py:412
#, python-brace-format
msgid "The ones zypp.conf does not keep: {rule}."
msgstr "Die, die zypp.conf nicht behält: {rule}."

#: zypp_desk/pages/system.py:413
msgid "The ones zypp.conf does not keep (multiversion.kernels)."
msgstr "Die, die zypp.conf nicht behält (multiversion.kernels)."

#: zypp_desk/pages/system.py:416
#, python-brace-format
msgid "{version} (in use)"
msgstr "{version} (läuft gerade)"

#: zypp_desk/pages/system.py:421
msgid "No old kernel to remove"
msgstr "Kein alter Kernel zu entfernen"

#: zypp_desk/pages/system.py:421 zypp_desk/pages/system.py:422
msgid "Run it anyway"
msgstr "Trotzdem ausführen"

#: zypp_desk/pages/system.py:423
#, python-brace-format
msgid "zypp.conf keeps your kernel"
msgid_plural "zypp.conf keeps all your {n} kernels"
msgstr[0] "zypp.conf behält deinen Kernel"
msgstr[1] "zypp.conf behält alle deine {n} Kernel"

#: zypp_desk/pages/system.py:425
msgid "nothing needs to be done. If you run it anyway, it only cleans up what is left of kernels that are gone, and it asks for the administrator password."
msgstr "Es muss nichts getan werden. Wenn du es trotzdem ausführst, räumt es nur auf, was von entfernten Kerneln übrig ist, und fragt nach dem Administratorpasswort."

#: zypp_desk/pages/system.py:427
#, python-brace-format
msgid "Remove {n} old Linux kernel"
msgid_plural "Remove {n} old Linux kernels"
msgstr[0] "{n} alten Linux-Kernel entfernen"
msgstr[1] "{n} alte Linux-Kernel entfernen"

#: zypp_desk/pages/system.py:429
#, python-brace-format
msgid "These stay: {list}."
msgstr "Diese bleiben: {list}."

#: zypp_desk/pages/system.py:432
msgid "No space comes back yet"
msgstr "Noch wird kein Platz frei"

#: zypp_desk/pages/system.py:433
#, python-brace-format
msgid "The snapshots of the system keep the old kernels' files. About {size} comes back when the snapshots from before this change are deleted: snapper deletes old ones by itself, or you can in History."
msgstr "Die Snapshots des Systems behalten die Dateien der alten Kernel. Etwa {size} werden frei, wenn die Snapshots von vor dieser Änderung gelöscht werden: snapper löscht alte selbst, oder du löschst sie unter Verlauf."

#: zypp_desk/pages/system.py:437 zypp_desk/pages/system.py:678
#, python-brace-format
msgid "Free about {size}"
msgstr "Etwa {size} freigeben"

#: zypp_desk/pages/system.py:438
msgid "On the system partition."
msgstr "Auf der Systempartition."

#: zypp_desk/pages/system.py:447 zypp_desk/pages/system.py:458
msgid "Check the computer again"
msgstr "Computer erneut prüfen"

#: zypp_desk/pages/system.py:448
msgid "Look at the computer again: what was installed, removed or changed since. Nothing changes."
msgstr "Den Computer noch einmal untersuchen: was seitdem installiert, entfernt oder geändert wurde. Nichts ändert sich."

#: zypp_desk/pages/system.py:474
msgid "Looking at the computer…"
msgstr "Der Computer wird untersucht …"

#: zypp_desk/pages/system.py:475
msgid "It takes a few seconds: packages, repositories, keys, firmware and Flatpak apps."
msgstr "Das dauert ein paar Sekunden: Pakete, Paketquellen, Schlüssel, Firmware und Flatpak-Apps."

#: zypp_desk/pages/system.py:488
msgid "Zypp Desk could not look at the computer"
msgstr "Zypp Desk konnte den Computer nicht untersuchen"

#: zypp_desk/pages/system.py:499
#, python-brace-format
msgid "Nothing to look at in: {checks}"
msgstr "Alles in Ordnung: {checks}"

#: zypp_desk/pages/system.py:501
msgid "Checked just now."
msgstr "Gerade eben geprüft."

#: zypp_desk/pages/system.py:504
#, python-brace-format
msgid "Could not check: {checks}"
msgstr "Konnte nicht geprüft werden: {checks}"

#: zypp_desk/pages/system.py:505
msgid "Check again later; if it keeps failing, the details say why."
msgstr "Prüfe später noch einmal; wenn es weiter fehlschlägt, steht in den Details, warum."

#: zypp_desk/pages/system.py:513
msgid "What takes most room"
msgstr "Was am meisten Platz belegt"

#: zypp_desk/pages/system.py:523
msgid "▸ Show all"
msgstr "▸ Alle anzeigen"

#: zypp_desk/pages/system.py:523
msgid "▾ Show less"
msgstr "▾ Weniger anzeigen"

#: zypp_desk/pages/system.py:591
msgid "Opens Drivers: under “Not needed for this computer”, the firmware no device here uses, to put in the queue for removal."
msgstr "Öffnet Treiber: Unter „Für diesen Computer nicht nötig“ steht die Firmware, die hier kein Gerät benutzt, damit du ihr Entfernen in die Warteschlange stellst."

#: zypp_desk/pages/system.py:593
msgid "Asks first, then puts the firmware this computer does not use in the queue."
msgstr "Fragt zuerst und stellt dann das Entfernen der Firmware, die dieser Computer nicht benutzt, in die Warteschlange."

#: zypp_desk/pages/system.py:595
#, python-brace-format
msgid "Opens Applications, searched for {name}."
msgstr "Öffnet Anwendungen mit der Suche nach {name}."

#: zypp_desk/pages/system.py:598
msgid "Shows which packages can go back to their repository's vendor, and asks before putting them in the queue."
msgstr "Zeigt, welche Pakete zum Anbieter ihrer Paketquelle zurückkehren können, und fragt, bevor sie in die Warteschlange kommen."

#: zypp_desk/pages/system.py:601
msgid "Opens Repositories, where each repository says how its signatures are checked."
msgstr "Öffnet Paketquellen, wo jede Paketquelle angibt, wie ihre Signaturen geprüft werden."

#: zypp_desk/pages/system.py:603
msgid "Opens Signing keys, where each key says which repositories use it."
msgstr "Öffnet Signaturschlüssel, wo jeder Schlüssel angibt, welche Paketquellen ihn benutzen."

#: zypp_desk/pages/system.py:605
msgid "Opens Packages with the packages that no repository has (zypper packages --orphaned)."
msgstr "Öffnet Pakete mit den Paketen, die keine Paketquelle hat (zypper packages --orphaned)."

#: zypp_desk/pages/system.py:648
msgid "Your repositories only have older versions of them: leave them as they are for now."
msgstr "Deine Paketquellen haben nur ältere Versionen davon: Lass sie vorerst, wie sie sind."

#: zypp_desk/pages/system.py:649
msgid "Packages from another vendor"
msgstr "Pakete von einem anderen Anbieter"

#: zypp_desk/pages/system.py:651
msgid "Nothing to switch"
msgstr "Nichts zu wechseln"

#: zypp_desk/pages/system.py:667
msgid "Delete the downloaded packages"
msgstr "Heruntergeladene Pakete löschen"

#: zypp_desk/pages/system.py:668
msgid "The packages zypper keeps: those of repositories set to keep them, and those downloaded ahead for the next update."
msgstr "Die Pakete, die zypper aufbewahrt: die aus Paketquellen, die sie aufbewahren sollen, und die für die nächste Aktualisierung vorab heruntergeladenen."

#: zypp_desk/pages/system.py:670
msgid "Delete the lists of packages of every repository"
msgstr "Paketlisten aller Paketquellen löschen"

#: zypp_desk/pages/system.py:671
msgid "zypper downloads them again the next time it refreshes."
msgstr "zypper lädt sie beim nächsten Neuladen erneut herunter."

#: zypp_desk/pages/system.py:675
#, python-brace-format
msgid "Downloaded packages: {size}."
msgstr "Heruntergeladene Pakete: {size}."

#: zypp_desk/pages/system.py:677
#, python-brace-format
msgid "Repositories' information: {size}."
msgstr "Informationen der Paketquellen: {size}."

#: zypp_desk/pages/system.py:680
msgid "Clean the cache?"
msgstr "Zwischenspeicher leeren?"

#: zypp_desk/pages/system.py:680
msgid "Yes, clean it"
msgstr "Ja, leeren"

#: zypp_desk/pages/system.py:682
msgid "nothing installed changes. The next refresh downloads every repository's information again, which takes a while."
msgstr "Nichts Installiertes ändert sich. Das nächste Neuladen lädt die Informationen aller Paketquellen erneut herunter, was eine Weile dauert."

#: zypp_desk/pages/system.py:754
#, python-brace-format
msgid "xdg-mime ended with exit code {code}."
msgstr "xdg-mime wurde mit dem Exit-Code {code} beendet."

#: zypp_desk/pages/system.py:763 zypp_desk/pages/system.py:792
msgid ".rpm files"
msgstr ".rpm-Dateien"

#: zypp_desk/pages/system.py:764
msgid "Looking which program opens them…"
msgstr "Es wird nachgesehen, welches Programm sie öffnet …"

#: zypp_desk/pages/system.py:768
msgid "Open .rpm files with Zypp Desk"
msgstr ".rpm-Dateien mit Zypp Desk öffnen"

#: zypp_desk/pages/system.py:769
msgid "Makes Zypp Desk the program that opens .rpm files, for your user only, now."
msgstr "Macht Zypp Desk jetzt zum Programm, das .rpm-Dateien öffnet, nur für dein Benutzerkonto."

#: zypp_desk/pages/system.py:792
#, python-brace-format
msgid "The default could not be changed: {error}"
msgstr "Das Standardprogramm konnte nicht geändert werden: {error}"

#: zypp_desk/pages/system.py:799
#, python-brace-format
msgid "Could not find out which program opens them: {error}"
msgstr "Es konnte nicht festgestellt werden, welches Programm sie öffnet: {error}"

#: zypp_desk/pages/system.py:803
msgid "xdg-mime (the xdg-utils package) is not installed, so the program that opens them cannot be chosen from here."
msgstr "xdg-mime (Paket xdg-utils) ist nicht installiert, daher kann das Programm, das sie öffnet, nicht von hier aus gewählt werden."

#: zypp_desk/pages/system.py:808
msgid "A double click on an .rpm file opens it with Zypp Desk: it shows what is inside and can install it."
msgstr "Ein Doppelklick auf eine .rpm-Datei öffnet sie mit Zypp Desk: Es zeigt, was darin ist, und kann sie installieren."

#: zypp_desk/pages/system.py:811
#, python-brace-format
msgid "A double click on an .rpm file opens it with {program}. With Zypp Desk, you see what is inside, who signed it, and you can install it."
msgstr "Ein Doppelklick auf eine .rpm-Datei öffnet sie mit {program}. Mit Zypp Desk siehst du, was darin ist und wer sie signiert hat, und kannst sie installieren."

#: zypp_desk/pages/system.py:814
msgid "No program is chosen to open .rpm files. With Zypp Desk, you see what is inside, who signed it, and you can install it."
msgstr "Es ist kein Programm zum Öffnen von .rpm-Dateien gewählt. Mit Zypp Desk siehst du, was darin ist und wer sie signiert hat, und kannst sie installieren."

#: zypp_desk/pages/system.py:817
msgid "Zypp Desk's menu entry is not installed (install.sh or the zypp-desk package adds it), so it cannot be chosen yet."
msgstr "Der Menüeintrag von Zypp Desk ist nicht installiert (install.sh oder das Paket zypp-desk fügt ihn hinzu), daher kann Zypp Desk noch nicht gewählt werden."

#: zypp_desk/pages/system.py:846
msgid "Recommended packages add optional parts (plugins, codecs, translations). Ticked, the queue installs only what is needed: --no-recommends."
msgstr "Empfohlene Pakete fügen optionale Teile hinzu (Plugins, Codecs, Übersetzungen). Mit Häkchen installiert die Warteschlange nur, was nötig ist: --no-recommends."

#: zypp_desk/pages/system.py:848
msgid "Accept licenses without asking"
msgstr "Lizenzen ohne Rückfrage akzeptieren"

#: zypp_desk/pages/system.py:850
msgid "Changes are applied without questions (-n), after you have seen the simulation. If a license must be accepted and this option is off, zypper stops and nothing is installed."
msgstr "Änderungen werden ohne Rückfragen angewendet (-n), nachdem du die Simulation gesehen hast. Muss eine Lizenz akzeptiert werden und ist diese Option aus, hält zypper an und es wird nichts installiert."

#: zypp_desk/pages/system.py:853
msgid "When applying the queue"
msgstr "Beim Anwenden der Warteschlange"

#: zypp_desk/pages/system.py:869 zypp_desk/pages/system.py:882
#: zypp_desk/terminal.py:293
msgid "Terminal"
msgstr "Terminal"

#: zypp_desk/pages/system.py:883
msgid "Fold a line repeated many times in a row into one"
msgstr "Eine mehrfach hintereinander wiederholte Zeile zu einer zusammenfassen"

#: zypp_desk/pages/system.py:885
msgid "After the routine, check what must be restarted (zypper ps)"
msgstr "Nach der Routine prüfen, was neu gestartet werden muss (zypper ps)"

#: zypp_desk/pages/system.py:908
msgid "Save in a file the repositories, programs and settings of this computer. On the other computer, open the file with Zypp Desk: everything goes to the queue, for you to look at before applying it. The file has no passwords or documents."
msgstr "Speichere die Paketquellen, Programme und Einstellungen dieses Computers in einer Datei. Öffne die Datei auf dem anderen Computer mit Zypp Desk: Alles kommt in die Warteschlange, damit du es dir ansiehst, bevor du es anwendest. Die Datei enthält weder Passwörter noch Dokumente."

#: zypp_desk/pages/system.py:913
msgid "Opens a window to choose what goes in the file and where to save it. Nothing changes on this computer."
msgstr "Öffnet ein Fenster, in dem du wählst, was in die Datei kommt und wo sie gespeichert wird. Auf diesem Computer ändert sich nichts."

#: zypp_desk/pages/system.py:917
msgid "Choose a file saved on another computer: Zypp Desk shows what it has, and what you choose goes to the queue."
msgstr "Wähle eine Datei, die auf einem anderen Computer gespeichert wurde: Zypp Desk zeigt, was sie enthält, und was du auswählst, kommt in die Warteschlange."

#: zypp_desk/pages/system.py:1017
msgid "▸ Details"
msgstr "▸ Details"

#: zypp_desk/pages/system.py:1017
msgid "▾ Hide the details"
msgstr "▾ Details ausblenden"

#: zypp_desk/pages/system.py:1048
#, python-brace-format
msgid "Remove {n} firmware package"
msgid_plural "Remove {n} firmware packages"
msgstr[0] "{n} Firmware-Paket entfernen"
msgstr[1] "{n} Firmware-Pakete entfernen"

#: zypp_desk/pages/system.py:1049
#, python-brace-format
msgid "No device of this computer uses them. Frees about {size}."
msgstr "Kein Gerät dieses Computers verwendet sie. Gibt etwa {size} frei."

#: zypp_desk/pages/system.py:1054
msgid "The kernel recommends it: without the lock, the next kernel update would install it again, and all the firmware with it. The lock appears in Locks, where you can remove it."
msgstr "Der Kernel empfiehlt es: Ohne die Sperre würde die nächste Kernel-Aktualisierung es wieder installieren, und mit ihm die ganze Firmware. Die Sperre erscheint unter Paketsperren, wo du sie entfernen kannst."

#: zypp_desk/pages/system.py:1058
#, python-brace-format
msgid "Keep {n} firmware package"
msgid_plural "Keep {n} firmware packages"
msgstr[0] "{n} Firmware-Paket behalten"
msgstr[1] "{n} Firmware-Pakete behalten"

#: zypp_desk/pages/system.py:1059
msgid "What the devices of this computer use, and what a dock or an adapter may need."
msgstr "Was die Geräte dieses Computers verwenden und was ein Dock oder ein Adapter brauchen könnte."

#: zypp_desk/pages/system.py:1063
msgid "Zypp Desk could not tell which repository has kernel-firmware-all, so it is not locked: the next kernel update may install all the firmware again. Lock it in Locks after applying."
msgstr "Zypp Desk konnte nicht feststellen, welche Paketquelle kernel-firmware-all hat, daher ist es nicht gesperrt: Die nächste Kernel-Aktualisierung kann die ganze Firmware wieder installieren. Sperre es nach dem Anwenden unter Paketsperren."

#: zypp_desk/pages/system.py:1065
msgid "Keep only the firmware this computer needs?"
msgstr "Nur die Firmware behalten, die dieser Computer braucht?"

#: zypp_desk/pages/system.py:1066 zypp_desk/pages/updates.py:1415
#: zypp_desk/pages/updates.py:1663 zypp_desk/tray.py:883
msgid "Firmware"
msgstr "Firmware"

#: zypp_desk/pages/system.py:1067
msgid "Nothing changes yet: the queue shows the exact zypper commands, and Simulate shows what they would do."
msgstr "Noch ändert sich nichts: Die Warteschlange zeigt die genauen zypper-Befehle, und „Simulieren“ zeigt, was sie tun würden."

#: zypp_desk/pages/system.py:1070
msgid "the devices of this computer keep working. A device you plug in later may need firmware that is gone: each firmware package says which devices it is for, so “Install new recommended packages” (zypper inr) puts the right one back once the device is plugged in."
msgstr "Die Geräte dieses Computers funktionieren weiter. Ein Gerät, das du später anschließt, braucht vielleicht Firmware, die nicht mehr da ist: Jedes Firmware-Paket gibt an, für welche Geräte es ist, daher holt „Neue empfohlene Pakete installieren“ (zypper inr) das richtige zurück, sobald das Gerät angeschlossen ist."

#: zypp_desk/pages/system.py:1091
#, python-brace-format
msgid "Install {n} package again from its repository"
msgid_plural "Install {n} packages again from their repositories"
msgstr[0] "{n} Paket erneut aus seiner Paketquelle installieren"
msgstr[1] "{n} Pakete erneut aus ihren Paketquellen installieren"

#: zypp_desk/pages/system.py:1093
#, python-brace-format
msgid "From {repos}. From then on zypper updates it from there."
msgid_plural "From {repos}. From then on zypper updates them from there."
msgstr[0] "Aus {repos}. Ab dann aktualisiert zypper es von dort."
msgstr[1] "Aus {repos}. Ab dann aktualisiert zypper sie von dort."

#: zypp_desk/pages/system.py:1099
#, python-brace-format
msgid "Leave {n} package as it is"
msgid_plural "Leave {n} packages as they are"
msgstr[0] "{n} Paket so lassen, wie es ist"
msgstr[1] "{n} Pakete so lassen, wie sie sind"

#: zypp_desk/pages/system.py:1101
msgid "Your repositories only have older versions of them."
msgstr "Deine Paketquellen haben nur ältere Versionen davon."

#: zypp_desk/pages/system.py:1102
msgid "Switch these packages to their repository's vendor?"
msgstr "Diese Pakete zum Anbieter ihrer Paketquelle wechseln?"

#: zypp_desk/pages/system.py:1104
msgid "Nothing changes yet: Simulate shows what else would change with them."
msgstr "Noch ändert sich nichts: „Simulieren“ zeigt, was sich mit ihnen sonst noch ändern würde."

#: zypp_desk/pages/system.py:1105
msgid "the programs stay; only the place their updates come from changes. The version of the repository may be built differently (with other codecs, for example)."
msgstr "Die Programme bleiben; nur der Ort, von dem ihre Aktualisierungen kommen, ändert sich. Die Version der Paketquelle kann anders gebaut sein (zum Beispiel mit anderen Codecs)."

#: zypp_desk/pages/updates.py:167
msgid "the Linux kernel"
msgstr "der Linux-Kernel"

#: zypp_desk/pages/updates.py:185
msgid "At the end you will need to restart: there is a new Linux kernel."
msgstr "Am Ende musst du neu starten: Es gibt einen neuen Linux-Kernel."

#: zypp_desk/pages/updates.py:186
msgid "At the end a restart may be needed."
msgstr "Am Ende ist vielleicht ein Neustart nötig."

#: zypp_desk/pages/updates.py:207 zypp_desk/pages/updates.py:257
#, python-brace-format
msgid "Among them {names}."
msgstr "Darunter {names}."

#: zypp_desk/pages/updates.py:209
#, python-brace-format
msgid "{names} and {n} more."
msgid_plural "{names} and {n} more."
msgstr[0] "{names} und {n} weiteres."
msgstr[1] "{names} und {n} weitere."

#: zypp_desk/pages/updates.py:213
#, python-brace-format
msgid "Update {n} program"
msgid_plural "Update {n} programs"
msgstr[0] "{n} Programm aktualisieren"
msgstr[1] "{n} Programme aktualisieren"

#: zypp_desk/pages/updates.py:216
#, python-brace-format
msgid "Install {n} new package"
msgid_plural "Install {n} new packages"
msgstr[0] "{n} neues Paket installieren"
msgstr[1] "{n} neue Pakete installieren"

#: zypp_desk/pages/updates.py:217
msgid "The update brings them in."
msgstr "Die Aktualisierung bringt sie mit."

#: zypp_desk/pages/updates.py:218
#, python-brace-format
msgid "Remove {n} old package"
msgid_plural "Remove {n} old packages"
msgstr[0] "{n} altes Paket entfernen"
msgstr[1] "{n} alte Pakete entfernen"

#: zypp_desk/pages/updates.py:219
msgid "The update takes them out, usually because newer ones replace them."
msgstr "Die Aktualisierung entfernt sie, meist weil neuere sie ersetzen."

#: zypp_desk/pages/updates.py:220
#, python-brace-format
msgid "Go back to an older version of {n} package"
msgid_plural "Go back to an older version of {n} packages"
msgstr[0] "{n} Paket auf eine ältere Version zurücksetzen"
msgstr[1] "{n} Pakete auf eine ältere Version zurücksetzen"

#: zypp_desk/pages/updates.py:222
msgid "A repository only has an older version of them."
msgstr "Eine Paketquelle hat nur eine ältere Version davon."

#: zypp_desk/pages/updates.py:223
#, python-brace-format
msgid "Change where {n} package comes from"
msgid_plural "Change where {n} packages come from"
msgstr[0] "Herkunft von {n} Paket ändern"
msgstr[1] "Herkunft von {n} Paketen ändern"

#: zypp_desk/pages/updates.py:225
msgid "They move to another vendor, for example from openSUSE to Packman."
