#, python-brace-format
msgid "Keep {pkg} as it is"
msgstr "{pkg} unverändert lassen"

#: zypp_desk/simulation.py:377
#, python-brace-format
msgid "Do not update {name}"
msgstr "{name} nicht aktualisieren"

#: zypp_desk/simulation.py:378
#, python-brace-format
msgid "The rest goes ahead. {name} stays at version {version} and is locked: it will not change until you unlock it."
msgstr "Der Rest wird ausgeführt. {name} bleibt bei Version {version} und wird gesperrt: Es ändert sich nicht, bis du es entsperrst."

#: zypp_desk/simulation.py:380
#, python-brace-format
msgid "The rest goes ahead. {name} stays as it is and is locked: it will not change until you unlock it."
msgstr "Der Rest wird ausgeführt. {name} bleibt, wie es ist, und wird gesperrt: Es ändert sich nicht, bis du es entsperrst."

#: zypp_desk/simulation.py:386
#, python-brace-format
msgid "Do not install {name}"
msgstr "{name} nicht installieren"

#: zypp_desk/simulation.py:387
#, python-brace-format
msgid "{name} leaves the queue; the rest goes ahead."
msgstr "{name} kommt aus der Warteschlange; der Rest wird ausgeführt."

#: zypp_desk/simulation.py:389
#, python-brace-format
msgid "{name} is locked, so the upgrade leaves it out: it will not be installed or changed until you unlock it."
msgstr "{name} wird gesperrt, daher lässt die Aktualisierung es aus: Es wird nicht installiert oder geändert, bis du es entsperrst."

#: zypp_desk/simulation.py:394
#, python-brace-format
msgid "Do not remove {name}"
msgstr "{name} nicht entfernen"

#: zypp_desk/simulation.py:395
#, python-brace-format
msgid "{name} stays installed and its removal leaves the queue; the rest goes ahead."
msgstr "{name} bleibt installiert, und sein Entfernen kommt aus der Warteschlange; der Rest wird ausgeführt."

#: zypp_desk/simulation.py:397
#, python-brace-format
msgid "{name} stays installed and is locked, so the upgrade cannot remove it until you unlock it."
msgstr "{name} bleibt installiert und wird gesperrt, daher kann die Aktualisierung es nicht entfernen, bis du es entsperrst."

#: zypp_desk/simulation.py:402
#, python-brace-format
msgid "{name} is locked. Without the lock, zypper can remove it."
msgstr "{name} ist gesperrt. Ohne die Sperre kann zypper es entfernen."

#: zypp_desk/simulation.py:403
#, python-brace-format
msgid "{name} is locked. Without the lock, zypper can install it."
msgstr "{name} ist gesperrt. Ohne die Sperre kann zypper es installieren."

#: zypp_desk/simulation.py:404 zypp_desk/txqueue.py:67
#, python-brace-format
msgid "Unlock {name}"
msgstr "{name} entsperren"

#: zypp_desk/simulation.py:408
#, python-brace-format
msgid "Go back to {pkg}"
msgstr "Zurück zu {pkg}"

#: zypp_desk/simulation.py:409
#, python-brace-format
msgid "{name} goes back from version {old} to the older {new}, so that everything fits."
msgstr "{name} geht von Version {old} auf die ältere {new} zurück, damit alles zusammenpasst."

