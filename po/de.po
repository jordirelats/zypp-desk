msgstr "Code"

#: zypp_desk/pages/system.py:145
msgid "Language"
msgstr "Sprache"

#: zypp_desk/pages/system.py:147
msgid "Requested languages make zypper install the translation packages (-lang) of the programs you have."
msgstr "Für die gewählten Sprachen installiert zypper die Übersetzungspakete (-lang) deiner Programme."

#: zypp_desk/pages/system.py:167
