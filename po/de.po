#: zypp_desk/mainwindow.py:228
msgid "Review"
msgstr "Überprüfen"

#: zypp_desk/mainwindow.py:229 zypp_desk/terminal.py:300
msgid "Clear"
msgstr "Leeren"

#: zypp_desk/mainwindow.py:230 zypp_desk/mainwindow.py:455
#: zypp_desk/pages/localrpm.py:299 zypp_desk/pages/removedlg.py:83
#: zypp_desk/pages/system.py:270 zypp_desk/pages/updates.py:791
msgid "Simulate"
msgstr "Simulieren"

#: zypp_desk/mainwindow.py:231 zypp_desk/mainwindow.py:528
#: zypp_desk/mainwindow.py:546 zypp_desk/mainwindow.py:549
#: zypp_desk/simulation.py:814
msgid "Apply"
msgstr "Anwenden"

#: zypp_desk/mainwindow.py:272
msgid "zypper's own output appears here while it works."
msgstr "Hier erscheint die Ausgabe von zypper, während es arbeitet."

#: zypp_desk/mainwindow.py:325 zypp_desk/pages/repos.py:1125
#, python-brace-format
msgid "This part is not available: {error}"
msgstr "Dieser Teil ist nicht verfügbar: {error}"

#: zypp_desk/mainwindow.py:359 zypp_desk/pages/updates.py:346
#: zypp_desk/pages/updates.py:717 zypp_desk/pages/updates.py:871
msgid "Wait until the current command finishes."
msgstr "Warte, bis der laufende Befehl fertig ist."

#: zypp_desk/mainwindow.py:404
msgid "Finished."
msgstr "Fertig."

#: zypp_desk/mainwindow.py:406
msgid "Stopped as you asked: the steps after it did not run."
msgstr "Wie gewünscht angehalten: Die Schritte danach wurden nicht ausgeführt."

#: zypp_desk/mainwindow.py:408
msgid "Finished with errors."
msgstr "Mit Fehlern beendet."

#: zypp_desk/mainwindow.py:422
msgid "Working…"
msgstr "Wird ausgeführt …"

#: zypp_desk/mainwindow.py:430
msgid "empty"
msgstr "leer"

#: zypp_desk/mainwindow.py:432
msgid "Nothing to do yet: choose packages, locks or repository changes."
msgstr "Noch nichts zu tun: Wähle Pakete, Sperren oder Änderungen an Paketquellen."

#: zypp_desk/mainwindow.py:452
#, python-brace-format
msgid "Not simulated, because their repository is only added when the queue is applied: {list}"
msgstr "Nicht simuliert, weil ihre Paketquelle erst beim Anwenden der Warteschlange hinzugefügt wird: {list}"

#: zypp_desk/mainwindow.py:455
msgid "Changes to repositories, locks, languages and Flatpak apps cannot be simulated. These commands will run:"
msgstr "Änderungen an Paketquellen, Sperren, Sprachen und Flatpak-Apps können nicht simuliert werden. Diese Befehle werden ausgeführt:"

#: zypp_desk/mainwindow.py:458
msgid "Simulation of the queue"
msgstr "Simulation der Warteschlange"

#: zypp_desk/mainwindow.py:466 zypp_desk/simulation.py:137
#: zypp_desk/simulation.py:704
#, python-brace-format
msgid "Problem: {text}"
msgstr "Problem: {text}"

#: zypp_desk/mainwindow.py:468
msgid "A lock or an unlock you choose runs at once (a simulation only knows the locks that exist); the rest goes to the queue."
msgstr "Eine Sperre oder Entsperrung, die du wählst, wird sofort ausgeführt (eine Simulation kennt nur die bestehenden Sperren); der Rest kommt in die Warteschlange."

#: zypp_desk/mainwindow.py:503
msgid "These commands run now, before simulating again:"
msgstr "Diese Befehle werden jetzt ausgeführt, bevor erneut simuliert wird:"

#: zypp_desk/mainwindow.py:505
msgid "A package written as !name is removed only if nothing installed still needs it. If something does, zypper stops and changes nothing."
msgstr "Ein als !name geschriebenes Paket wird nur entfernt, wenn nichts Installiertes es noch braucht. Andernfalls hält zypper an und ändert nichts."

#: zypp_desk/mainwindow.py:509
msgid "You can unlock it later in Locks."
msgid_plural "You can unlock them later in Locks."
msgstr[0] "Du kannst es später unter Paketsperren wieder entsperren."
msgstr[1] "Du kannst sie später unter Paketsperren wieder entsperren."

#: zypp_desk/mainwindow.py:511 zypp_desk/mainwindow.py:513
