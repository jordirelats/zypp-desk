msgstr[1] "et {n} autres"

#: zypp_desk/pages/history.py:1001
#, python-brace-format
msgid "This program of the change is installed there, so it keeps its new files while rpm will say that the old version is installed: {list}. Reinstall it afterwards, so that its files match."
msgid_plural "These programs of the change are installed there, so they keep their new files while rpm will say that the old versions are installed: {list}. Reinstall them afterwards, so that their files match."
msgstr[0] "Ce programme de la modification y est installé ; il garde donc ses nouveaux fichiers, tandis que rpm indiquera que l'ancienne version est installée : {list}. Réinstallez-le ensuite, pour que ses fichiers correspondent."
msgstr[1] "Ces programmes de la modification y sont installés ; ils gardent donc leurs nouveaux fichiers, tandis que rpm indiquera que les anciennes versions sont installées : {list}. Réinstallez-les ensuite, pour que leurs fichiers correspondent."

#: zypp_desk/pages/history.py:1006
msgid "Your own files in /home are not touched. Restarting the computer afterwards is recommended."
msgstr "Vos propres fichiers dans /home ne sont pas touchés. Il est recommandé de redémarrer l'ordinateur ensuite."

