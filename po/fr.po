#: zypp_desk/pages/updates.py:220
#, python-brace-format
msgid "Go back to an older version of {n} package"
msgid_plural "Go back to an older version of {n} packages"
msgstr[0] "Ramener {n} paquet à une version antérieure"
msgstr[1] "Ramener {n} paquets à une version antérieure"

#: zypp_desk/pages/updates.py:222
msgid "A repository only has an older version of them."
msgstr "Un dépôt n'en a qu'une version antérieure."

#: zypp_desk/pages/updates.py:223
#, python-brace-format
msgid "Change where {n} package comes from"
msgid_plural "Change where {n} packages come from"
msgstr[0] "Changer la provenance de {n} paquet"
msgstr[1] "Changer la provenance de {n} paquets"

#: zypp_desk/pages/updates.py:225
msgid "They move to another vendor, for example from openSUSE to Packman."
msgstr "Ils passent à un autre fournisseur, par exemple d'openSUSE à Packman."

#: zypp_desk/pages/updates.py:226
#, python-brace-format
msgid "Change the architecture of {n} package"
msgid_plural "Change the architecture of {n} packages"
msgstr[0] "Changer l'architecture de {n} paquet"
msgstr[1] "Changer l'architecture de {n} paquets"

#: zypp_desk/pages/updates.py:228
#, python-brace-format
msgid "Reinstall {n} package"
msgid_plural "Reinstall {n} packages"
msgstr[0] "Réinstaller {n} paquet"
msgstr[1] "Réinstaller {n} paquets"

#: zypp_desk/pages/updates.py:248
#, python-brace-format
msgid "{n} new package"
msgid_plural "{n} new packages"
msgstr[0] "{n} nouveau paquet"
msgstr[1] "{n} nouveaux paquets"

#: zypp_desk/pages/updates.py:250
#, python-brace-format
msgid "{n} package to remove"
msgid_plural "{n} packages to remove"
msgstr[0] "{n} paquet à supprimer"
msgstr[1] "{n} paquets à supprimer"

#: zypp_desk/pages/updates.py:253 zypp_desk/txqueue.py:1075
#, python-brace-format
msgid "{n} other change"
msgid_plural "{n} other changes"
msgstr[0] "{n} autre modification"
msgstr[1] "{n} autres modifications"

#: zypp_desk/pages/updates.py:264
msgid "Everything it needs is already downloaded."
msgstr "Tout ce dont elle a besoin est déjà téléchargé."

#: zypp_desk/pages/updates.py:264
msgid "Nothing to download"
msgstr "Rien à télécharger"

#: zypp_desk/pages/updates.py:265
#, python-brace-format
msgid "Download {size}"
msgstr "Télécharger {size}"

#: zypp_desk/pages/updates.py:266 zypp_desk/txqueue.py:434
