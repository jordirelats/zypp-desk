msgstr "Supprimer {name}"

#: zypp_desk/txqueue.py:206
#, python-brace-format
msgctxt "change"
msgid "Add the language {language}"
msgstr "Ajouter la langue {language}"

#: zypp_desk/txqueue.py:207
msgid "zypper installs the translations of your programs into it."
msgstr "zypper installe les traductions de vos programmes dans cette langue."

#: zypp_desk/txqueue.py:209
#, python-brace-format
msgctxt "change"
msgid "Remove the language {language}"
msgstr "Supprimer la langue {language}"

#: zypp_desk/txqueue.py:210
msgid "The translations into it are removed."
msgstr "Les traductions dans cette langue sont supprimées."

#: zypp_desk/txqueue.py:212
#, python-brace-format
msgctxt "change"
msgid "Install the Flatpak app {app}"
msgstr "Installer l'application Flatpak {app}"

#: zypp_desk/txqueue.py:213
#, python-brace-format
msgid "From {remote}, {installation}."
msgstr "Depuis {remote}, {installation}."

#: zypp_desk/txqueue.py:216
#, python-brace-format
msgctxt "change"
msgid "Uninstall the Flatpak app {app}"
msgstr "Désinstaller l'application Flatpak {app}"

#: zypp_desk/txqueue.py:217
msgid "Its data in your home folder is deleted too."
msgstr "Ses données dans votre dossier personnel sont aussi supprimées."

#: zypp_desk/txqueue.py:218
msgid "Its data stays in your home folder."
msgstr "Ses données restent dans votre dossier personnel."

#: zypp_desk/txqueue.py:221
msgctxt "change"
msgid "Update every Flatpak app"
msgstr "Mettre à jour toutes les applications Flatpak"

#: zypp_desk/txqueue.py:222
msgid "And the runtimes they use."
msgstr "Et les environnements d'exécution qu'elles utilisent."

#: zypp_desk/txqueue.py:223
#, python-brace-format
msgctxt "change"
msgid "Update the Flatpak app {app}"
msgstr "Mettre à jour l'application Flatpak {app}"

#: zypp_desk/txqueue.py:224
msgid "And the runtime it uses, if it needs a new one."
msgstr ""
"Et l'environnement d'exécution qu'elle utilise, si elle en a besoin d'un "
"nouveau."

#: zypp_desk/txqueue.py:226
#, python-brace-format
msgctxt "change"
msgid "Update the firmware of {name} to {version}"
msgstr "Mettre à jour le micrologiciel du périphérique {name} vers {version}"

#: zypp_desk/txqueue.py:228
msgid "Keep the computer plugged in. It may need a restart to finish."
msgstr ""
"Laissez l'ordinateur branché. Un redémarrage peut être nécessaire pour "
"terminer."

#: zypp_desk/txqueue.py:235
#, python-brace-format
msgctxt "change"
msgid "Install the bridge package for {program}"
msgstr "Installer le paquet passerelle pour {program}"

#: zypp_desk/txqueue.py:236
#, python-brace-format
msgid ""
"Made by Zypp Desk on this computer: it tells zypper that what {program} asks "
"for by its Fedora names is here. It is not signed, because it was made here."
msgstr ""
"Créé par Zypp Desk sur cet ordinateur : il indique à zypper que ce que "
"{program} demande sous ses noms Fedora est bien là. Il n'est pas signé, "
"puisqu'il a été créé ici."

#: zypp_desk/txqueue.py:241
#, python-brace-format
msgid "The file {file}."
msgstr "Le fichier {file}."

#: zypp_desk/txqueue.py:243
msgid "It is not signed: you accepted it as it is."
msgstr "Il n'est pas signé : vous l'avez accepté tel quel."

#: zypp_desk/txqueue.py:245
msgid "It is older than the one you have."
msgstr "Il est plus ancien que celui que vous avez."

#: zypp_desk/txqueue.py:247
#, python-brace-format
msgctxt "change"
msgid "Install {name} from a downloaded file"
msgstr "Installer {name} depuis un fichier téléchargé"

#: zypp_desk/txqueue.py:253
#, python-brace-format
msgctxt "change"
msgid "Install the pattern {name}"
msgstr "Installer le modèle {name}"

#: zypp_desk/txqueue.py:254
msgid "A group of packages that go together."
msgstr "Un groupe de paquets qui vont ensemble."

#: zypp_desk/txqueue.py:263
#, python-brace-format
msgctxt "change"
msgid "Install {name} {version}"
msgstr "Installer {name} {version}"

#: zypp_desk/txqueue.py:264
msgid "This exact version, older than the one you have."
msgstr "Cette version précise, plus ancienne que celle que vous avez."

#: zypp_desk/txqueue.py:265
msgid "This exact version."
msgstr "Cette version précise."

#: zypp_desk/txqueue.py:269
#, python-brace-format
msgctxt "change"
msgid "Update {name}"
msgstr "Mettre à jour {name}"

#: zypp_desk/txqueue.py:270
msgid "To the newest version from the same vendor."
msgstr "Vers la version la plus récente du même fournisseur."

#: zypp_desk/txqueue.py:274
msgid "From your repositories: zypper picks the best version."
msgstr "Depuis vos dépôts : zypper choisit la meilleure version."

#: zypp_desk/txqueue.py:276
#, python-brace-format
msgid "From the repository “{repo}”."
msgstr "Depuis le dépôt « {repo} »."

#: zypp_desk/txqueue.py:292 zypp_desk/txqueue.py:311
msgid "zypper looks for programs and updates there again."
msgstr ""
"zypper cherche de nouveau des programmes et des mises à jour à cet endroit."

#: zypp_desk/txqueue.py:293
#, python-brace-format
msgctxt "change"
msgid "Disable the repository “{name}”"
msgstr "Désactiver le dépôt « {name} »"

#: zypp_desk/txqueue.py:294 zypp_desk/txqueue.py:312
msgid ""
"zypper stops looking for programs and updates there until you enable it "
"again. What you installed from it stays installed."
msgstr ""
"zypper ne cherche plus de programmes ni de mises à jour à cet endroit tant "
"que vous ne l'aurez pas réactivé. Ce que vous en avez installé reste "
"installé."

#: zypp_desk/txqueue.py:297
#, python-brace-format
msgctxt "change"
msgid "Change the priority of the repository “{name}”"
msgstr "Changer la priorité du dépôt « {name} »"

#: zypp_desk/txqueue.py:299
#, python-brace-format
msgctxt "change"
msgid "Rename the repository “{name}”"
msgstr "Renommer le dépôt « {name} »"

#: zypp_desk/txqueue.py:301
#, python-brace-format
msgctxt "change"
msgid "Change the repository “{name}”"
msgstr "Modifier le dépôt « {name} »"

#: zypp_desk/txqueue.py:307
#, python-brace-format
msgid "Priority {n}: the lower the number, the more zypper prefers it."
msgstr "Priorité {n} : plus le nombre est petit, plus zypper le préfère."

#: zypp_desk/txqueue.py:309
#, python-brace-format
msgid "New name: {name}."
msgstr "Nouveau nom : {name}."

#: zypp_desk/txqueue.py:315
msgid "zypper refreshes it on its own before it looks for updates."
msgstr "zypper l'actualise de lui-même avant de chercher des mises à jour."

#: zypp_desk/txqueue.py:316
msgid "zypper no longer refreshes it on its own."
msgstr "zypper ne l'actualise plus de lui-même."

#: zypp_desk/txqueue.py:318
msgid "The packages downloaded from it are kept."
msgstr "Les paquets téléchargés depuis ce dépôt sont conservés."

#: zypp_desk/txqueue.py:319
msgid "The packages downloaded from it are no longer kept."
msgstr "Les paquets téléchargés depuis ce dépôt ne sont plus conservés."

#: zypp_desk/txqueue.py:332
msgid "Also what only it needed. Programs that need it go too."
msgid_plural "Also what only they needed. Programs that need them go too."
msgstr[0] ""
"Ainsi que ce dont seul ce paquet avait besoin. Les programmes qui en ont "
"besoin sont aussi supprimés."
msgstr[1] ""
"Ainsi que ce dont seuls ces paquets avaient besoin. Les programmes qui en "
"ont besoin sont aussi supprimés."

#: zypp_desk/txqueue.py:335
msgid ""
"Only if nothing installed still needs it: otherwise zypper stops and changes "
"nothing."
msgid_plural ""
"Only if nothing installed still needs them: otherwise zypper stops and "
"changes nothing."
msgstr[0] ""
"Seulement si plus rien d'installé n'en a besoin : sinon, zypper s'arrête et "
"ne change rien."
msgstr[1] ""
"Seulement si plus rien d'installé n'en a besoin : sinon, zypper s'arrête et "
"ne change rien."

#: zypp_desk/txqueue.py:337
msgid "Programs that need it are removed with it."
msgid_plural "Programs that need them are removed with them."
msgstr[0] "Les programmes qui en ont besoin sont supprimés avec lui."
msgstr[1] "Les programmes qui en ont besoin sont supprimés avec eux."

#. TRANSLATORS: a change in a list (the Apply question, the queue): ca uses the infinitive here
#: zypp_desk/txqueue.py:428
#, python-brace-format
msgid "Update {n} package"
msgid_plural "Update {n} packages"
msgstr[0] "Mettre à jour {n} paquet"
msgstr[1] "Mettre à jour {n} paquets"

#: zypp_desk/txqueue.py:429
msgid "Each one to the newest version from the same vendor."
msgstr "Chacun vers la version la plus récente du même fournisseur."

#. TRANSLATORS: a change in a list (the Apply question, the queue): ca uses the infinitive here
#: zypp_desk/txqueue.py:439
#, python-brace-format
msgid "Remove {n} package"
msgid_plural "Remove {n} packages"
msgstr[0] "Supprimer {n} paquet"
msgstr[1] "Supprimer {n} paquets"

#. TRANSLATORS: a change in a list (the Apply question, the queue): ca uses the infinitive here
#: zypp_desk/txqueue.py:447
#, python-brace-format
msgid "Lock {n} package"
msgid_plural "Lock {n} packages"
msgstr[0] "Verrouiller {n} paquet"
msgstr[1] "Verrouiller {n} paquets"

#: zypp_desk/txqueue.py:448
msgid "zypper will not install, update or remove them until you unlock them."
msgstr ""
"zypper ne les installera pas, ne les mettra pas à jour et ne les supprimera "
"pas tant que vous ne les aurez pas déverrouillés."

#. TRANSLATORS: a change in a list (the Apply question, the queue): ca uses the infinitive here
#: zypp_desk/txqueue.py:452
#, python-brace-format
msgid "Unlock {n} package"
msgid_plural "Unlock {n} packages"
msgstr[0] "Déverrouiller {n} paquet"
msgstr[1] "Déverrouiller {n} paquets"

#: zypp_desk/txqueue.py:453
msgid "zypper may install, update or remove them again."
msgstr ""
"zypper pourra de nouveau les installer, les mettre à jour ou les supprimer."

#: zypp_desk/txqueue.py:458
msgid "New packages signed with them are refused until you trust them again."
msgstr ""
"Les nouveaux paquets signés avec ces clés seront refusés jusqu'à ce que vous "
"leur fassiez de nouveau confiance."

#. TRANSLATORS: a change in a list (the Apply question, the queue): ca uses the infinitive here
#: zypp_desk/txqueue.py:461
#, python-brace-format
msgid "Update {n} Flatpak app"
msgid_plural "Update {n} Flatpak apps"
msgstr[0] "Mettre à jour {n} application Flatpak"
msgstr[1] "Mettre à jour {n} applications Flatpak"

#: zypp_desk/txqueue.py:462
msgid "And the runtimes they use, if they need new ones."
msgstr ""
"Et les environnements d'exécution qu'elles utilisent, si elles en ont besoin "
"de nouveaux."

#: zypp_desk/txqueue.py:743
#, python-brace-format
msgid ""
"{name} is protected, so it is not removed. To remove it, first choose “Stop "
"protecting {name}” on its card in Applications."
msgstr ""
"{name} est une application protégée : elle n'est donc pas supprimée. Pour la "
"supprimer, choisissez d'abord « Ne plus protéger {name} » sur sa carte dans "
"Applications."

#: zypp_desk/txqueue.py:1071
#, python-brace-format
msgid "{n} to remove"
msgid_plural "{n} to remove"
msgstr[0] "{n} à supprimer"
msgstr[1] "{n} à supprimer"

#: zypp_desk/txqueue.py:1073
#, python-brace-format
msgid "{n} Flatpak change"
msgid_plural "{n} Flatpak changes"
msgstr[0] "{n} modification Flatpak"
msgstr[1] "{n} modifications Flatpak"

#: zypp_desk/websources.py:155
msgid "The server sent the download to an address that is not https."
msgstr ""
"Le serveur a redirigé le téléchargement vers une adresse qui n'est pas en "
"https."

#: zypp_desk/websources.py:216
#, python-brace-format
msgid ""
"GitHub answers only 60 questions an hour without an account: try again in "
"{n} minute."
msgid_plural ""
"GitHub answers only 60 questions an hour without an account: try again in "
"{n} minutes."
msgstr[0] ""
"Sans compte, GitHub ne répond qu'à 60 requêtes par heure : réessayez dans "
"{n} minute."
msgstr[1] ""
"Sans compte, GitHub ne répond qu'à 60 requêtes par heure : réessayez dans "
"{n} minutes."

#: zypp_desk/websources.py:275
msgid "The page is too big."
msgstr "La page est trop volumineuse."

#: zypp_desk/websources.py:313
#, python-brace-format
msgid "No link on the page matches {pattern}."
msgstr "Aucun lien de la page ne correspond à {pattern}."

#: zypp_desk/websources.py:349
#, python-brace-format
msgid "Unknown kind of source: {kind}"
msgstr "Type de source inconnu : {kind}"

#: zypp_desk/websources.py:412
#, python-brace-format
msgid ""
"The file contains the package “{found}”, not “{expected}”. It was deleted."
msgstr ""
"Le fichier contient le paquet « {found} », pas « {expected} ». Il a été "
"supprimé."

#: zypp_desk/websources.py:471
#, python-brace-format
msgid "The .zip file has no RPM of {package}."
msgstr "Le fichier .zip ne contient aucun RPM du paquet {package}."

#: zypp_desk/yumrepos.py:170
msgid "Its address is made for one version of Fedora ($releasever)."
msgstr "Son adresse est faite pour une seule version de Fedora ($releasever)."

#: zypp_desk/yumrepos.py:172
#, python-brace-format
msgid "Its address uses {variable}, which only dnf knows."
msgstr "Son adresse utilise {variable}, que seul dnf connaît."

#: zypp_desk/yumrepos.py:181
msgid "Its address is not on the web (http or https)."
msgstr "Son adresse n'est pas sur le web (http ou https)."

#: zypp_desk/yumrepos.py:183
msgid ""
"It only has a list of mirrors (metalink or mirrorlist), which zypper cannot "
"read."
msgstr ""
"Il n'a qu'une liste de miroirs (metalink ou mirrorlist), que zypper ne sait "
"pas lire."

#: zypp_desk/yumrepos.py:186
msgid "It has no address."
msgstr "Il n'a pas d'adresse."

#: zypp_desk/yumrepos.py:188
msgid "Other users can change this file, so it is not used."
msgstr ""
"D'autres utilisateurs peuvent modifier ce fichier : il n'est donc pas "
"utilisé."

#: zypp_desk/yumrepos.py:201
#, python-brace-format
msgid ""
"Its address carries settings for zypper ({options}) that change how it "
"checks the server or where it downloads from."
msgstr ""
"Son adresse contient des réglages pour zypper ({options}) qui changent la "
"façon dont il vérifie le serveur ou l'endroit d'où il télécharge."

#: zypp_desk/yumrepos.py:249
msgid ""
"Its address is not encrypted (http, and https does not answer there), and "
"its packages are not signed: anybody on the network could change what zypper "
"installs as root."
msgstr ""
"Son adresse n'est pas chiffrée (http, et https n'y répond pas), et ses "
"paquets ne sont pas signés : n'importe qui sur le réseau pourrait modifier "
"ce que zypper installe en tant que root."

#: zypp_desk/yumrepos.py:396
msgid "Other users can change this file, or it does not exist."
msgstr "D'autres utilisateurs peuvent modifier ce fichier, ou il n'existe pas."

#: zypp_desk/yumrepos.py:402
msgid ""
"Zypp Desk only takes keys from a file on this computer or from an https "
"address."
msgstr ""
"Zypp Desk ne prend des clés que depuis un fichier de cet ordinateur ou une "
"adresse https."

#: zypp_desk/yumrepos.py:432
msgid "Its key has expired or was revoked by its owner."
msgstr "La clé a expiré ou a été révoquée par son propriétaire."

#: zypp_desk/zyppcmds.py:300
#, python-brace-format
msgid "zypper's help could not be read (exit code {code})."
msgstr "L'aide de zypper n'a pas pu être lue (code de sortie {code})."

#: zypp_desk/zyppcmds.py:329
msgid "zypper could not be run."
msgstr "zypper n'a pas pu être lancé."

#: zypp_desk/zyppcmds.py:554
#, python-brace-format
msgid ""
"“{option}” is not accepted here. Options that point zypper at another root, "
"configuration, cache or repository folder, or that add repositories or trust "
"keys on their own, are refused, as the helper that runs zypper as "
"administrator refuses them."
msgstr ""
"« {option} » n'est pas accepté ici. Les options qui dirigent zypper vers une "
"autre racine, une autre configuration, un autre cache ou un autre dossier de "
"dépôts, ou qui ajoutent des dépôts ou font confiance à des clés d'elles-"
"mêmes, sont refusées, comme les refuse le programme auxiliaire qui exécute "
"zypper en tant qu'administrateur."

#: zypp_desk/zyppcmds.py:596 zypp_desk/zyppcmds.py:612
#, python-brace-format
msgid "zypper has no global option “{option}”."
msgstr "zypper n'a pas d'option globale « {option} »."

#: zypp_desk/zyppcmds.py:601 zypp_desk/zyppcmds.py:619
#, python-brace-format
msgid "“{option}” needs a value after it."
msgstr "« {option} » doit être suivi d'une valeur."

#: zypp_desk/zyppcmds.py:689
#, python-brace-format
msgid ""
"“zypper {command}” waits for you to type, and nobody can type into a command "
"here. Write each command on the line above instead."
msgstr ""
"« zypper {command} » attend que vous tapiez du texte, et personne ne peut "
"écrire dans une commande ici. Écrivez plutôt chaque commande sur la ligne du "
"haut."

#: zypp_desk/zyppcmds.py:691
#, python-brace-format
msgid ""
"“zypper {command}” is not one of the commands the helper runs as "
"administrator, so it cannot run from here. Use a terminal for it."
msgstr ""
"« zypper {command} » ne fait pas partie des commandes que le programme "
"auxiliaire exécute en tant qu'administrateur : elle ne peut donc pas être "
"lancée d'ici. Utilisez un terminal pour cela."

#: zypp_desk/zyppcmds.py:696
msgid ""
"-n was added: zypper cannot ask you anything here, so it takes its default "
"answers."
msgstr ""
"-n a été ajouté : zypper ne peut rien vous demander ici, il prend donc ses "
"réponses par défaut."

#: zypp_desk/zyppcmds.py:705 zypp_desk/zyppcmds.py:752
msgid "A line break or a null character cannot go into a command."
msgstr ""
"Une commande ne peut pas contenir de saut de ligne ni de caractère nul."

#: zypp_desk/zyppcmds.py:716
msgid ""
"Which zypper command? It comes after the global options, for example: zypper "
"-v se vlc"
msgstr ""
"Quelle commande zypper ? Elle vient après les options globales, par "
"exemple : zypper -v se vlc"

#: zypp_desk/zyppcmds.py:720
#, python-brace-format
msgid "zypper has no command “{command}”. The list on the left has them all."
msgstr ""
"zypper n'a pas de commande « {command} ». La liste de gauche les contient "
"toutes."

#: zypp_desk/zyppcmds.py:729
#, python-brace-format
msgid ""
"“{command}” is a program of its own (a zypper subcommand): global options "
"cannot go before it."
msgstr ""
"« {command} » est un programme à part (une sous-commande de zypper) : les "
"options globales ne peuvent pas être placées avant."

#: zypp_desk/zyppcmds.py:734
#, python-brace-format
msgid ""
"The global option “{option}” is not accepted with a command that changes the "
"system: the helper that runs zypper as administrator refuses it."
msgstr ""
"L'option globale « {option} » n'est pas acceptée avec une commande qui "
"modifie le système : le programme auxiliaire qui exécute zypper en tant "
"qu'administrateur la refuse."

#: zypp_desk/zyppcmds.py:750 zypp_desk/zyppcmds.py:771
msgid "Type a zypper command, for example: zypper se vlc"
msgstr "Tapez une commande zypper, par exemple : zypper se vlc"

#: zypp_desk/zyppcmds.py:755
#, python-brace-format
msgid ""
"Only one zypper command at a time: “{op}” is not accepted here (no ;, &&, |, "
"> or <). Nothing runs through a shell."
msgstr ""
"Une seule commande zypper à la fois : « {op} » n'est pas accepté ici (pas "
"de ;, &&, |, > ni <). Rien ne passe par un shell."

#: zypp_desk/zyppcmds.py:760
#, python-brace-format
msgid "The line cannot be read: {error}."
msgstr "La ligne ne peut pas être lue : {error}."

#: zypp_desk/zyppcmds.py:764
msgid ""
"sudo is not needed: Zypp Desk asks for the administrator password itself "
"when the command changes the system."
msgstr ""
"sudo n'est pas nécessaire : Zypp Desk demande lui-même le mot de passe "
"administrateur quand la commande modifie le système."

#: zypp_desk/zyppcmds.py:769
#, python-brace-format
msgid "Only zypper runs here: “{word}” is not a zypper command."
msgstr "Seul zypper s'exécute ici : « {word} » n'est pas une commande zypper."

