#, python-brace-format
msgid "There is a problem with {pkg}, which would be installed."
msgstr "Il y a un problème avec {pkg}, qui serait installé."

#: zypp_desk/simulation.py:330
#, python-brace-format
msgid ""
"The installed {pkg} is not in any of your repositories any more, so the "
