#, python-brace-format
msgid "{a} replaces {dep}, which {b} provides."
msgstr "{a} remplace {dep}, que fournit {b}."

#: zypp_desk/simulation.py:311
#, python-brace-format
msgid "These two cannot be on the system together: {a} and {b}."
msgstr "Ces deux paquets ne peuvent pas être ensemble sur le système : {a} et {b}."

