msgstr "Le programme d'installation n'a pas pu être préparé : {error}"

#: zypp_desk/pages/scripts.py:744
msgid "It has ended."
msgstr "Terminé."

#: zypp_desk/pages/scripts.py:745
msgid "It has ended with an error, code"
msgstr "Terminé avec une erreur, code"

#: zypp_desk/pages/scripts.py:746
