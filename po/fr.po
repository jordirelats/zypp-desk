#, python-brace-format
msgid "Keep snapshot #{n}"
msgstr "Garder l'instantané #{n}"

#: zypp_desk/pages/history.py:1084
msgid "Done. Restart the computer to start from it."
msgstr "C'est fait. Redémarrez l'ordinateur pour démarrer depuis cet instantané."

