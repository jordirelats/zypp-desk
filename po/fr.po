msgid_plural "You have {n} keys. Each one lets you install what it signs."
msgstr[0] "Vous avez {n} clé. Chacune permet d'installer ce qu'elle signe."
msgstr[1] "Vous avez {n} clés. Chacune permet d'installer ce qu'elle signe."

#: zypp_desk/pages/keys.py:482
msgid "will be deleted"
msgstr "sera supprimée"

#: zypp_desk/pages/keys.py:484
