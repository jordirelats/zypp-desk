msgstr "La clé de signature de NVIDIA n'a pas pu être lue : {error}"

#: zypp_desk/pages/drivers.py:516
#, python-brace-format
msgid ""
"NVIDIA's repository publishes a signing key that is not the one Zypp Desk "
"knows ({fpr}). Zypp Desk does not add it: follow openSUSE's guide "
"(SDB:NVIDIA drivers) instead."
msgstr ""
"Le dépôt de NVIDIA publie une clé de signature qui n'est pas celle que "
"connaît Zypp Desk ({fpr}). Zypp Desk ne l'ajoute pas : suivez plutôt le "
"guide d'openSUSE (SDB:NVIDIA drivers)."

#: zypp_desk/pages/drivers.py:530
msgctxt "change"
msgid "Trust NVIDIA's signing key"
msgstr "Faire confiance à la clé de signature de NVIDIA"

#: zypp_desk/pages/drivers.py:531
#, python-brace-format
msgid "Fingerprint {fpr}. NVIDIA signs its repository for openSUSE with it."
msgstr "Empreinte {fpr}. NVIDIA s'en sert pour signer son dépôt pour openSUSE."

#: zypp_desk/pages/drivers.py:535 zypp_desk/pages/findrepo.py:699
#: zypp_desk/pages/repotools.py:704 zypp_desk/pages/repotools.py:733
#: zypp_desk/pages/websources.py:614 zypp_desk/txqueue.py:180
