msgstr "Dépôt et son nouvel alias"

#: zypp_desk/pages/expert.py:92
msgid "Two versions"
msgstr "Deux versions"

#: zypp_desk/pages/expert.py:93
msgid "Command"
msgstr "Commande"

#: zypp_desk/pages/expert.py:93 zypp_desk/pages/packages.py:18
msgid "Patches"
msgstr "Correctifs"

#: zypp_desk/pages/expert.py:93 zypp_desk/pages/packages.py:18
