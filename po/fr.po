#, python-brace-format
msgid "{pkg} comes from a repository that this upgrade does not use."
msgstr "{pkg} provient d'un dépôt que cette mise à niveau n'utilise pas."

#: zypp_desk/simulation.py:335
#, python-brace-format
msgid ""
"{pkg} is built for an older type of processor than the other versions "
"available."
msgstr ""
"{pkg} est construit pour un type de processeur plus ancien que les autres "
"versions disponibles."

#: zypp_desk/simulation.py:338
#, python-brace-format
msgid "{pkg} cannot be installed on this computer."
msgstr "{pkg} ne peut pas être installé sur cet ordinateur."

#: zypp_desk/simulation.py:340
#, python-brace-format
