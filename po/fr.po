msgstr[0] ""
"{n} élément que vous n'avez pas : zypper le cherchera dans vos dépôts "
"({list}). Simulez pour voir s'il est trouvé."
msgstr[1] ""
"{n} éléments que vous n'avez pas : zypper les cherchera dans vos dépôts "
"({list}). Simulez pour voir s'ils sont trouvés."

#: zypp_desk/pages/localrpm.py:977
#, python-brace-format
