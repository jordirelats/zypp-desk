msgid_plural "Update {n} programs"
msgstr[0] "Mettre à jour {n} programme"
msgstr[1] "Mettre à jour {n} programmes"

#: zypp_desk/pages/updates.py:216
#, python-brace-format
msgid "Install {n} new package"
msgid_plural "Install {n} new packages"
msgstr[0] "Installer {n} nouveau paquet"
msgstr[1] "Installer {n} nouveaux paquets"

#: zypp_desk/pages/updates.py:217
