#, python-brace-format
msgid "There is a problem with {pkg}, which would be installed."
msgstr "Il y a un problème avec {pkg}, qui serait installé."

#: zypp_desk/simulation.py:319
#, python-brace-format
msgid "The installed {pkg} is not in any of your repositories any more, so the upgrade has to replace it."
msgstr "Le paquet installé {pkg} ne se trouve plus dans aucun de vos dépôts : la mise à niveau doit donc le remplacer."

#: zypp_desk/simulation.py:322
#, python-brace-format
msgid "{pkg} comes from a repository that this upgrade does not use."
msgstr "{pkg} provient d'un dépôt que cette mise à niveau n'utilise pas."

#: zypp_desk/simulation.py:324
#, python-brace-format
msgid "{pkg} is built for an older type of processor than the other versions available."
msgstr "{pkg} est construit pour un type de processeur plus ancien que les autres versions disponibles."

#: zypp_desk/simulation.py:327
#, python-brace-format
msgid "{pkg} cannot be installed on this computer."
msgstr "{pkg} ne peut pas être installé sur cet ordinateur."

#: zypp_desk/simulation.py:329
#, python-brace-format
msgid "{dep} is part of the system and cannot be removed."
msgstr "{dep} fait partie du système et ne peut pas être supprimé."

#: zypp_desk/simulation.py:331
msgid "The changes asked for contradict each other."
msgstr "Les modifications demandées se contredisent."

#: zypp_desk/simulation.py:333
msgid "There is a dependency problem."
msgstr "Il y a un problème de dépendances."

#: zypp_desk/simulation.py:335
msgid "zypper cannot do what was asked."
msgstr "zypper ne peut pas faire ce qui a été demandé."

#: zypp_desk/simulation.py:337
msgid "This change would break your system."
msgstr "Cette modification casserait votre système."

#: zypp_desk/simulation.py:357
msgid "This cannot be done safely from here."
msgstr "Cela ne peut pas se faire sans risque d'ici."

#: zypp_desk/simulation.py:365
#, python-brace-format
msgid "{pkg} is uninstalled: whatever uses it may lose some functions. The next simulation shows if anything else would go too."
msgstr "{pkg} est désinstallé : ce qui l'utilise peut perdre certaines fonctions. La prochaine simulation montrera si autre chose disparaîtrait aussi."

#: zypp_desk/simulation.py:368
#, python-brace-format
msgid "{pkg} is uninstalled now, but only if nothing else needs it: otherwise zypper refuses and nothing changes. Whatever uses it may lose some functions."
msgstr "{pkg} est désinstallé tout de suite, mais seulement si rien d'autre n'en a besoin : sinon, zypper refuse et rien ne change. Ce qui l'utilise peut perdre certaines fonctions."

#: zypp_desk/simulation.py:375
#, python-brace-format
msgid "Keep {pkg} as it is"
msgstr "Garder {pkg} tel quel"

#: zypp_desk/simulation.py:377
#, python-brace-format
msgid "Do not update {name}"
msgstr "Ne pas mettre à jour {name}"

#: zypp_desk/simulation.py:378
#, python-brace-format
msgid "The rest goes ahead. {name} stays at version {version} and is locked: it will not change until you unlock it."
msgstr "Le reste se poursuit. {name} reste à la version {version} et est verrouillé : il ne changera pas tant que vous ne l'aurez pas déverrouillé."

#: zypp_desk/simulation.py:380
#, python-brace-format
msgid "The rest goes ahead. {name} stays as it is and is locked: it will not change until you unlock it."
msgstr "Le reste se poursuit. {name} reste tel quel et est verrouillé : il ne changera pas tant que vous ne l'aurez pas déverrouillé."

#: zypp_desk/simulation.py:386
#, python-brace-format
msgid "Do not install {name}"
msgstr "Ne pas installer {name}"

#: zypp_desk/simulation.py:387
#, python-brace-format
msgid "{name} leaves the queue; the rest goes ahead."
msgstr "{name} sort de la file d'attente ; le reste se poursuit."

#: zypp_desk/simulation.py:389
#, python-brace-format
msgid "{name} is locked, so the upgrade leaves it out: it will not be installed or changed until you unlock it."
msgstr "{name} est verrouillé : la mise à niveau le laisse donc de côté. Il ne sera ni installé ni modifié tant que vous ne l'aurez pas déverrouillé."

#: zypp_desk/simulation.py:394
#, python-brace-format
msgid "Do not remove {name}"
msgstr "Ne pas supprimer {name}"

#: zypp_desk/simulation.py:395
#, python-brace-format
msgid "{name} stays installed and its removal leaves the queue; the rest goes ahead."
msgstr "{name} reste installé et sa suppression sort de la file d'attente ; le reste se poursuit."

#: zypp_desk/simulation.py:397
#, python-brace-format
msgid "{name} stays installed and is locked, so the upgrade cannot remove it until you unlock it."
msgstr "{name} reste installé et est verrouillé : la mise à niveau ne peut donc pas le supprimer tant que vous ne l'aurez pas déverrouillé."

#: zypp_desk/simulation.py:402
#, python-brace-format
msgid "{name} is locked. Without the lock, zypper can remove it."
msgstr "{name} est verrouillé. Sans le verrou, zypper peut le supprimer."

#: zypp_desk/simulation.py:403
#, python-brace-format
msgid "{name} is locked. Without the lock, zypper can install it."
msgstr "{name} est verrouillé. Sans le verrou, zypper peut l'installer."

#: zypp_desk/simulation.py:404 zypp_desk/txqueue.py:67
#, python-brace-format
msgid "Unlock {name}"
msgstr "Déverrouiller {name}"

#: zypp_desk/simulation.py:408
#, python-brace-format
msgid "Go back to {pkg}"
msgstr "Revenir à {pkg}"

#: zypp_desk/simulation.py:409
#, python-brace-format
msgid "{name} goes back from version {old} to the older {new}, so that everything fits."
msgstr "{name} revient de la version {old} à la version plus ancienne {new}, pour que tout s'accorde."

