#: zypp_desk/drivers.py:1942
#, python-brace-format
msgid "{name}, {what}. This computer is not a virtual machine."
msgstr "{name}, {what}. Cet ordinateur n'est pas une machine virtuelle."

#: zypp_desk/drivers.py:1944
#, python-brace-format
msgid "{names}. This computer is not a virtual machine."
msgstr "{names}. Cet ordinateur n'est pas une machine virtuelle."

#: zypp_desk/drivers.py:1946
#, python-brace-format
msgid "{names}. This computer has no such card."
msgstr "{names}. Cet ordinateur n'a pas de carte de ce type."

#: zypp_desk/drivers.py:1948
#, python-brace-format
msgid ""
"{names}. None is plugged in now, but they are for USB devices. Unticked: "
