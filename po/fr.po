#: zypp_desk/pages/history.py:943
msgid "This computer does not take snapshots: they need Btrfs and snapper."
msgstr "Cet ordinateur ne prend pas d'instantanés : il faut Btrfs et snapper."

#: zypp_desk/pages/history.py:945
msgid "The list of snapshots could not be read, so the snapshots of this change are not shown."
msgstr "La liste des instantanés n'a pas pu être lue : les instantanés de cette modification ne sont donc pas affichés."

#: zypp_desk/pages/history.py:948
msgid "This change did not finish: there is no snapshot from after it, so it cannot be compared or undone from here."
msgstr "Cette modification ne s'est pas terminée : il n'y a pas d'instantané pris après elle, elle ne peut donc être ni comparée ni annulée d'ici."

#: zypp_desk/pages/history.py:953
msgid "No snapshot: zypper only takes snapshots when packages change."
msgstr "Aucun instantané : zypper ne prend des instantanés que lorsque des paquets changent."

#: zypp_desk/pages/history.py:955
msgid "Its snapshots have already been deleted: snapper keeps only the most recent ones."
msgstr "Ses instantanés ont déjà été supprimés : snapper ne garde que les plus récents."

#: zypp_desk/pages/history.py:956
msgid "No snapshot was taken for this change."
msgstr "Aucun instantané n'a été pris pour cette modification."

#: zypp_desk/pages/history.py:965
#, python-brace-format
msgid "Compare snapshots #{pre} and #{post}"
msgstr "Comparer les instantanés #{pre} et #{post}"

