"{vendor}."

#: zypp_desk/simulation.py:439
#, python-brace-format
msgid "Replace {old} with {new}"
msgstr "Remplacer {old} par {new}"

#: zypp_desk/simulation.py:440
#, python-brace-format
msgid "{new} is installed in place of {old}."
msgstr "{new} est installé et remplace {old}."

