#: zypp_desk/appimages.py:949
#, python-brace-format
msgid "{repo} has no release yet."
msgstr "Le projet {repo} n'a encore publié aucune version."

#: zypp_desk/appimages.py:966
msgid ""
"This AppImage does not say where its new versions are published on GitHub."
msgstr ""
"Cette AppImage n'indique pas où ses nouvelles versions sont publiées sur "
"GitHub."

#: zypp_desk/appimages.py:976
#, python-brace-format
msgid "The latest release of {repo} has no AppImage for this computer."
msgstr ""
"La dernière version publiée du projet {repo} n'a pas d'AppImage pour cet "
"ordinateur."

#: zypp_desk/appimages.py:985 zypp_desk/websources.py:165
#: zypp_desk/websources.py:200 zypp_desk/websources.py:256
msgid "Only https downloads are allowed."
msgstr "Seuls les téléchargements en https sont autorisés."

#: zypp_desk/appimages.py:1014
#, python-brace-format
msgid ""
"Only the administrator can change the folder {folder}: Zypp Desk does not "
"update AppImages there."
msgstr ""
"Seul l'administrateur peut modifier le dossier {folder} : Zypp Desk n'y met "
"pas à jour les AppImages."

#: zypp_desk/appimages.py:1018
#, python-brace-format
msgid "There is not enough free space in {folder}."
msgstr "Il n'y a pas assez d'espace libre dans {folder}."

#: zypp_desk/appimages.py:1036 zypp_desk/websources.py:397
msgid "The file is bigger than 2 GiB: it was not downloaded."
msgstr "Le fichier dépasse 2 Gio : il n'a pas été téléchargé."

#: zypp_desk/appimages.py:1041 zypp_desk/websources.py:403
#, python-brace-format
msgid ""
"The SHA-256 does not match: GitHub publishes {expected}, the file has {got}. "
"The file was deleted."
msgstr ""
"La somme SHA-256 ne correspond pas : GitHub publie {expected}, le fichier a "
"{got}. Le fichier a été supprimé."

#: zypp_desk/appimages.py:1044
msgid "The file downloaded is not an AppImage. It was deleted."
msgstr "Le fichier téléchargé n'est pas une AppImage. Il a été supprimé."

#: zypp_desk/appimages.py:1089 zypp_desk/pages/apps.py:1387
#, python-brace-format
msgid "{file} is not an AppImage."
msgstr "{file} n'est pas une AppImage."

#: zypp_desk/backend.py:40 zypp_desk/backend.py:63 zypp_desk/health.py:335
#, python-brace-format
msgid "zypper exited with code {code}."
msgstr "zypper s'est terminé avec le code {code}."

#: zypp_desk/backend.py:52 zypp_desk/simulation.py:609
msgid "zypper returned no output."
msgstr "zypper n'a rien renvoyé."

#: zypp_desk/backend.py:384
msgid "No lock has been removed."
msgstr "Aucun verrouillage n'a été supprimé."

#: zypp_desk/backend.py:438
msgid "PackageKit (Discover)"
msgstr "PackageKit (Discover)"

#: zypp_desk/backend.py:438
msgid "zypper in a terminal"
msgstr "zypper dans un terminal"

#: zypp_desk/backend.py:498
msgid "Zypp Desk itself"
msgstr "Zypp Desk lui-même"

#: zypp_desk/backend.py:504
msgid "Zypp Desk's timer, downloading the updates ahead"
msgstr "le minuteur de Zypp Desk, qui télécharge les mises à jour à l'avance"

#: zypp_desk/backend.py:505
msgid "Zypp Desk's timer, refreshing the repositories"
msgstr "le minuteur de Zypp Desk, qui actualise les dépôts"

#: zypp_desk/bridge.py:483
#, python-brace-format
msgid "Your bridge {bridge} already says so."
msgstr "Votre paquet passerelle {bridge} l'indique déjà."

#: zypp_desk/bridge.py:539
#, python-brace-format
msgid "{dirs} belongs to {package}"
msgid_plural "{dirs} belong to {package}"
msgstr[0] "{dirs} appartient à {package}"
msgstr[1] "{dirs} appartiennent à {package}"

#: zypp_desk/bridge.py:541
#, python-brace-format
msgid "The folders where it puts its files are already there: {list}."
msgstr "Les dossiers où il place ses fichiers existent déjà : {list}."

#: zypp_desk/bridge.py:550
#, python-brace-format
msgid ""
"{name} is {bare} for this computer's processor; openSUSE does not write the "
"processor in the name."
msgstr ""
"{name} est {bare} pour le processeur de cet ordinateur ; openSUSE n'écrit "
"pas le processeur dans le nom."

#: zypp_desk/bridge.py:553
#, python-brace-format
msgid "The same thing: {fedora} in Fedora is {opensuse} in openSUSE."
msgstr ""
"C'est la même chose : {fedora} dans Fedora est {opensuse} dans openSUSE."

#: zypp_desk/bridge.py:557
msgid ""
"openSUSE has nothing under this name, and Zypp Desk knows no other name for "
"it."
msgstr ""
"openSUSE n'a rien sous ce nom, et Zypp Desk ne lui connaît aucun autre nom."

#: zypp_desk/bridge.py:563
#, python-brace-format
msgid "openSUSE has {package} {version}, which is not what it asks for."
msgstr "openSUSE a {package} {version}, ce qui n'est pas ce qu'il demande."

#: zypp_desk/bridge.py:566
#, python-brace-format
msgid "Zypp Desk cannot tell which version of {package} openSUSE has."
msgstr ""
"Zypp Desk ne peut pas savoir quelle version du paquet {package} openSUSE "
"possède."

#: zypp_desk/bridge.py:583
#, python-brace-format
msgid "{path} is the same file as {real}, which belongs to {package}."
msgstr "{path} est le même fichier que {real}, qui appartient à {package}."

#: zypp_desk/bridge.py:591
#, python-brace-format
msgid "{path} is the same place as {real}, which {package} installs."
msgstr "{path} est le même emplacement que {real}, que {package} installe."

#: zypp_desk/bridge.py:595
msgid "No package of openSUSE has this file."
msgstr "Aucun paquet d'openSUSE ne contient ce fichier."

