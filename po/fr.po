msgid "Compare the files"
msgstr "Comparer les fichiers"

#: zypp_desk/pages/history.py:973
#, python-brace-format
msgid "snapper could not compare the snapshots (exit code {code})."
msgstr "snapper n'a pas pu comparer les instantanés (code de sortie {code})."

#: zypp_desk/pages/history.py:985
#, python-brace-format
msgid "snapper puts the system files back as they were before this change, in snapshot #{pre}. The programs of this change go back to their old versions; other changes made later to the same files are lost."
msgstr "snapper remet les fichiers du système tels qu'ils étaient avant cette modification, dans l'instantané #{pre}. Les programmes de cette modification reviennent à leurs anciennes versions ; les autres modifications faites ensuite sur les mêmes fichiers sont perdues."

#: zypp_desk/pages/history.py:991
#, python-brace-format
msgid "Not everything goes back: {folders} is not in the snapshots, so what this change wrote there stays as it is now."
msgid_plural "Not everything goes back: {folders} are not in the snapshots, so what this change wrote there stays as it is now."
msgstr[0] "Tout ne revient pas en arrière : {folders} ne fait pas partie des instantanés ; ce que cette modification y a écrit reste donc tel quel."
msgstr[1] "Tout ne revient pas en arrière : {folders} ne font pas partie des instantanés ; ce que cette modification y a écrit reste donc tel quel."

