msgstr "La mise à jour les apporte."

#: zypp_desk/pages/updates.py:218
#, python-brace-format
msgid "Remove {n} old package"
msgid_plural "Remove {n} old packages"
msgstr[0] "Supprimer {n} ancien paquet"
msgstr[1] "Supprimer {n} anciens paquets"

#: zypp_desk/pages/updates.py:219
msgid "The update takes them out, usually because newer ones replace them."
msgstr ""
"La mise à jour les supprime, généralement parce que de plus récents les "
