#, python-brace-format
msgid "Switch {name} to the package from {vendor}"
msgstr "Passer {name} au paquet du fournisseur {vendor}"

#: zypp_desk/simulation.py:421
#, python-brace-format
msgid "{pkg} from {vendor} replaces the one from {old_vendor}. This changes the vendor: from now on {name} is updated from {vendor}."
msgstr "{pkg}, fourni par {vendor}, remplace celui que fournissait {old_vendor}. Cela change le fournisseur : désormais, {name} sera mis à jour depuis {vendor}."

